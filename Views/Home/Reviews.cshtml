@{
    ViewData["Title"] = "Отзывы";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAuthenticated = Context.Session.GetInt32("UserId") != null;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Заголовок страницы в стиле сайта -->
            <div class="page-header-section mb-5">
                <div class="page-header-icon">
                    <i class="fas fa-star text-white"></i>
                </div>
                <div>
                    <h1 class="page-title">
                        Отзывы наших клиентов
                    </h1>
                    <p class="page-subtitle">Поделитесь своим опытом и узнайте мнение других путешественников</p>
                </div>
            </div>

            <!-- Рейтинг и статистика -->
            <div class="card border-0 shadow-sm mb-5">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-4 text-center">
                            <div class="rating-summary mb-3">
                                <div class="display-4 text-warning mb-2" id="average-rating">0.0</div>
                                <div class="stars mb-2" id="average-stars">
                                    <i class="far fa-star text-warning"></i>
                                    <i class="far fa-star text-warning"></i>
                                    <i class="far fa-star text-warning"></i>
                                    <i class="far fa-star text-warning"></i>
                                    <i class="far fa-star text-warning"></i>
                                </div>
                                <p class="text-muted" id="reviews-count">На основе 0 отзывов</p>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="row">
                                <div class="col-6 col-md-3 text-center mb-3">
                                    <div class="stat-card p-3 border rounded">
                                        <div class="stat-number text-primary fs-4 fw-bold" id="stat-5">0</div>
                                        <div class="stat-label text-muted">5 звезд</div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3 text-center mb-3">
                                    <div class="stat-card p-3 border rounded">
                                        <div class="stat-number text-primary fs-4 fw-bold" id="stat-4">0</div>
                                        <div class="stat-label text-muted">4 звезды</div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3 text-center mb-3">
                                    <div class="stat-card p-3 border rounded">
                                        <div class="stat-number text-primary fs-4 fw-bold" id="stat-3">0</div>
                                        <div class="stat-label text-muted">3 звезды</div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3 text-center mb-3">
                                    <div class="stat-card p-3 border rounded">
                                        <div class="stat-number text-primary fs-4 fw-bold" id="stat-2">0</div>
                                        <div class="stat-label text-muted">2 звезды</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Отзывы -->
            <div id="reviews-container" class="row mb-5">
                <!-- Все отзывы будут добавляться сюда динамически -->
            </div>

            <!-- Форма отзыва -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h3 class="section-subtitle mb-0">
                        <i class="fas fa-comment-dots text-primary me-2"></i>
                        Оставьте свой отзыв
                    </h3>
                </div>
                <div class="card-body p-4">
                    @if (!isAuthenticated)
                    {
                        <div class="alert alert-info border-0 rounded-lg">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-info-circle fa-2x text-info me-3"></i>
                                <div>
                                    <h5 class="alert-heading mb-2">Войдите в аккаунт</h5>
                                    <p class="mb-2">Чтобы оставлять отзывы, войдите в свой аккаунт.</p>
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary d-flex align-items-center justify-content-center">
                                            Войти
                                        </a>
                                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary d-flex align-items-center justify-content-center">
                                            Зарегистрироваться
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <form id="review-form">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Имя</label>
                                    <input type="text" class="form-control form-control-lg" id="review-name" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Email</label>
                                    <input type="email" class="form-control form-control-lg" id="review-email" required>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Оценка</label>
                                <div class="rating-input">
                                    <i class="far fa-star" data-rating="1"></i>
                                    <i class="far fa-star" data-rating="2"></i>
                                    <i class="far fa-star" data-rating="3"></i>
                                    <i class="far fa-star" data-rating="4"></i>
                                    <i class="far fa-star" data-rating="5"></i>
                                </div>
                                <input type="hidden" id="selected-rating" value="0" required>
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-semibold">Отзыв</label>
                                <textarea class="form-control" id="review-text" rows="4" placeholder="Поделитесь вашим опытом..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                Отправить отзыв
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Стили для заголовка страницы */
    .page-header-section {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 25px 30px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
    }

        .page-header-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 6px;
            height: 100%;
            background: linear-gradient(to bottom, #0379D9, #40B624);
        }

    .page-header-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #0379D9, #40B624);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        box-shadow: 0 4px 15px rgba(3, 121, 217, 0.2);
        flex-shrink: 0;
    }

        .page-header-icon i {
            color: white !important;
        }

    .page-title {
        font-family: 'Nunito', sans-serif;
        font-weight: 800;
        font-size: 2.5rem;
        color: #0379D9;
        margin: 0 0 8px 0;
        line-height: 1.2;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 1.1rem;
        margin: 0;
        max-width: 600px;
    }

    .section-subtitle {
        font-family: 'Nunito', sans-serif;
        font-weight: 600;
        font-size: 1.3rem;
        color: #334155;
        margin: 0;
        display: flex;
        align-items: center;
    }

    /* Стили для карточек */
    .card {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
    }

        .card:hover {
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

    /* Карточки отзывов */
    .review-card {
        transition: all 0.3s ease;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        height: 100%;
    }

        .review-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            border-color: #0379D9;
        }

    .stars i {
        color: #ffc107;
    }

    /* Статистические карточки */
    .stat-card {
        transition: all 0.3s ease;
        background: white;
        border: 1px solid #e2e8f0;
    }

        .stat-card:hover {
            border-color: #0379D9;
            transform: translateY(-3px);
        }

    .stat-number {
        font-family: 'Nunito', sans-serif;
    }

    .stat-label {
        font-size: 0.9rem;
    }

    /* Стили для формы */
    .form-control, .form-select {
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        padding: 12px 16px;
        font-family: 'Nunito', sans-serif;
    }

        .form-control:focus, .form-select:focus {
            border-color: #0379D9;
            box-shadow: 0 0 0 0.2rem rgba(3, 121, 217, 0.25);
        }

    .form-control-lg {
        padding: 14px 18px;
        font-size: 1rem;
    }

    /* Рейтинг ввод */
    .rating-input i {
        font-size: 2rem;
        cursor: pointer;
        color: #ddd;
        margin-right: 8px;
        transition: all 0.2s ease;
    }

        .rating-input i:hover,
        .rating-input i.active {
            color: #ffc107;
            transform: scale(1.1);
        }

    /* Кнопки */
    .btn {
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        font-family: 'Nunito', sans-serif;
    }

    .btn-primary {
        background: #0379D9;
        border: none;
        box-shadow: 0 4px 12px rgba(3, 121, 217, 0.2);
        padding: 14px 20px;
        font-size: 1.1rem;
    }

        .btn-primary:hover {
            background: #0356a8;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(3, 121, 217, 0.3);
        }

    .btn-outline-primary {
        border: 2px solid #0379D9;
        color: #0379D9;
        background: white;
    }

        .btn-outline-primary:hover {
            background: #f0f7ff;
            border-color: #0356a8;
            color: #0356a8;
        }

    .btn-lg {
        padding: 16px 24px;
        font-size: 1.2rem;
    }

    /* Алерт */
    .alert-info {
        background-color: #e8f4fe;
        border: 1px solid #b6d4fe;
        border-radius: 12px;
        color: #084298;
    }

    /* Иконки */
    .fa-comment-dots,
    .fa-info-circle {
        color: #0379D9 !important;
    }

    /* Адаптивность */
    @@media (max-width: 992px) {
        .review-card {
            margin-bottom: 1rem;
        }
    }

    @@media (max-width: 768px) {
        .page-header-section {
            flex-direction: column;
            text-align: center;
            padding: 20px;
            gap: 15px;
        }

            .page-header-section::before {
                width: 100%;
                height: 6px;
                top: 0;
                left: 0;
                background: linear-gradient(to right, #0379D9, #40B624);
            }

        .page-header-icon {
            width: 60px;
            height: 60px;
            font-size: 1.75rem;
        }

        .page-title {
            font-size: 2rem;
        }

        .section-subtitle {
            font-size: 1.2rem;
        }

        .rating-input i {
            font-size: 1.75rem;
            margin-right: 5px;
        }

        .btn {
            width: 100%;
            margin-bottom: 10px;
        }

        .d-flex.gap-2 {
            flex-direction: column;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.75rem;
        }

        .stat-card {
            padding: 1rem !important;
        }

        .rating-input i {
            font-size: 1.5rem;
        }

        .btn-lg {
            padding: 14px 20px;
            font-size: 1.1rem;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Инициализация отзывов из localStorage
        let reviews = JSON.parse(localStorage.getItem('reviews')) || [];
        let selectedRating = 0;

        // Загрузка существующих отзывов при загрузке страницы
        loadReviews();
        updateRatingSummary();
        updateStats();

        // Функции для работы с отзывами
        function loadReviews() {
            const reviewsContainer = document.getElementById('reviews-container');
            reviewsContainer.innerHTML = "";

            // Сортируем отзывы по дате (новые сначала)
            const sortedReviews = reviews.sort((a, b) => b.id - a.id);

            sortedReviews.forEach(review => {
                const starsHTML = getStarsHTML(review.rating);
                const reviewDate = formatDate(review.date);

                reviewsContainer.innerHTML += `
                    <div class="col-md-6 mb-4">
                        <div class="review-card p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h6 class="fw-semibold mb-1">${review.name}</h6>
                                    <div class="stars mb-2">${starsHTML}</div>
                                </div>
                                <small class="text-muted">${reviewDate}</small>
                            </div>
                            <p class="mb-0">${review.text}</p>
                        </div>
                    </div>
                `;
            });
        }

        function formatDate(dateString) {
            const date = new Date(dateString);
            if (isNaN(date.getTime())) {
                return dateString; // возвращаем как есть, если не валидная дата
            }
            return date.toLocaleDateString('ru-RU', {
                day: 'numeric',
                month: 'long',
                year: 'numeric'
            });
        }

        function updateRatingSummary() {
            if (reviews.length === 0) {
                document.getElementById('average-rating').textContent = '0.0';
                document.getElementById('reviews-count').textContent = 'На основе 0 отзывов';
                updateStarsDisplay(0);
                return;
            }

            const totalRating = reviews.reduce((sum, review) => sum + review.rating, 0);
            const averageRating = (totalRating / reviews.length).toFixed(1);

            document.getElementById('average-rating').textContent = averageRating;
            document.getElementById('reviews-count').textContent = `На основе ${reviews.length} отзывов`;
            updateStarsDisplay(averageRating);
        }

        function updateStats() {
            const stats = {
                5: 0,
                4: 0,
                3: 0,
                2: 0,
                1: 0
            };

            reviews.forEach(review => {
                const rating = Math.floor(review.rating);
                if (stats[rating] !== undefined) {
                    stats[rating]++;
                }
            });

            // Обновляем статистику
            document.getElementById('stat-5').textContent = stats[5] || 0;
            document.getElementById('stat-4').textContent = stats[4] || 0;
            document.getElementById('stat-3').textContent = stats[3] || 0;
            document.getElementById('stat-2').textContent = stats[2] || 0;
        }

        function updateStarsDisplay(rating) {
            const averageStars = document.getElementById('average-stars');
            averageStars.innerHTML = getStarsHTML(rating, true);
        }

        function getStarsHTML(rating, isAverage = false) {
            let starsHTML = '';
            const fullStars = Math.floor(rating);
            const hasHalfStar = rating % 1 >= 0.5;

            for (let i = 1; i <= 5; i++) {
                if (i <= fullStars) {
                    starsHTML += '<i class="fas fa-star text-warning"></i>';
                } else if (i === fullStars + 1 && hasHalfStar && isAverage) {
                    starsHTML += '<i class="fas fa-star-half-alt text-warning"></i>';
                } else {
                    starsHTML += '<i class="far fa-star text-warning"></i>';
                }
            }
            return starsHTML;
        }

        // Инициализация формы только если пользователь авторизован
        const reviewForm = document.getElementById('review-form');
        if (reviewForm) {
            // Инициализация рейтинга звёзд
            const stars = document.querySelectorAll('.rating-input i');
            stars.forEach(star => {
                star.addEventListener('click', function() {
                    selectedRating = parseInt(this.getAttribute('data-rating'));
                    document.getElementById('selected-rating').value = selectedRating;

                    stars.forEach(s => {
                        const rating = parseInt(s.getAttribute('data-rating'));
                        if (rating <= selectedRating) {
                            s.classList.remove('far');
                            s.classList.add('fas', 'active');
                        } else {
                            s.classList.remove('fas', 'active');
                            s.classList.add('far');
                        }
                    });
                });
            });

            // Обработка отправки формы
            reviewForm.addEventListener('submit', function(event) {
                event.preventDefault();

                const name = document.getElementById('review-name').value;
                const email = document.getElementById('review-email').value;
                const reviewText = document.getElementById('review-text').value;

                if (selectedRating === 0) {
                    alert('Пожалуйста, выберите оценку');
                    return;
                }

                const newReview = {
                    id: Date.now(),
                    name: name,
                    email: email,
                    rating: selectedRating,
                    text: reviewText,
                    date: new Date().toISOString()
                };

                // Добавляем отзыв в массив и сохраняем в localStorage
                reviews.push(newReview);
                localStorage.setItem('reviews', JSON.stringify(reviews));

                // Обновляем отображение
                loadReviews();
                updateRatingSummary();
                updateStats();

                // Сбрасываем форму
                reviewForm.reset();
                stars.forEach(s => {
                    s.classList.remove('fas', 'active');
                    s.classList.add('far');
                });
                selectedRating = 0;
                document.getElementById('selected-rating').value = 0;
            });
        }
    });
</script>