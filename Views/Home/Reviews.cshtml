@{
    ViewData["Title"] = "Отзывы";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAuthenticated = Context.Session.GetInt32("UserId") != null;
    var userName = ViewBag.UserName ?? "";
    var userEmail = ViewBag.UserEmail ?? "";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Заголовок страницы в стиле сайта -->
            <div class="page-header-section mb-5">
                <div class="page-header-icon">
                    <i class="fas fa-star text-white"></i>
                </div>
                <div>
                    <h1 class="page-title">
                        Отзывы наших клиентов
                    </h1>
                    <p class="page-subtitle">Поделитесь своим опытом и узнайте мнение других путешественников</p>
                </div>
            </div>

            <!-- Рейтинг и статистика -->
            <div class="card border-0 shadow-sm mb-5">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-4 text-center">
                            <div class="rating-summary mb-3">
                                <div class="display-4 text-warning mb-2" id="average-rating">0.0</div>
                                <div class="stars mb-2" id="average-stars">
                                    <i class="far fa-star text-warning"></i>
                                    <i class="far fa-star text-warning"></i>
                                    <i class="far fa-star text-warning"></i>
                                    <i class="far fa-star text-warning"></i>
                                    <i class="far fa-star text-warning"></i>
                                </div>
                                <p class="text-muted" id="reviews-count">Загрузка...</p>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="row">
                                <div class="col-6 col-md-3 text-center mb-3">
                                    <div class="stat-card p-3 border rounded">
                                        <div class="stat-number text-primary fs-4 fw-bold" id="stat-5">0</div>
                                        <div class="stat-label text-muted">5 звезд</div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3 text-center mb-3">
                                    <div class="stat-card p-3 border rounded">
                                        <div class="stat-number text-primary fs-4 fw-bold" id="stat-4">0</div>
                                        <div class="stat-label text-muted">4 звезды</div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3 text-center mb-3">
                                    <div class="stat-card p-3 border rounded">
                                        <div class="stat-number text-primary fs-4 fw-bold" id="stat-3">0</div>
                                        <div class="stat-label text-muted">3 звезды</div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3 text-center mb-3">
                                    <div class="stat-card p-3 border rounded">
                                        <div class="stat-number text-primary fs-4 fw-bold" id="stat-2">0</div>
                                        <div class="stat-label text-muted">2 звезды</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Индикатор загрузки -->
            <div id="loading-spinner" class="text-center mb-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Загрузка...</span>
                </div>
            </div>

            <!-- Сообщение об ошибке -->
            <div id="error-message" class="alert alert-danger border-0 rounded-lg d-none mb-4">
                <div class="d-flex align-items-center">
                    <i class="fas fa-exclamation-triangle fa-2x text-danger me-3"></i>
                    <div>
                        <h5 class="alert-heading mb-2">Ошибка загрузки</h5>
                        <p class="mb-2" id="error-text">Не удалось загрузить отзывы. Пожалуйста, попробуйте позже.</p>
                        <button class="btn btn-outline-danger" onclick="loadReviews()">Повторить</button>
                    </div>
                </div>
            </div>

            <!-- Отзывы -->
            <div id="reviews-container" class="row mb-5">
                <!-- Все отзывы будут добавляться сюда динамически -->
            </div>

            <!-- Форма отзыва -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h3 class="section-subtitle mb-0">
                        <i class="fas fa-comment-dots text-primary me-2"></i>
                        Оставьте свой отзыв
                    </h3>
                </div>
                <div class="card-body p-4">
                    @if (!isAuthenticated)
                    {
                        <div class="alert alert-info border-0 rounded-lg">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-info-circle fa-2x text-info me-3"></i>
                                <div>
                                    <h5 class="alert-heading mb-2">Войдите в аккаунт</h5>
                                    <p class="mb-2">Чтобы оставлять отзывы, войдите в свой аккаунт.</p>
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary d-flex align-items-center justify-content-center">
                                            Войти
                                        </a>
                                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary d-flex align-items-center justify-content-center">
                                            Зарегистрироваться
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <form id="review-form">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Имя</label>
                                    <input type="text" class="form-control form-control-lg" id="review-name"
                                           value="@userName" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Email</label>
                                    <input type="email" class="form-control form-control-lg" id="review-email"
                                           value="@userEmail" required>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Оценка</label>
                                <div class="rating-input">
                                    <i class="far fa-star" data-rating="1"></i>
                                    <i class="far fa-star" data-rating="2"></i>
                                    <i class="far fa-star" data-rating="3"></i>
                                    <i class="far fa-star" data-rating="4"></i>
                                    <i class="far fa-star" data-rating="5"></i>
                                </div>
                                <input type="hidden" id="selected-rating" value="0" required>
                                <div id="rating-error" class="text-danger small mt-1 d-none">Пожалуйста, выберите оценку</div>
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-semibold">Отзыв</label>
                                <textarea class="form-control" id="review-text" rows="4"
                                          placeholder="Поделитесь вашим опытом..."
                                          minlength="10" maxlength="2000" required></textarea>
                                <div class="text-muted small mt-1">
                                    <span id="char-counter">0</span>/2000 символов
                                </div>
                            </div>
                            <div id="form-error" class="alert alert-danger d-none mb-3"></div>
                            <div id="form-success" class="alert alert-success d-none mb-3"></div>
                            <button type="submit" class="btn btn-primary btn-lg w-100" id="submit-review-btn">
                                Отправить отзыв
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Ваши существующие стили остаются без изменений */
    /* ... */
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Загрузка отзывов при загрузке страницы
        loadReviews();
        loadStatistics();

        // Инициализация формы только если пользователь авторизован
        const reviewForm = document.getElementById('review-form');
        if (reviewForm) {
            let selectedRating = 0;

            // Инициализация рейтинга звёзд
            const stars = document.querySelectorAll('.rating-input i');
            stars.forEach(star => {
                star.addEventListener('click', function() {
                    selectedRating = parseInt(this.getAttribute('data-rating'));
                    document.getElementById('selected-rating').value = selectedRating;
                    document.getElementById('rating-error').classList.add('d-none');

                    stars.forEach(s => {
                        const rating = parseInt(s.getAttribute('data-rating'));
                        if (rating <= selectedRating) {
                            s.classList.remove('far');
                            s.classList.add('fas', 'active');
                        } else {
                            s.classList.remove('fas', 'active');
                            s.classList.add('far');
                        }
                    });
                });

                star.addEventListener('mouseenter', function() {
                    const rating = parseInt(this.getAttribute('data-rating'));
                    stars.forEach(s => {
                        const sRating = parseInt(s.getAttribute('data-rating'));
                        if (sRating <= rating) {
                            s.classList.add('hover');
                        }
                    });
                });

                star.addEventListener('mouseleave', function() {
                    stars.forEach(s => {
                        s.classList.remove('hover');
                    });
                });
            });

            // Счетчик символов
            const reviewText = document.getElementById('review-text');
            const charCounter = document.getElementById('char-counter');

            reviewText.addEventListener('input', function() {
                const length = this.value.length;
                charCounter.textContent = length;

                if (length > 2000) {
                    this.value = this.value.substring(0, 2000);
                    charCounter.textContent = 2000;
                }
            });

            // Обработка отправки формы
            reviewForm.addEventListener('submit', async function(event) {
                event.preventDefault();

                // Валидация
                const name = document.getElementById('review-name').value.trim();
                const email = document.getElementById('review-email').value.trim();
                const text = document.getElementById('review-text').value.trim();

                if (!name || !email || !text) {
                    showFormError('Пожалуйста, заполните все поля');
                    return;
                }

                if (selectedRating === 0) {
                    document.getElementById('rating-error').classList.remove('d-none');
                    return;
                }

                if (text.length < 10) {
                    showFormError('Текст отзыва должен содержать не менее 10 символов');
                    return;
                }

                // Блокируем кнопку
                const submitBtn = document.getElementById('submit-review-btn');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Отправка...';

                try {
                    const response = await fetch('/api/Review/Create', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            name: name,
                            email: email,
                            rating: selectedRating,
                            text: text
                        })
                    });

                    const data = await response.json();

                    if (response.ok) {
                        // Успешная отправка
                        showFormSuccess('Отзыв успешно отправлен!');

                        // Сбрасываем форму
                        reviewForm.reset();
                        stars.forEach(s => {
                            s.classList.remove('fas', 'active', 'hover');
                            s.classList.add('far');
                        });
                        selectedRating = 0;
                        document.getElementById('selected-rating').value = 0;
                        charCounter.textContent = '0';

                        // Обновляем отзывы
                        await loadReviews();
                        await loadStatistics();
                    } else {
                        showFormError(data.error || 'Ошибка при отправке отзыва');
                    }
                } catch (error) {
                    showFormError('Ошибка соединения с сервером');
                    console.error('Error:', error);
                } finally {
                    // Разблокируем кнопку
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = 'Отправить отзыв';
                }
            });
        }
    });

    // Функция загрузки отзывов
    async function loadReviews() {
        const reviewsContainer = document.getElementById('reviews-container');
        const loadingSpinner = document.getElementById('loading-spinner');
        const errorMessage = document.getElementById('error-message');

        reviewsContainer.innerHTML = '';
        loadingSpinner.classList.remove('d-none');
        errorMessage.classList.add('d-none');

        try {
            const response = await fetch('/api/Review/GetAll');

            if (!response.ok) {
                throw new Error('Ошибка загрузки');
            }

            const reviews = await response.json();

            loadingSpinner.classList.add('d-none');

            if (reviews.length === 0) {
                reviewsContainer.innerHTML = `
                    <div class="col-12 text-center py-5">
                        <i class="fas fa-comments fa-4x text-muted mb-3"></i>
                        <h4 class="text-muted">Пока нет отзывов</h4>
                        <p class="text-muted">Будьте первым, кто оставит отзыв!</p>
                    </div>
                `;
                return;
            }

            // Сортируем отзывы по дате (новые сначала)
            const sortedReviews = reviews.sort((a, b) =>
                new Date(b.createdAt) - new Date(a.createdAt)
            );

            sortedReviews.forEach(review => {
                const starsHTML = getStarsHTML(review.rating);
                const reviewDate = formatDate(review.createdAt);

                reviewsContainer.innerHTML += `
                    <div class="col-md-6 mb-4">
                        <div class="review-card p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h6 class="fw-semibold mb-1">${escapeHtml(review.name)}</h6>
                                    <div class="stars mb-2">${starsHTML}</div>
                                </div>
                                <small class="text-muted">${reviewDate}</small>
                            </div>
                            <p class="mb-0">${escapeHtml(review.text)}</p>
                        </div>
                    </div>
                `;
            });
        } catch (error) {
            loadingSpinner.classList.add('d-none');
            errorMessage.classList.remove('d-none');
            document.getElementById('error-text').textContent = error.message;
            console.error('Error loading reviews:', error);
        }
    }

    // Функция загрузки статистики
    async function loadStatistics() {
        try {
            const response = await fetch('/api/Review/GetStatistics');

            if (!response.ok) {
                throw new Error('Ошибка загрузки статистики');
            }

            const stats = await response.json();

            // Обновляем общий рейтинг
            document.getElementById('average-rating').textContent = stats.averageRating.toFixed(1);
            document.getElementById('reviews-count').textContent = `На основе ${stats.totalReviews} отзывов`;
            updateStarsDisplay(stats.averageRating);

            // Обновляем статистику по оценкам
            document.getElementById('stat-5').textContent = stats.ratingCounts[5] || 0;
            document.getElementById('stat-4').textContent = stats.ratingCounts[4] || 0;
            document.getElementById('stat-3').textContent = stats.ratingCounts[3] || 0;
            document.getElementById('stat-2').textContent = stats.ratingCounts[2] || 0;
        } catch (error) {
            console.error('Error loading statistics:', error);
        }
    }

    // Вспомогательные функции
    function formatDate(dateString) {
        const date = new Date(dateString);
        return date.toLocaleDateString('ru-RU', {
            day: 'numeric',
            month: 'long',
            year: 'numeric'
        });
    }

    function getStarsHTML(rating) {
        let starsHTML = '';
        for (let i = 1; i <= 5; i++) {
            if (i <= rating) {
                starsHTML += '<i class="fas fa-star text-warning"></i>';
            } else {
                starsHTML += '<i class="far fa-star text-warning"></i>';
            }
        }
        return starsHTML;
    }

    function updateStarsDisplay(rating) {
        const averageStars = document.getElementById('average-stars');
        averageStars.innerHTML = getStarsHTML(Math.round(rating));
    }

    function showFormError(message) {
        const errorDiv = document.getElementById('form-error');
        errorDiv.textContent = message;
        errorDiv.classList.remove('d-none');

        setTimeout(() => {
            errorDiv.classList.add('d-none');
        }, 5000);
    }

    function showFormSuccess(message) {
        const successDiv = document.getElementById('form-success');
        successDiv.textContent = message;
        successDiv.classList.remove('d-none');

        setTimeout(() => {
            successDiv.classList.add('d-none');
        }, 5000);
    }

    function escapeHtml(unsafe) {
        if (!unsafe) return '';
        return unsafe
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }
</script>