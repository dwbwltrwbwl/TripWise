@{
    ViewData["Title"] = "Активности";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4" style="font-family: 'Nunito', sans-serif; font-weight: 800; font-size: 2.5rem; color: #333; color: #0379D9;">
                Активности и развлечения
            </h1>

            @if (Context.Session.GetInt32("UserId") == null)
            {
                <div class="alert alert-info">
                    <h5>Войдите в аккаунт</h5>
                    <p>Чтобы планировать активности и развлечения, войдите в свой аккаунт.</p>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Войти</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary">Зарегистрироваться</a>
                </div>
            }
            else
            {
                <!-- Форма поиска активностей -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-4">
                        <h5 class="card-title mb-3" style="font-family: 'Nunito', sans-serif;">Поиск активностей на карте</h5>
                        <form id="activitiesSearchForm">
                            <div class="row g-3 align-items-end">
                                <div class="col-md-6">
                                    <label class="form-label fw-medium">Место для поиска</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                                        <input type="text"
                                               class="form-control"
                                               id="activitiesDestination"
                                               placeholder="Введите город или область (например: Сочи, Москва, Санкт-Петербург)"
                                               required
                                               style="font-family: 'Nunito', sans-serif;"
                                               value="">
                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                id="useMyLocationForActivities"
                                                title="Использовать мое местоположение">
                                            <i class="fas fa-location-arrow"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-medium">Радиус поиска</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-ruler"></i></span>
                                        <select class="form-select" id="activitiesRadius" style="font-family: 'Nunito', sans-serif;">
                                            <option value="1">1 км</option>
                                            <option value="2">2 км</option>
                                            <option value="5" selected>5 км</option>
                                            <option value="10">10 км</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-medium">Категория</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-filter"></i></span>
                                        <select class="form-select" id="activityType" style="font-family: 'Nunito', sans-serif;">
                                            <option value="all">Все активности</option>
                                            <option value="tourism">Достопримечательности</option>
                                            <option value="amenity">Удобства</option>
                                            <option value="leisure">Развлечения</option>
                                            <option value="sport">Спорт</option>
                                            <option value="shop">Магазины</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 mt-2">
                                    <button type="submit"
                                            id="searchActivitiesButton"
                                            class="btn btn-primary btn-lg text-center"
                                            style="font-family: 'Nunito', sans-serif; height: 46px;">
                                        <i class="fas fa-search me-2"></i>Искать активности
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Карта и результаты -->
                <div class="row mt-2">
                    <!-- Левая колонка: Карта -->
                    <div class="col-lg-8">
                        <div class="card shadow-sm mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0" style="font-family: 'Nunito', sans-serif;">
                                    <i class="fas fa-map me-2"></i>Карта активностей
                                </h5>
                            </div>
                            <div class="card-body p-0" style="height: 500px;">
                                <div id="activitiesMap" style="height: 100%; width: 100%;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Правая колонка: Список активностей -->
                    <div class="col-lg-4">
                        <div class="card shadow-sm">
                            <div class="card-header bg-light">
                                <h5 class="mb-0" style="font-family: 'Nunito', sans-serif;">
                                    <i class="fas fa-list me-2"></i>Найденные места
                                    <span id="activitiesCount" class="badge bg-primary ms-2">0</span>
                                </h5>
                            </div>
                            <div class="card-body p-0" style="height: 500px; overflow-y: auto;">
                                <div id="activitiesList" class="p-3">
                                    <div class="text-center text-muted py-5">
                                        <i class="fas fa-search fa-2x mb-3"></i>
                                        <p>Введите место для поиска активностей</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Мои запланированные активности -->
                <div class="mt-4">
                    <h4 class="mb-3">Запланированные активности</h4>
                    <div class="card">
                        <div class="card-body">
                            <div id="plannedActivities">
                                <div class="text-center text-muted py-3">
                                    <i class="fas fa-calendar-plus fa-2x mb-2"></i>
                                    <p>У вас пока нет запланированных активностей</p>
                                    <p class="small">Найдите активности на карте и добавляйте их в план</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Модальное окно для добавления активности -->
<div class="modal fade" id="addActivityModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Добавить активность</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addActivityForm">
                    <div class="mb-3">
                        <label class="form-label">Название активности</label>
                        <input type="text" class="form-control" id="activityName" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Дата</label>
                        <input type="date" class="form-control" id="activityDate" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Время</label>
                        <input type="time" class="form-control" id="activityTime" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Описание (необязательно)</label>
                        <textarea class="form-control" id="activityDescription" rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-primary" onclick="savePlannedActivity()">Сохранить</button>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно подтверждения удаления -->
<div class="modal fade" id="deleteActivityModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Подтверждение удаления</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Вы уверены, что хотите удалить эту активность из плана?</p>
                <p class="text-muted small" id="deleteActivityName"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-danger" onclick="confirmDeleteActivity()">Удалить</button>
            </div>
        </div>
    </div>
</div>

