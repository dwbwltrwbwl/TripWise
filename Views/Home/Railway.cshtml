    function selectRailwayDestination(fromCity, toCity) {
        console.log(`Выбрано ЖД направление: ${fromCity} → ${toCity}`);
        document.getElementById('railwayDeparture').value = fromCity;
        document.getElementById('railwayArrival').value = toCity;
        document.getElementById('railwayDeparture').setAttribute('data-station-id', getRailwayStationId(fromCity));
        document.getElementById('railwayArrival').setAttribute('data-station-id', getRailwayStationId(toCity));

        const today = new Date();
        const departureDate = new Date(today);
        departureDate.setDate(today.getDate() + 3);
        const returnDate = new Date(today);
        returnDate.setDate(today.getDate() + 10);

        document.getElementById('railwayDepartureDate').value = departureDate.toISOString().split('T')[0];
        document.getElementById('railwayReturnDate').value = returnDate.toISOString().split('T')[0];

        document.getElementById('railwaySearchForm').scrollIntoView({ behavior: 'smooth' });
        showNotification(`Направление ${fromCity} → ${toCity} добавлено в форму поиска`, 'success');
    }

