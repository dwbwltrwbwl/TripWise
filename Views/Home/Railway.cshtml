    function isTrainFavorite(trainId) {
        return favoriteTrains[trainId] || false;
    }

    function updateTrainFavoriteButton(trainId) {
        const buttons = document.querySelectorAll('.train-favorite-btn');
        buttons.forEach(button => {
            if (button.getAttribute('data-train-id') === trainId) {
                if (isTrainFavorite(trainId)) {
                    button.innerHTML = '<i class="fas fa-heart text-danger fa-lg"></i>';
                    button.title = 'Удалить из избранного';
                } else {
                    button.innerHTML = '<i class="far fa-heart fa-lg text-muted"></i>';
                    button.title = 'Добавить в избранное';
                }
            }
        });
    }

    // Автодополнение для станций
    function initializeAutocomplete() {
        const departureInput = document.getElementById('railwayDeparture');
        const arrivalInput = document.getElementById('railwayArrival');
        const departureDropdown = document.getElementById('railwayDepartureDropdown');
        const arrivalDropdown = document.getElementById('railwayArrivalDropdown');

        setupAutocomplete(departureInput, departureDropdown);
        setupAutocomplete(arrivalInput, arrivalDropdown);
    }

    function setupAutocomplete(input, dropdown) {
        let searchTimeout;

        input.addEventListener('input', async function(e) {
            const query = e.target.value.trim();

            clearTimeout(searchTimeout);

            if (query.length < 2) {
                dropdown.style.display = 'none';
                return;
            }

            searchTimeout = setTimeout(async () => {
                const stations = await searchStationsFromApi(query);
                showAutocompleteResults(stations, dropdown, input);
            }, 300);
        });

        input.addEventListener('focus', async function() {
            const query = this.value.trim();
            if (query.length >= 2) {
                const stations = await searchStationsFromApi(query);
                showAutocompleteResults(stations, dropdown, input);
            }
        });

        document.addEventListener('click', function(e) {
            if (!input.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.style.display = 'none';
            }
        });
    }

    // Поиск станций через API
    async function searchStationsFromApi(query) {
        try {
            const response = await fetch(`/api/trains/stations/search?query=${encodeURIComponent(query)}`);
            if (response.ok) {
                return await response.json();
            }
        } catch (error) {
            console.error('Ошибка поиска станций:', error);
        }
        return [];
    }

    function showAutocompleteResults(stations, dropdown, input) {
        if (stations.length === 0) {
            dropdown.style.display = 'none';
            return;
        }

        dropdown.innerHTML = stations.map(station => `
            <div class="autocomplete-item" data-station='${JSON.stringify(station)}'>
                <div class="station-name">${station.name}</div>
                <div class="station-region">${station.region}</div>
            </div>
        `).join('');

        dropdown.style.display = 'block';

        dropdown.querySelectorAll('.autocomplete-item').forEach(item => {
            item.addEventListener('click', function() {
                const station = JSON.parse(this.getAttribute('data-station'));
                input.value = station.name;
                input.setAttribute('data-station-id', station.id);
                dropdown.style.display = 'none';
            });
        });
    }

    // Инициализация дат
    function initializeDateInputs() {
        const today = new Date();
        const departureDateInput = document.getElementById('railwayDepartureDate');
        const returnDateInput = document.getElementById('railwayReturnDate');

        departureDateInput.min = today.toISOString().split('T')[0];
        returnDateInput.min = today.toISOString().split('T')[0];
    }

    // Обработчик формы
    function setupFormHandler() {
        const form = document.getElementById('railwaySearchForm');
        const resultsContainer = document.getElementById('railwayResults');
        const loadingIndicator = document.getElementById('railwayLoading');

        form.addEventListener('submit', async function(e) {
            e.preventDefault();

            const departureStation = document.getElementById('railwayDeparture');
            const arrivalStation = document.getElementById('railwayArrival');
            const departureDate = document.getElementById('railwayDepartureDate');
            const returnDate = document.getElementById('railwayReturnDate');
            const passengers = document.getElementById('railwayPassengers');

            console.log('=== ОБРАБОТКА ФОРМЫ ЖД ===');
            console.log('departureStation:', departureStation.value);
            console.log('arrivalStation:', arrivalStation.value);
            console.log('departureDate:', departureDate.value);
            console.log('returnDate:', returnDate.value);
            console.log('returnDate value length:', returnDate.value.length);

            if (!departureStation.getAttribute('data-station-id') ||
                !arrivalStation.getAttribute('data-station-id')) {
                alert('Пожалуйста, выберите станции из списка');
                return;
            }

            if (departureStation.getAttribute('data-station-id') === arrivalStation.getAttribute('data-station-id')) {
                alert('Станции отправления и назначения не могут совпадать');
                return;
            }

            loadingIndicator.classList.remove('d-none');
            resultsContainer.innerHTML = '';

            try {
                const searchData = {
                    departureStationId: departureStation.getAttribute('data-station-id'),
                    arrivalStationId: arrivalStation.getAttribute('data-station-id'),
                    departureDate: departureDate.value,
                    returnDate: returnDate.value || null, // Явно указываем null если пусто
                    passengers: parseInt(passengers.value)
                };

                const trainGroups = await searchTrains(searchData);
                displaySearchResults(trainGroups, searchData);

            } catch (error) {
                console.error('Ошибка поиска:', error);
                resultsContainer.innerHTML = `
                    <div class="alert alert-danger">
                        <h5>Произошла ошибка при поиске</h5>
                        <p>${error.message || 'Пожалуйста, попробуйте позже'}</p>
                    </div>
                `;
            } finally {
                loadingIndicator.classList.add('d-none');
            }
        });
    }

    // Поиск поездов через ваше ASP.NET API
    async function searchTrains(searchData) {
        console.log('=== ПОИСК ЖД БИЛЕТОВ ===');

        const requestBody = {
            departureStationId: searchData.departureStationId,
            arrivalStationId: searchData.arrivalStationId,
            departureDate: searchData.departureDate,
            returnDate: searchData.returnDate || null,
            passengers: searchData.passengers
        };

        console.log('Отправляемые данные:', JSON.stringify(requestBody, null, 2));

        const response = await fetch('/api/trains/search', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(requestBody)
        });

        if (!response.ok) {
            throw new Error('Ошибка сервера');
        }

        const result = await response.json();
        console.log('Ответ от API:', result);
        console.log('Всего групп поездов:', result.trainGroups?.length || 0);

        if (result.success) {
            return result.trainGroups || [];
        } else {
            throw new Error(result.message || 'Ошибка при поиске поездов');
        }
    }

    // Обновленная функция отображения результатов
    function displaySearchResults(trainGroups, searchData) {
        const resultsContainer = document.getElementById('railwayResults');

        if (!trainGroups || trainGroups.length === 0) {
            resultsContainer.innerHTML = `
                <div class="alert alert-info">
                    <h5>Поезда не найдены</h5>
                    <p>Попробуйте изменить параметры поиска или даты</p>
                </div>
            `;
            return;
        }

        console.log('Отображаем группы поездов:', trainGroups);

        let html = `
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3>Найдено вариантов: ${trainGroups.length}</h3>
                <div class="text-muted">
                    ${document.getElementById('railwayDeparture').value} →
                    ${document.getElementById('railwayArrival').value}
                    ${searchData.returnDate ? ' (туда и обратно)' : ' (в одну сторону)'}
                </div>
            </div>
        `;

        // Для каждой группы генерируем карточку
        trainGroups.forEach((group, index) => {
            html += generateTrainGroupCard(group, searchData, index);
        });

        resultsContainer.innerHTML = html;
    }

    // Новая функция для генерации комбинированной карточки
    function generateTrainGroupCard(group, searchData, index) {
        const uniqueGroupId = `train-group-${group.id}-${index}`;
        const isFav = isTrainFavorite(uniqueGroupId);
        const isRoundTrip = group.isRoundTrip;

        // Цвет в зависимости от типа
        const typeColor = isRoundTrip ? 'warning' : 'primary';
        const typeIcon = isRoundTrip ? 'fa-exchange-alt' : 'fa-train';
        const typeBadge = isRoundTrip ?
            '<span class="badge bg-warning ms-2">Туда и обратно</span>' :
            '<span class="badge bg-primary ms-2">Только туда</span>';

        return `
            <div class="card train-group-card shadow-sm mb-4 border-${typeColor}">
                <div class="card-header bg-${typeColor} text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fas ${typeIcon} me-2"></i>
                            <strong>Вариант ${index + 1}</strong>
                            ${typeBadge}
                        </div>
                        <div class="text-end">
                            <h4 class="mb-0 text-white">${group.totalPrice.toLocaleString('ru-RU')} ₽</h4>
                            <small class="opacity-75">за пассажира</small>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Секция "Поезд туда" -->
                    ${generateTrainSection(group.forwardTrain, 'Туда', searchData.departureDate, 'primary')}

                    <!-- Секция "Поезд обратно" (если есть) -->
                    ${isRoundTrip && group.returnTrain ?
                        generateTrainSection(group.returnTrain, 'Обратно', searchData.returnDate, 'success') :
                        ''}

                    <!-- Информация о ценах -->
                    <div class="row mt-4">
                        <div class="col-md-8">
                            <h6>Доступные места:</h6>
                            <div class="d-flex flex-wrap gap-2">
                                ${generateCategoriesInfo(group)}
                            </div>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="d-flex align-items-center justify-content-end gap-3">
                                <!-- Кнопка избранного -->
                                <button class="train-favorite-btn p-2 border-0 bg-transparent"
                                        data-train-id="${uniqueGroupId}"
                                        onclick="toggleTrainFavorite('${uniqueGroupId}')"
                                        title="${isFav ? 'Удалить из избранного' : 'Добавить в избранное'}">
                                    ${isFav ?
                                        '<i class="fas fa-heart text-danger fa-lg"></i>' :
                                        '<i class="far fa-heart fa-lg text-muted"></i>'
                                    }
                                </button>

                                <!-- Кнопка выбора -->
                                <div>
                                    ${isRoundTrip ?
                                        `<button class="btn btn-${typeColor} btn-lg px-4"
                                                onclick="selectRoundTrip('${group.forwardTrain.trainNumber}', '${group.returnTrain.trainNumber}')">
                                            <i class="fas fa-check me-2"></i>
                                            Выбрать оба
                                        </button>` :
                                        `<button class="btn btn-${typeColor} btn-lg px-4"
                                                onclick="selectOneWay('${group.forwardTrain.trainNumber}')">
                                            <i class="fas fa-check me-2"></i>
                                            Выбрать
                                        </button>`
                                    }
                                    <div class="mt-2">
                                        <button class="btn btn-outline-${typeColor} btn-sm me-2"
                                                onclick="viewDetails('${group.id}')">
                                            <i class="fas fa-info-circle me-1"></i>Подробнее
                                        </button>
                                        <button class="btn btn-outline-success btn-sm"
                                                onclick="bookTickets(${JSON.stringify(group).replace(/"/g, '&quot;')})">
                                            <i class="fas fa-shopping-cart me-1"></i>Купить
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        `;
    }

    // Функция для генерации секции поезда
    function generateTrainSection(train, title, date, color) {
        return `
            <div class="train-section mb-3 p-3 border-start border-${color} border-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0 text-${color}">
                        <i class="fas fa-train me-2"></i>
                        ${title}
                        <small class="text-muted ms-2">${formatDateForDisplay(date)}</small>
                    </h6>
                    <div>
                        <span class="badge bg-${color}">№ ${train.trainNumber}</span>
                        ${train.firm ? '<span class="badge bg-warning ms-1">Фирменный</span>' : ''}
                    </div>
                </div>

                <div class="row align-items-center">
                    <div class="col-4 text-center">
                        <div class="train-time fw-bold fs-5">${formatTime(train.departureTime)}</div>
                        <div class="text-muted small">${getStationName(train.departureStation)}</div>
                    </div>
                    <div class="col-4 text-center">
                        <div class="train-duration text-${color} fw-bold">
                            <i class="fas fa-clock me-1"></i>
                            ${formatDurationFromString(train.travelTime)}
                        </div>
                        <div class="route-line text-${color} opacity-50">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                    <div class="col-4 text-center">
                        <div class="train-time fw-bold fs-5">${formatTime(train.arrivalTime)}</div>
                        <div class="text-muted small">${getStationName(train.arrivalStation)}</div>
                    </div>
                </div>
            </div>
        `;
    }

    // Функция для генерации информации о категориях
    function generateCategoriesInfo(group) {
        let html = '';

        if (group.forwardTrain?.categories) {
            html += '<div class="mb-1"><small class="text-muted">Туда:</small></div>';
            group.forwardTrain.categories.forEach((cat, i) => {
                if (i < 3) { // Показываем только первые 3 категории
                    html += `<span class="badge bg-light text-dark">
                        ${getCategoryName(cat.type)}: ${cat.price} ₽
                    </span>`;
                }
            });
        }

        if (group.returnTrain?.categories) {
            html += '<div class="mb-1 mt-2"><small class="text-muted">Обратно:</small></div>';
            group.returnTrain.categories.forEach((cat, i) => {
                if (i < 3) {
                    html += `<span class="badge bg-light text-dark">
                        ${getCategoryName(cat.type)}: ${cat.price} ₽
                    </span>`;
                }
            });
        }

        return html;
    }

    // Функции для действий
    function selectRoundTrip(forwardTrainNumber, returnTrainNumber) {
        alert(`Выбраны поезда:\nТуда: №${forwardTrainNumber}\nОбратно: №${returnTrainNumber}`);
        console.log('Выбран комбинированный вариант:', forwardTrainNumber, returnTrainNumber);
    }

    function selectOneWay(trainNumber) {
        alert(`Выбран поезд: №${trainNumber}`);
        console.log('Выбран односторонний вариант:', trainNumber);
    }

    function viewDetails(groupId) {
        console.log('Просмотр подробностей группы:', groupId);
        // Здесь можно открыть модальное окно с подробной информацией
    }

    function bookTickets(group) {
        console.log('Бронирование билетов для группы:', group);

        if (group.isRoundTrip) {
            alert(`Бронирование билетов:\nТуда: №${group.forwardTrain.trainNumber}\nОбратно: №${group.returnTrain.trainNumber}\nОбщая цена: ${group.totalPrice.toLocaleString('ru-RU')} ₽`);
        } else {
            alert(`Бронирование билета:\nПоезд: №${group.forwardTrain.trainNumber}\nЦена: ${group.totalPrice.toLocaleString('ru-RU')} ₽`);
        }
    }

    // Вспомогательные функции
    function formatDateForDisplay(dateString) {
        if (!dateString) return '';

        try {
            const date = new Date(dateString);
            if (isNaN(date.getTime())) {
                return dateString;
            }

            return date.toLocaleDateString('ru-RU', {
                weekday: 'short',
                day: 'numeric',
                month: 'long',
                year: 'numeric'
            });
        } catch (error) {
            console.error('Ошибка форматирования даты:', error, dateString);
            return dateString;
        }
    }

    function formatTime(timeString) {
        if (!timeString) return '--:--';
        return timeString.substring(0, 5);
    }

    function formatDurationFromString(durationString) {
        if (!durationString) return '';
        return durationString;
    }

    function getCategoryName(type) {
        const categories = {
            'plazcard': 'Плацкарт',
            'coupe': 'Купе',
            'sedentary': 'Сидячий',
            'lux': 'Люкс',
            'soft': 'Мягкий',
            'other': 'Другой'
        };
        return categories[type] || type;
    }

    function getMinPrice(categories) {
        if (!categories || categories.length === 0) return 'Цена не указана';
        const prices = categories.map(cat => cat.price).filter(price => price > 0);
        return prices.length > 0 ? Math.min(...prices) + ' ₽' : 'Цена не указана';
    }

    function getStationName(stationId) {
        const station = stationsData.find(s => s.id === stationId);
        return station ? station.name : stationId;
    }

    // Функции для переходов на Tutu.ru
    function viewSchedule(departureStation, arrivalStation, date) {
        const formattedDate = formatDateForTutu(date);
        const url = `https://www.tutu.ru/poezda/rasp_d.php?nnst1=${departureStation}&nnst2=${arrivalStation}&date=${formattedDate}`;
        window.open(url, '_blank');
    }

    function bookTicket(departureStation, arrivalStation, trainNumber, date) {
        const formattedDate = formatDateForTutu(date);
        const url = `https://www.tutu.ru/poezda/order/?dep_st=${departureStation}&arr_st=${arrivalStation}&tn=${trainNumber}&date=${formattedDate}`;
        window.open(url, '_blank');
    }

    function formatDateForTutu(dateString) {
        const date = new Date(dateString);
        const day = String(date.getDate()).padStart(2, '0');
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const year = date.getFullYear();
        return `${day}.${month}.${year}`;
    }

