    // Функции для работы с избранными поездами
    async function toggleTrainFavorite(trainId) {
        // Проверяем авторизацию
        const isAuthenticated = await checkAuthentication();

        if (!isAuthenticated) {
            showAuthModal();
            return;
        }

        // Если пользователь авторизован, добавляем/убираем из избранного
        if (favoriteTrains[trainId]) {
            delete favoriteTrains[trainId];
        } else {
            favoriteTrains[trainId] = true;
        }

        localStorage.setItem('favoriteTrains', JSON.stringify(favoriteTrains));
        updateTrainFavoriteButton(trainId);

        // Показываем уведомление об успешном действии
        showFavoriteNotification(favoriteTrains[trainId]);
    }

    async function checkAuthentication() {
        try {
            const response = await fetch('/api/auth/check', {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                }
            });

            if (response.ok) {
                const result = await response.json();
                return result.authenticated || false;
            }
        } catch (error) {
            console.error('Ошибка проверки авторизации:', error);
        }

        return false;
    }

