    function bookTickets(group) {
        console.log('Бронирование билетов для группы:', group);

        // Формируем URL для перехода на оформление
        let url = '/TrainBooking/Book?';

        const params = new URLSearchParams({
            trainNumber: group.forwardTrain.trainNumber,
            departureStation: getStationName(group.forwardTrain.departureStation),
            arrivalStation: getStationName(group.forwardTrain.arrivalStation),
            departureDateTime: formatDateTime(group.forwardTrain.departureDate, group.forwardTrain.departureTime),
            arrivalDateTime: formatDateTime(group.forwardTrain.arrivalDate, group.forwardTrain.arrivalTime),
            price: group.totalPrice || 0,
            passengers: document.getElementById('railwayPassengers').value,
            isRoundTrip: group.isRoundTrip || false
        });

        if (group.isRoundTrip && group.returnTrain) {
            params.append('returnTrainNumber', group.returnTrain.trainNumber);
            params.append('returnDepartureDateTime', formatDateTime(group.returnTrain.departureDate, group.returnTrain.departureTime));
            params.append('returnArrivalDateTime', formatDateTime(group.returnTrain.arrivalDate, group.returnTrain.arrivalTime));
        }

        url += params.toString();
        console.log('Переход на оформление:', url);
        window.location.href = url;
    }

