@{
    ViewData["Title"] = "Помощь";
    Layout = "~/Views/Shared/_LegalLayout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h1 class="h3 mb-0" style="font-family: 'Nunito', sans-serif;">
                        <i class="fas fa-question-circle me-2"></i>Помощь
                    </h1>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <p class="lead">Здесь вы найдете ответы на часто задаваемые вопросы и инструкции по использованию сервиса.</p>
                    </div>

                    <!-- Быстрые ссылки -->
                    <div class="row mb-5">
                        <div class="col-12">
                            <h3 style="font-family: 'Nunito', sans-serif; color: #0379D9;">Быстрые разделы</h3>
                            <div class="row mt-3">
                                <div class="col-md-3 mb-3">
                                    <a href="#booking" class="help-category card text-decoration-none h-100">
                                        <div class="card-body text-center">
                                            <i class="fas fa-ticket-alt fa-2x text-primary mb-2"></i>
                                            <h6>Бронирование</h6>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <a href="#payment" class="help-category card text-decoration-none h-100">
                                        <div class="card-body text-center">
                                            <i class="fas fa-credit-card fa-2x text-success mb-2"></i>
                                            <h6>Оплата</h6>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <a href="#cancellation" class="help-category card text-decoration-none h-100">
                                        <div class="card-body text-center">
                                            <i class="fas fa-undo fa-2x text-warning mb-2"></i>
                                            <h6>Отмена и возврат</h6>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <a href="#account" class="help-category card text-decoration-none h-100">
                                        <div class="card-body text-center">
                                            <i class="fas fa-user fa-2x text-info mb-2"></i>
                                            <h6>Аккаунт</h6>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <a href="#hotels" class="help-category card text-decoration-none h-100">
                                        <div class="card-body text-center">
                                            <i class="fas fa-hotel fa-2x text-danger mb-2"></i>
                                            <h6>Отели</h6>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <a href="#documents" class="help-category card text-decoration-none h-100">
                                        <div class="card-body text-center">
                                            <i class="fas fa-file-alt fa-2x text-secondary mb-2"></i>
                                            <h6>Документы</h6>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <a href="#technical" class="help-category card text-decoration-none h-100">
                                        <div class="card-body text-center">
                                            <i class="fas fa-cog fa-2x text-dark mb-2"></i>
                                            <h6>Техподдержка</h6>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <a href="#safety" class="help-category card text-decoration-none h-100">
                                        <div class="card-body text-center">
                                            <i class="fas fa-shield-alt fa-2x text-success mb-2"></i>
                                            <h6>Безопасность</h6>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Бронирование -->
                    <section id="booking" class="mb-5">
                        <h3 style="font-family: 'Nunito', sans-serif; color: #0379D9;">
                            <i class="fas fa-ticket-alt me-2"></i>Бронирование
                        </h3>
                        <div class="accordion mt-3" id="bookingAccordion">
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#booking1">
                                        Как забронировать билет?
                                    </button>
                                </h2>
                                <div id="booking1" class="accordion-collapse collapse show" data-bs-parent="#bookingAccordion">
                                    <div class="accordion-body">
                                        <ol>
                                            <li>Выберите направление и даты в форме поиска</li>
                                            <li>Выберите подходящий рейс/поезд из списка</li>
                                            <li>Заполните данные пассажиров</li>
                                            <li>Оплатите бронирование</li>
                                            <li>Получите билет на email</li>
                                        </ol>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#booking2">
                                        Нужна ли регистрация для бронирования?
                                    </button>
                                </h2>
                                <div id="booking2" class="accordion-collapse collapse" data-bs-parent="#bookingAccordion">
                                    <div class="accordion-body">
                                        Да, для бронирования билетов и отелей требуется регистрация. Это необходимо для сохранения ваших данных и истории заказов.
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#booking3">
                                        Можно ли забронировать билет за другого человека?
                                    </button>
                                </h2>
                                <div id="booking3" class="accordion-collapse collapse" data-bs-parent="#bookingAccordion">
                                    <div class="accordion-body">
                                        Да, вы можете бронировать билеты для других людей. При заполнении данных пассажира укажите его точные ФИО и паспортные данные.
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#booking4">
                                        Сколько времени занимает бронирование?
                                    </button>
                                </h2>
                                <div id="booking4" class="accordion-collapse collapse" data-bs-parent="#bookingAccordion">
                                    <div class="accordion-body">
                                        Бронирование занимает 5-10 минут при условии корректно заполненных данных и успешной оплаты.
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#booking5">
                                        Можно ли изменить данные после бронирования?
                                    </button>
                                </h2>
                                <div id="booking5" class="accordion-collapse collapse" data-bs-parent="#bookingAccordion">
                                    <div class="accordion-body">
                                        Изменение данных пассажира после бронирования возможно только через службу поддержки и может повлечь дополнительные сборы.
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#booking6">
                                        Как узнать статус моего бронирования?
                                    </button>
                                </h2>
                                <div id="booking6" class="accordion-collapse collapse" data-bs-parent="#bookingAccordion">
                                    <div class="accordion-body">
                                        Статус бронирования можно посмотреть в личном кабинете в разделе "Мои заказы". Также вы получите уведомление на email.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Оплата -->
                    <section id="payment" class="mb-5">
                        <h3 style="font-family: 'Nunito', sans-serif; color: #0379D9;">
                            <i class="fas fa-credit-card me-2"></i>Оплата
                        </h3>
                        <div class="accordion mt-3" id="paymentAccordion">
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#payment1">
                                        Какие способы оплаты доступны?
                                    </button>
                                </h2>
                                <div id="payment1" class="accordion-collapse collapse show" data-bs-parent="#paymentAccordion">
                                    <div class="accordion-body">
                                        Мы принимаем: банковские карты (Мир), электронные кошельки (ЮMoney), интернет-банкинг (Сбербанк, Тинькофф).
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#payment2">
                                        Безопасна ли оплата на сайте?
                                    </button>
                                </h2>
                                <div id="payment2" class="accordion-collapse collapse" data-bs-parent="#paymentAccordion">
                                    <div class="accordion-body">
                                        Да, все платежи защищены SSL-шифрованием. Мы не храним данные вашей карты. Обработка платежей происходит через защищенные платежные шлюзы.
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#payment3">
                                        Что делать, если оплата не прошла?
                                    </button>
                                </h2>
                                <div id="payment3" class="accordion-collapse collapse" data-bs-parent="#paymentAccordion">
                                    <div class="accordion-body">
                                        <ul>
                                            <li>Проверьте баланс карты</li>
                                            <li>Убедитесь, что карта поддерживает онлайн-платежи</li>
                                            <li>Проверьте правильность введенных данных</li>
                                            <li>Попробуйте другой способ оплаты</li>
                                            <li>Обратитесь в банк-эмитент карты</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#payment4">
                                        Приходит ли чек об оплате?
                                    </button>
                                </h2>
                                <div id="payment4" class="accordion-collapse collapse" data-bs-parent="#paymentAccordion">
                                    <div class="accordion-body">
                                        Да, электронный чек приходит на ваш email сразу после успешной оплаты. Также чек можно скачать в личном кабинете.
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#payment5">
                                        Можно ли оплатить заказ частично?
                                    </button>
                                </h2>
                                <div id="payment5" class="accordion-collapse collapse" data-bs-parent="#paymentAccordion">
                                    <div class="accordion-body">
                                        Нет, оплата бронирования происходит полностью в момент оформления заказа. Рассрочка и частичная оплата не предусмотрены.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Отмена и возврат -->
                    <section id="cancellation" class="mb-5">
                        <h3 style="font-family: 'Nunito', sans-serif; color: #0379D9;">
                            <i class="fas fa-undo me-2"></i>Отмена и возврат
                        </h3>
                        <div class="accordion mt-3" id="cancellationAccordion">
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#cancellation1">
                                        Как отменить бронирование?
                                    </button>
                                </h2>
                                <div id="cancellation1" class="accordion-collapse collapse show" data-bs-parent="#cancellationAccordion">
                                    <div class="accordion-body">
                                        Отменить бронирование можно в личном кабинете в разделе "Мои заказы" или обратившись в службу поддержки. Сроки и условия возврата зависят от тарифа.
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cancellation2">
                                        Вернут ли мне деньги при отмене?
                                    </button>
                                </h2>
                                <div id="cancellation2" class="accordion-collapse collapse" data-bs-parent="#cancellationAccordion">
                                    <div class="accordion-body">
                                        Возврат зависит от типа билета и времени отмены. Невозвратные тарифы не подлежат возврату. Возвратные тарифы возвращаются за вычетом штрафа.
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cancellation3">
                                        Сколько времени занимает возврат денег?
                                    </button>
                                </h2>
                                <div id="cancellation3" class="accordion-collapse collapse" data-bs-parent="#cancellationAccordion">
                                    <div class="accordion-body">
                                        Возврат средств занимает от 3 до 10 рабочих дней в зависимости от банка-эмитента вашей карты.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Отели -->
                    <section id="hotels" class="mb-5">
                        <h3 style="font-family: 'Nunito', sans-serif; color: #0379D9;">
                            <i class="fas fa-hotel me-2"></i>Отели
                        </h3>
                        <div class="accordion mt-3" id="hotelsAccordion">
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#hotels1">
                                        Как забронировать отель?
                                    </button>
                                </h2>
                                <div id="hotels1" class="accordion-collapse collapse show" data-bs-parent="#hotelsAccordion">
                                    <div class="accordion-body">
                                        Выберите город, даты заезда и выезда, количество гостей. Система покажет доступные отели с ценами. После выбора отеля заполните данные гостей и произведите оплату.
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#hotels2">
                                        Можно ли изменить даты проживания?
                                    </button>
                                </h2>
                                <div id="hotels2" class="accordion-collapse collapse" data-bs-parent="#hotelsAccordion">
                                    <div class="accordion-body">
                                        Изменение дат возможно при условии доступности номеров и согласия отеля. Для изменения обратитесь в службу поддержки.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Документы -->
                    <section id="documents" class="mb-5">
                        <h3 style="font-family: 'Nunito', sans-serif; color: #0379D9;">
                            <i class="fas fa-file-alt me-2"></i>Документы
                        </h3>
                        <div class="accordion mt-3" id="documentsAccordion">
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#documents1">
                                        Какие документы нужны для поездки?
                                    </button>
                                </h2>
                                <div id="documents1" class="accordion-collapse collapse show" data-bs-parent="#documentsAccordion">
                                    <div class="accordion-body">
                                        Для поездки по России необходим паспорт гражданина РФ или загранпаспорт. Для детей - свидетельство о рождении.
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#documents2">
                                        Что делать, если потерял электронный билет?
                                    </button>
                                </h2>
                                <div id="documents2" class="accordion-collapse collapse" data-bs-parent="#documentsAccordion">
                                    <div class="accordion-body">
                                        Электронный билет можно повторно скачать в личном кабинете или запросить отправку на email через службу поддержки.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Техподдержка -->
                    <section id="technical" class="mb-5">
                        <h3 style="font-family: 'Nunito', sans-serif; color: #0379D9;">
                            <i class="fas fa-cog me-2"></i>Техподдержка
                        </h3>
                        <div class="accordion mt-3" id="technicalAccordion">
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#technical1">
                                        Как связаться со службой поддержки?
                                    </button>
                                </h2>
                                <div id="technical1" class="accordion-collapse collapse show" data-bs-parent="#technicalAccordion">
                                    <div class="accordion-body">
                                        Вы можете написать нам через форму обратной связи, позвонить по телефону или написать на email. Контакты указаны ниже.
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#technical2">
                                        В какое время работает поддержка?
                                    </button>
                                </h2>
                                <div id="technical2" class="accordion-collapse collapse" data-bs-parent="#technicalAccordion">
                                    <div class="accordion-body">
                                        Служба поддержки работает круглосуточно 7 дней в неделю.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Безопасность -->
                    <section id="safety" class="mb-5">
                        <h3 style="font-family: 'Nunito', sans-serif; color: #0379D9;">
                            <i class="fas fa-shield-alt me-2"></i>Безопасность
                        </h3>
                        <div class="accordion mt-3" id="safetyAccordion">
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#safety1">
                                        Как защищены мои данные?
                                    </button>
                                </h2>
                                <div id="safety1" class="accordion-collapse collapse show" data-bs-parent="#safetyAccordion">
                                    <div class="accordion-body">
                                        Все персональные данные защищены SSL-шифрованием. Мы соблюдаем Федеральный закон №152-ФЗ "О персональных данных".
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Экстренная помощь -->
                    <div class="alert alert-warning mt-4">
                        <h5><i class="fas fa-life-ring me-2"></i>Не нашли ответ?</h5>
                        <p class="mb-2">Обратитесь в нашу службу поддержки:</p>
                        <a asp-controller="Home" asp-action="Contact" class="btn btn-primary btn-sm me-2">
                            <i class="fas fa-envelope me-1"></i>Написать нам
                        </a>
                        <a href="tel:+78001234567" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-phone me-1"></i>8 (800) 123-45-67
                        </a>
                        <a href="mailto:support@tripwise.ru" class="btn btn-outline-primary btn-sm ms-2">
                            <i class="fas fa-at me-1"></i>support@tripwise.ru
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .help-category {
        transition: all 0.3s ease;
        border: 1px solid #e9ecef;
    }

        .help-category:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            border-color: #0379D9;
        }

    .accordion-button:not(.collapsed) {
        background-color: #e3f2fd;
        color: #0379D9;
    }
</style>