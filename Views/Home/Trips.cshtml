@section Scripts {
    <script src="~/js/friends.js"></script>
    <script>
        // Глобальные переменные
        let currentUserId = @Json.Serialize(userId);
        let allTrips = [];
        let deleteTripModal = null;
        let editTripModal = null;
        let searchTerm = '';
        let searchTimeout = null;
                let manageParticipantsModal = null;

        let sortSettings = {
            upcoming: { type: 'date', order: 'asc' },
            completed: { type: 'date', order: 'asc' }
        };

                // Инициализация при загрузке страницы
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Trips page loaded');

            if (currentUserId) {
                // Загружаем поездки и друзей
                loadTrips();
                loadFriendsForInvite();

                // Инициализируем модальное окно удаления
                const modalElement = document.getElementById('deleteTripModal');
                if (modalElement) {
                    deleteTripModal = new bootstrap.Modal(modalElement);
                    modalElement.addEventListener('hidden.bs.modal', function() {
                        resetDeleteModal();
                    });
                }

                // Инициализируем модальное окно участников
                const manageModalElement = document.getElementById('manageParticipantsModal');
                if (manageModalElement) {
                    manageParticipantsModal = new bootstrap.Modal(manageModalElement);
                }

                // Инициализируем модальное окно редактирования
                const editModalElement = document.getElementById('editTripModal');
                if (editModalElement) {
                    editTripModal = new bootstrap.Modal(editModalElement);
                }

                // Инициализируем поиск
                const searchInput = document.getElementById('searchTrips');
                const clearButton = document.getElementById('clearSearch');

                if (searchInput) {
                    searchInput.addEventListener('input', handleSearchInput);
                    searchInput.addEventListener('keydown', handleSearchKeyPress);
                }

                if (clearButton) {
                    clearButton.addEventListener('click', clearSearch);
                }

                // Добавляем обработчики для сортировки
                initSortHandlers();
            }
        });

        // Инициализация обработчиков сортировки
        function initSortHandlers() {
            document.querySelectorAll('.sort-option').forEach(option => {
                option.addEventListener('click', function(e) {
                    e.preventDefault();

                    const sortValue = this.dataset.sort;
                    const section = this.dataset.section;
                    const [type, order] = sortValue.split('-');

                    console.log('Sort clicked:', { type, order, section });

                    // Обновляем настройки сортировки
                    sortSettings[section] = { type, order };

                    // Применяем сортировку с учетом текущего поиска
                    renderFilteredTrips();

                    // Обновляем текст кнопки
                    updateSortButtonsText();

                    // Показываем уведомление
                    const typeText = {
                        'date': 'дате',
                        'name': 'названию',
                        'budget': 'бюджету',
                        'duration': 'длительности'
                    }[type];

                    const orderText = {
                        'asc': {
                            'date': 'сначала ранние',
