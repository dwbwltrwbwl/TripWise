@{
    ViewData["Title"] = "Мои поездки";
    var userId = Context.Session.GetInt32("UserId");
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Заголовок страницы с выделением -->
            <div class="page-header-section mb-5">
                <div class="page-header-icon">
                    <i class="fas fa-suitcase"></i>
                </div>
                <div>
                    <h1 class="page-title">
                        Мои поездки
                    </h1>
                    <p class="page-subtitle">Управляйте вашими запланированными и завершенными путешествиями</p>
                </div>
            </div>

            @if (userId == null)
            {
                <!-- Секция для неавторизованных пользователей -->
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-5 text-center">
                                <div class="mb-4">
                                    <i class="fas fa-suitcase-rolling text-primary" style="font-size: 4rem;"></i>
                                </div>
                                <h3 class="fw-bold mb-3">Войдите в аккаунт</h3>
                                <p class="text-muted mb-4">
                                    Чтобы просматривать и создавать поездки, войдите в свой аккаунт или зарегистрируйтесь.
                                </p>
                                <div class="d-flex flex-column flex-md-row justify-content-center gap-3">
                                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-5">
                                        <i class="fas fa-sign-in-alt me-2"></i>Войти
                                    </a>
                                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg px-5">
                                        <i class="fas fa-user-plus me-2"></i>Зарегистрироваться
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Основной контент для авторизованных пользователей -->
                <div class="row">
                    <div class="col-12">
                        <!-- Заголовок и кнопка создания -->
                        <div class="d-flex justify-content-between align-items-center mb-5">
                            <div class="d-flex gap-3 flex-grow-1 me-3">
                                <div class="input-group" style="max-width: 400px;">
                                    <span class="input-group-text bg-white border-end-0">
                                        <i class="fas fa-search text-muted"></i>
                                    </span>
                                    <input type="text"
                                           class="form-control border-start-0 ps-0"
                                           id="searchTrips"
                                           placeholder="Поиск по названию или описанию..."
                                           autocomplete="off">
                                    <button class="btn btn-outline-secondary" type="button" id="clearSearch" style="display: none;">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>
                            <button class="btn btn-primary btn-lg px-4" data-bs-toggle="modal" data-bs-target="#createTripModal">
                                <i class="fas fa-plus me-2"></i>Новая поездка
                            </button>
                        </div>

                        <!-- ВСТАВЬТЕ БЛОК С ПРИГЛАШЕНИЯМИ ЗДЕСЬ -->
                        <!-- Приглашения в поездки -->
                        <div class="mb-5" id="invitationsSection">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h3 class="section-subtitle">
                                    <i class="fas fa-envelope text-warning me-2"></i>
                                    Приглашения в поездки
                                </h3>
                                <button class="btn btn-sm btn-outline-primary" onclick="loadInvitations()">
                                    <i class="fas fa-sync me-1"></i>Обновить
                                </button>
                            </div>
                            <div id="invitationsContainer">
                                <div class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Загрузка...</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Предстоящие поездки -->
                        <div class="mb-5" id="upcomingTripsSection">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h3 class="section-subtitle">
                                    <i class="fas fa-calendar-alt text-primary me-2"></i>
                                    Предстоящие поездки
                                </h3>
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-sort me-1"></i> Сортировка
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><h6 class="dropdown-header">По дате</h6></li>
                                        <li><a class="dropdown-item sort-option" href="#" data-sort="date-asc" data-section="upcoming">Сначала ранние</a></li>
                                        <li><a class="dropdown-item sort-option" href="#" data-sort="date-desc" data-section="upcoming">Сначала поздние</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">По названию</h6></li>
                                        <li><a class="dropdown-item sort-option" href="#" data-sort="name-asc" data-section="upcoming">От А до Я</a></li>
                                        <li><a class="dropdown-item sort-option" href="#" data-sort="name-desc" data-section="upcoming">От Я до А</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">По бюджету</h6></li>
                                        <li><a class="dropdown-item sort-option" href="#" data-sort="budget-asc" data-section="upcoming">Сначала дорогие</a></li>
                                        <li><a class="dropdown-item sort-option" href="#" data-sort="budget-desc" data-section="upcoming">Сначала бюджетные</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">По длительности</h6></li>
                                        <li><a class="dropdown-item sort-option" href="#" data-sort="duration-asc" data-section="upcoming">Сначала короткие</a></li>
                                        <li><a class="dropdown-item sort-option" href="#" data-sort="duration-desc" data-section="upcoming">Сначала длинные</a></li>
                                    </ul>
                                </div>
                            </div>

                            <div id="upcomingTripsContainer">
                                <div class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Загрузка...</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Завершенные поездки -->
                        <div class="mb-5" id="completedTripsSection">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h3 class="section-subtitle">
                                    <i class="fas fa-history text-primary me-2"></i>
                                    Завершенные поездки
                                </h3>
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-sort me-1"></i> Сортировка
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><h6 class="dropdown-header">По дате</h6></li>
                                        <li><a class="dropdown-item sort-option" href="#" data-sort="date-asc" data-section="completed">Сначала ранние</a></li>
                                        <li><a class="dropdown-item sort-option" href="#" data-sort="date-desc" data-section="completed">Сначала поздние</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">По названию</h6></li>
                                        <li><a class="dropdown-item sort-option" href="#" data-sort="name-asc" data-section="completed">От А до Я</a></li>
                                        <li><a class="dropdown-item sort-option" href="#" data-sort="name-desc" data-section="completed">От Я до А</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">По бюджету</h6></li>
                                        <li><a class="dropdown-item sort-option" href="#" data-sort="budget-asc" data-section="completed">Сначала дорогие</a></li>
                                        <li><a class="dropdown-item sort-option" href="#" data-sort="budget-desc" data-section="completed">Сначала бюджетные</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">По длительности</h6></li>
                                        <li><a class="dropdown-item sort-option" href="#" data-sort="duration-asc" data-section="completed">Сначала короткие</a></li>
                                        <li><a class="dropdown-item sort-option" href="#" data-sort="duration-desc" data-section="completed">Сначала длинные</a></li>
                                    </ul>
                                </div>
                            </div>

                            <div id="completedTripsContainer">
                                <div class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Загрузка...</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Модальное окно создания поездки -->
                <div class="modal fade" id="createTripModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header border-0">
                                <h5 class="modal-title fw-bold">
                                    <i class="fas fa-plus-circle text-primary me-2"></i>
                                    Создать новую поездку
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <form id="createTripForm" onsubmit="createTrip(event)">
                                    <div class="row mb-3">
                                        <div class="col-md-12">
                                            <div class="form-floating">
                                                <input type="text" class="form-control" id="tripName" placeholder="Название поездки" required>
                                                <label for="tripName">Название поездки</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-floating mb-3">
                                        <textarea class="form-control" id="tripDescription" placeholder="Описание поездки" style="height: 100px;"></textarea>
                                        <label for="tripDescription">Описание (необязательно)</label>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="date" class="form-control" id="startDate" required>
                                                <label for="startDate">Дата начала</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="date" class="form-control" id="endDate" required>
                                                <label for="endDate">Дата окончания</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-floating mb-3">
                                        <input type="number" class="form-control" id="totalBudget" placeholder="Бюджет" min="0" step="0.01" value="0">
                                        <label for="totalBudget">Бюджет (₽)</label>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-bold">Пригласить друзей</label>
                                        <div id="friendsForInvite" class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
                                            <div class="text-muted text-center py-3">
                                                <i class="fas fa-spinner fa-spin me-2"></i>Загрузка друзей...
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" id="isPublic" checked>
                                        <label class="form-check-label" for="isPublic">
                                            Создать общий чат для поездки
                                        </label>
                                    </div>
                                </form>
                            </div>
                            <div class="modal-footer border-0">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                                <button type="button" class="btn btn-primary px-4" onclick="createTrip(event)">
                                    <i class="fas fa-check me-2"></i>Создать поездку
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Модальное окно приглашения друзей -->
                <div class="modal fade" id="inviteFriendsModal" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header border-0">
                                <h5 class="modal-title fw-bold">
                                    <i class="fas fa-user-plus text-primary me-2"></i>
                                    Пригласить друзей
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <input type="hidden" id="inviteTripId">
                                <div id="inviteFriendsList" class="mb-3" style="max-height: 300px; overflow-y: auto;">
                                    <!-- Загружается динамически -->
                                </div>
                            </div>
                            <div class="modal-footer border-0">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Закрыть</button>
                                <button type="button" class="btn btn-primary" onclick="sendInvites()">
                                    <i class="fas fa-paper-plane me-2"></i>Отправить приглашения
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Модальное окно подтверждения удаления поездки -->
                <div class="modal fade" id="deleteTripModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header border-0">
                                <h5 class="modal-title fw-bold text-danger">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    Удаление поездки
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <input type="hidden" id="deleteTripId">
                                <input type="hidden" id="deleteTripHasChat">

                                <!-- Шаг 1: Подтверждение удаления -->
                                <div id="deleteStep1">
                                    <div class="text-center mb-4">
                                        <i class="fas fa-trash-alt text-danger fa-4x mb-3"></i>
                                        <h5 id="deleteTripTitle" class="fw-bold"></h5>
                                    </div>
                                    <p class="text-center mb-4">
                                        Вы уверены, что хотите удалить эту поездку?<br>
                                        <small class="text-muted">Это действие нельзя будет отменить.</small>
                                    </p>
                                </div>

                                <!-- Шаг 2: Выбор удаления чата (показывается только если есть чат) -->
                                <div id="deleteStep2" style="display: none;">
                                    <div class="text-center mb-4">
                                        <i class="fas fa-comments text-primary fa-4x mb-3"></i>
                                        <h5 class="fw-bold">Что делать с чатом?</h5>
                                    </div>
                                    <p class="text-center mb-4">
                                        У этой поездки есть общий чат. Вы можете удалить его вместе с поездкой или оставить.
                                    </p>

                                    <div class="d-flex flex-column gap-3">
                                        <div class="form-check p-3 border rounded hover-bg-light" onclick="document.getElementById('deleteChatYes').checked = true">
                                            <input class="form-check-input" type="radio" name="deleteChatOption" id="deleteChatYes" value="yes" checked>
                                            <label class="form-check-label w-100" for="deleteChatYes">
                                                <div class="d-flex align-items-center">
                                                    <div class="me-3">
                                                        <i class="fas fa-trash-alt text-danger fa-lg"></i>
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold">Удалить чат</div>
                                                        <small class="text-muted">Все сообщения в чате будут безвозвратно удалены</small>
                                                    </div>
                                                </div>
                                            </label>
                                        </div>

                                        <div class="form-check p-3 border rounded hover-bg-light" onclick="document.getElementById('deleteChatNo').checked = true">
                                            <input class="form-check-input" type="radio" name="deleteChatOption" id="deleteChatNo" value="no">
                                            <label class="form-check-label w-100" for="deleteChatNo">
                                                <div class="d-flex align-items-center">
                                                    <div class="me-3">
                                                        <i class="fas fa-comments text-success fa-lg"></i>
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold">Оставить чат</div>
                                                        <small class="text-muted">Чат останется доступным для участников</small>
                                                    </div>
                                                </div>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer border-0">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>

                                <!-- Кнопки для шага 1 -->
                                <button type="button" class="btn btn-danger" id="deleteStep1Btn" onclick="proceedToStep2()">
                                    <i class="fas fa-trash-alt me-2"></i>Удалить
                                </button>

                                <!-- Кнопки для шага 2 (скрыты по умолчанию) -->
                                <div id="deleteStep2Btns" style="display: none;">
                                    <button type="button" class="btn btn-outline-secondary" onclick="backToStep1()">
                                        <i class="fas fa-arrow-left me-2"></i>Назад
                                    </button>
                                    <button type="button" class="btn btn-danger" onclick="deleteTripWithOption()">
                                        <i class="fas fa-trash-alt me-2"></i>Подтвердить
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Модальное окно редактирования поездки -->
                <div class="modal fade" id="editTripModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header border-0">
                                <h5 class="modal-title fw-bold">
                                    <i class="fas fa-edit text-primary me-2"></i>
                                    Редактировать поездку
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <form id="editTripForm" onsubmit="updateTrip(event)">
                                    <input type="hidden" id="editTripId">

                                    <div class="row mb-3">
                                        <div class="col-md-12">
                                            <div class="form-floating">
                                                <input type="text" class="form-control" id="editTripName" placeholder="Название поездки" required>
                                                <label for="editTripName">Название поездки</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-floating mb-3">
                                        <textarea class="form-control" id="editTripDescription" placeholder="Описание поездки" style="height: 100px;"></textarea>
                                        <label for="editTripDescription">Описание (необязательно)</label>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="date" class="form-control" id="editStartDate" required>
                                                <label for="editStartDate">Дата начала</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="date" class="form-control" id="editEndDate" required>
                                                <label for="editEndDate">Дата окончания</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-floating mb-3">
                                        <input type="number" class="form-control" id="editTotalBudget" placeholder="Бюджет" min="0" step="0.01" value="0">
                                        <label for="editTotalBudget">Бюджет (₽)</label>
                                    </div>

                                    <div class="form-check form-switch mb-3" id="editPublicSwitch" style="display: none;">
                                        <input class="form-check-input" type="checkbox" id="editIsPublic">
                                        <label class="form-check-label" for="editIsPublic">
                                            Общий чат для поездки
                                        </label>
                                    </div>

                                    <div class="alert alert-info" id="editChatInfo" style="display: none;">
                                        <i class="fas fa-info-circle me-2"></i>
                                        <span id="editChatInfoText"></span>
                                    </div>
                                </form>
                            </div>
                            <div class="modal-footer border-0">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                                <button type="button" class="btn btn-primary px-4" onclick="updateTrip(event)">
                                    <i class="fas fa-save me-2"></i>Сохранить изменения
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Модальное окно управления участниками -->
                <div class="modal fade" id="manageParticipantsModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header border-0">
                                <h5 class="modal-title fw-bold">
                                    <i class="fas fa-users text-primary me-2"></i>
                                    Участники поездки
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <input type="hidden" id="manageParticipantsTripId">
                                <div id="participantsList" style="max-height: 400px; overflow-y: auto;">
                                    <div class="text-center py-4">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Загрузка...</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer border-0">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Закрыть</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Стили для выделения раздела "Мои поездки" */
    .page-header-section {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 25px 30px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
    }

        .page-header-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 6px;
            height: 100%;
            background: linear-gradient(to bottom, #0379D9, #40B624);
        }

    .page-header-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #0379D9, #40B624);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        box-shadow: 0 4px 15px rgba(3, 121, 217, 0.2);
        flex-shrink: 0;
    }

    .page-title {
        font-family: 'Nunito', sans-serif;
        font-weight: 800;
