</style>

@section Scripts {
    <script src="~/js/friends.js"></script>
    <script>
        // Глобальные переменные
        let currentUserId = @Json.Serialize(userId);
        let allTrips = [];
        let deleteTripModal = null;

        // Инициализация при загрузке страницы
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Trips page loaded');

            if (currentUserId) {
                // Загружаем поездки и друзей
                loadTrips();
                loadFriendsForInvite();

                // Инициализируем модальное окно удаления
                const modalElement = document.getElementById('deleteTripModal');
                if (modalElement) {
                    deleteTripModal = new bootstrap.Modal(modalElement);

                    // Сбрасываем состояние при закрытии
                    modalElement.addEventListener('hidden.bs.modal', function() {
                        resetDeleteModal();
                    });
                }

                // Добавляем обработчики для сортировки
                        // В обработчике клика
        document.querySelectorAll('.sort-option').forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();

                const sortValue = this.dataset.sort;
                const section = this.dataset.section;

                const [type, order] = sortValue.split('-');

                console.log('Sort clicked:', { type, order, section });

                // Обновляем настройки сортировки
                sortSettings[section] = { type, order };

                // Фильтруем поездки по статусу из allTrips
                const now = new Date();
                let filteredTrips;

                if (section === 'upcoming') {
                    filteredTrips = allTrips.filter(trip => {
                        const endDate = new Date(trip.endDate);
                        return endDate >= now;
                    });
                } else {
                    filteredTrips = allTrips.filter(trip => {
                        const endDate = new Date(trip.endDate);
                        return endDate < now;
                    });
                }

                // Применяем сортировку
                const sortedTrips = sortTrips(filteredTrips, type, order);

                // Отображаем
                renderTrips(sortedTrips, section);

                // Обновляем текст кнопки
                updateSortButtonsText();

                // Показываем уведомление
                const typeText = {
                    'date': 'дате',
                    'name': 'названию',
                    'budget': 'бюджету',
                    'duration': 'длительности'
                }[type];

                const orderText = {
                    'asc': {
                        'date': 'сначала новые',
                        'name': 'А-Я',
                        'budget': 'сначала дорогие',
                        'duration': 'сначала короткие'
                    },
                    'desc': {
                        'date': 'сначала старые',
                        'name': 'Я-А',
                        'budget': 'сначала бюджетные',
                        'duration': 'сначала длинные'
                    }
                }[order][type];

                showNotification(`Поездки отсортированы по ${typeText} (${orderText})`, 'success');
            });
        });

                // Добавляем обработчик для поиска (если есть)
                const searchInput = document.getElementById('searchTrips');
                if (searchInput) {
                    let searchTimeout;
                    searchInput.addEventListener('input', function() {
                        clearTimeout(searchTimeout);
                        searchTimeout = setTimeout(() => {
                            filterTrips(this.value);
                        }, 300);
                    });
                }
            } else {
                console.log('User not logged in');
            }
        });

        // Функция для сброса состояния модального окна
        function resetDeleteModal() {
            document.getElementById('deleteStep1').style.display = 'block';
            document.getElementById('deleteStep2').style.display = 'none';
            document.getElementById('deleteStep1Btn').style.display = 'inline-block';
            document.getElementById('deleteStep2Btns').style.display = 'none';

            // Сбрасываем радио-кнопки
            document.getElementById('deleteChatYes').checked = true;
        }

                // Обновленная функция loadTrips
        async function loadTrips() {
            try {
                const response = await fetch('/Trips/GetUserTrips');
                const data = await response.json();

                if (data.success) {
                    allTrips = data.data.all || [];

                    // Получаем предстоящие и завершенные поездки из всех поездок, а не из data.data
                    const now = new Date();
                    const upcoming = allTrips.filter(trip => {
                        const endDate = new Date(trip.endDate);
                        return endDate >= now; // поездки, которые еще не закончились
                    });

                    const completed = allTrips.filter(trip => {
                        const endDate = new Date(trip.endDate);
                        return endDate < now; // поездки, которые уже закончились
                    });

                    console.log('Before sorting - upcoming:', upcoming.map(t => ({ title: t.title, date: t.startDate })));
                    console.log('Before sorting - completed:', completed.map(t => ({ title: t.title, date: t.startDate })));

                    // Применяем сортировку к каждой секции
                    const sortedUpcoming = sortTrips(upcoming, sortSettings.upcoming.type, sortSettings.upcoming.order);
                    const sortedCompleted = sortTrips(completed, sortSettings.completed.type, sortSettings.completed.order);

                    console.log('After sorting - upcoming:', sortedUpcoming.map(t => ({ title: t.title, date: t.startDate })));
                    console.log('After sorting - completed:', sortedCompleted.map(t => ({ title: t.title, date: t.startDate })));

                    // Отображаем отсортированные поездки
                    renderTrips(sortedUpcoming, 'upcoming');
                    renderTrips(sortedCompleted, 'completed');

                    // Обновляем текст кнопок сортировки
                    updateSortButtonsText();
                } else {
                    showNotification(data.message || 'Ошибка загрузки поездок', 'danger');
                }
            } catch (error) {
                console.error('Error loading trips:', error);
                showNotification('Не удалось загрузить поездки', 'danger');
            }
        }
                function updateSortButtonsText() {
            const getSortText = (settings) => {
                const typeMap = {
                    'date': 'дате',
                    'name': 'названию',
                    'budget': 'бюджету',
                    'duration': 'длительности'
                };
                const orderMap = {
                    'asc': {
                        'date': 'сначала новые',
                        'name': 'А-Я',
                        'budget': 'сначала дорогие',
                        'duration': 'сначала короткие'
                    },
                    'desc': {
                        'date': 'сначала старые',
                        'name': 'Я-А',
                        'budget': 'сначала бюджетные',
                        'duration': 'сначала длинные'
                    }
                };

                return `${orderMap[settings.order][settings.type]}`;
            };

            // Обновляем кнопки для каждой секции
            const upcomingBtn = document.querySelector('#upcomingTripsSection .dropdown-toggle');
            const completedBtn = document.querySelector('#completedTripsSection .dropdown-toggle');

            if (upcomingBtn) {
                upcomingBtn.innerHTML = `<i class="fas fa-sort me-1"></i> ${getSortText(sortSettings.upcoming)}`;
            }
            if (completedBtn) {
                completedBtn.innerHTML = `<i class="fas fa-sort me-1"></i> ${getSortText(sortSettings.completed)}`;
            }
        }
        // Отображение поездок
        function renderTrips(trips, type) {
            const container = document.getElementById(`${type}TripsContainer`);
            const section = document.getElementById(`${type}TripsSection`);

            if (!container) return;

            if (trips.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-${type === 'upcoming' ? 'calendar-times' : 'suitcase'}"></i>
                        <h5>Нет ${type === 'upcoming' ? 'предстоящих' : 'завершенных'} поездок</h5>
                        <p>${type === 'upcoming' ? 'Создайте новую поездку, чтобы начать планирование' : 'Завершенные поездки появятся здесь'}</p>
                        ${type === 'upcoming' ? `
                            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createTripModal">
                                <i class="fas fa-plus me-2"></i>Создать поездку
                            </button>
                        ` : ''}
                    </div>
                `;
                return;
            }

            let html = '<div class="row g-4">';

            trips.forEach(trip => {
                const startDate = new Date(trip.startDate).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long' });
                const endDate = new Date(trip.endDate).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
                const budgetPercent = trip.totalBudget > 0 ? Math.round((trip.spentBudget / trip.totalBudget) * 100) : 0;

                html += `
                    <div class="col-md-6 col-lg-4">
                        <div class="trip-card ${trip.status}">
                            <div class="card-body">
                                <div class="trip-status ${trip.status}">
                                    ${trip.status === 'upcoming' ? 'Предстоит' : trip.status === 'active' ? 'В процессе' : 'Завершена'}
                                </div>

                                <h3 class="trip-title">${escapeHtml(trip.title)}</h3>

                                <div class="trip-dates">
                                    <div><i class="far fa-calendar-alt me-2"></i>${startDate} — ${endDate}</div>
                                    <div class="mt-1"><i class="far fa-clock me-2"></i>${trip.duration} ${getDaysWord(trip.duration)}</div>
                                </div>

                                <div class="trip-budget">
                                    <div class="budget-item">
                                        <span>Бюджет:</span>
                                        <span class="fw-bold">${formatMoney(trip.totalBudget)} ₽</span>
                                    </div>
                                    <div class="budget-item">
                                        <span>Потрачено:</span>
                                        <span class="fw-bold text-${trip.spentBudget > trip.totalBudget ? 'danger' : 'success'}">${formatMoney(trip.spentBudget)} ₽</span>
                                    </div>
                                    ${trip.totalBudget > 0 ? `
                                        <div class="progress mt-2" style="height: 6px;">
                                            <div class="progress-bar ${trip.spentBudget > trip.totalBudget ? 'bg-danger' : 'bg-success'}"
                                                 style="width: ${Math.min(budgetPercent, 100)}%"></div>
                                        </div>
                                    ` : ''}
                                </div>

                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="participant-avatars">
                                        ${trip.participants.slice(0, 5).map(p => `
                                            <div class="participant-avatar position-relative" title="${escapeHtml(p.fullName)}">
                                                ${p.avatarPath ?
                                                    `<img src="${p.avatarPath}" alt="${escapeHtml(p.fullName)}">` :
                                                    `<span>${getInitials(p.fullName)}</span>`
                                                }
                                                ${p.isFriend ? '<span class="friend-badge"><i class="fas fa-check"></i></span>' : ''}
                                            </div>
                                        `).join('')}
                                        ${trip.participantCount > 5 ?
                                            `<span class="participant-count">+${trip.participantCount - 5}</span>` :
                                            ''}
                                    </div>
                                    <span class="text-muted small">
                                        <i class="fas fa-map-marker-alt me-1"></i>${trip.pointsCount} мест
                                    </span>
                                </div>
                            </div>

                            <div class="card-footer">
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        <i class="fas fa-user me-1"></i>${escapeHtml(trip.createdBy.fullName)}
                                    </small>
                                    <div class="btn-group">
                                        ${trip.hasChat ? `
                                            <button class="btn btn-sm btn-outline-primary" onclick="goToTripChat(${trip.chatId})" title="Чат поездки">
                                                <i class="fas fa-comments"></i>
                                            </button>
                                        ` : ''}
                                        <button class="btn btn-sm btn-outline-secondary" onclick="viewTripDetails(${trip.id})" title="Подробнее">
                                            <i class="fas fa-info-circle"></i>
                                        </button>
                                        ${trip.createdBy.id === currentUserId ? `
                                            ${trip.status !== 'completed' ? `
                                                <button class="btn btn-sm btn-outline-success" onclick="openInviteModal(${trip.id})" title="Пригласить друзей">
                                                    <i class="fas fa-user-plus"></i>
                                                </button>
                                            ` : ''}
                                            <button class="btn btn-sm btn-outline-danger" onclick="confirmDeleteTrip(${trip.id}, '${escapeHtml(trip.title)}', ${trip.hasChat})" title="Удалить поездку">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        ` : ''}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });

            html += '</div>';
            container.innerHTML = html;
        }

        // Загрузка друзей для приглашения
        async function loadFriendsForInvite() {
            try {
                const response = await fetch('/api/friends/GetFriends');
                const data = await response.json();

                if (data.success) {
                    const container = document.getElementById('friendsForInvite');

                    if (!data.data || data.data.length === 0) {
                        container.innerHTML = `
                            <div class="text-center text-muted py-3">
                                <i class="fas fa-user-friends fa-2x mb-2 opacity-50"></i>
                                <p>У вас пока нет друзей для приглашения</p>
                                <small>Найдите друзей через поиск на странице чатов</small>
                            </div>
                        `;
                        return;
                    }

                    let html = '';
                    data.data.forEach(friend => {
                        html += `
                            <div class="friend-checkbox">
                                <input class="form-check-input" type="checkbox" value="${friend.friendId}" id="friend_${friend.friendId}">
                                <label class="form-check-label d-flex align-items-center flex-grow-1" for="friend_${friend.friendId}">
                                    <div class="me-2">
                                        ${friend.avatarPath ?
                                            `<img src="${friend.avatarPath}" class="rounded-circle" width="32" height="32" style="object-fit: cover;">` :
                                            `<div class="avatar-circle-sm bg-primary" style="width:32px;height:32px; font-size:12px;">${getInitials(friend.fullName)}</div>`
                                        }
                                    </div>
                                    <div>
                                        <div class="fw-bold">${escapeHtml(friend.fullName)}</div>
                                        <small class="text-muted">${escapeHtml(friend.email)}</small>
                                    </div>
                                </label>
                            </div>
                        `;
                    });

                    container.innerHTML = html;
                }
            } catch (error) {
                console.error('Error loading friends for invite:', error);
            }
        }

        // Создание поездки
        async function createTrip(event) {
            event.preventDefault();

            const title = document.getElementById('tripName').value;
            const description = document.getElementById('tripDescription').value;
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            const totalBudget = parseFloat(document.getElementById('totalBudget').value) || 0;
            const isPublic = document.getElementById('isPublic').checked;

            // Собираем выбранных друзей
            const invitedFriends = [];
            document.querySelectorAll('#friendsForInvite input:checked').forEach(cb => {
                invitedFriends.push(parseInt(cb.value));
            });

            if (!title || !startDate || !endDate) {
                showNotification('Заполните все обязательные поля', 'warning');
                return;
            }

            if (new Date(endDate) <= new Date(startDate)) {
                showNotification('Дата окончания должна быть позже даты начала', 'warning');
                return;
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Trips/CreateTrip', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        title: title,
                        description: description,
                        startDate: new Date(startDate).toISOString(),
                        endDate: new Date(endDate).toISOString(),
                        totalBudget: totalBudget,
                        isPublic: isPublic,
                        invitedFriends: invitedFriends
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showNotification('Поездка успешно создана!', 'success');

                    // Закрываем модальное окно
                    const modal = bootstrap.Modal.getInstance(document.getElementById('createTripModal'));
                    modal.hide();

                    // Сбрасываем форму
                    document.getElementById('createTripForm').reset();

                    // Перезагружаем поездки
                    await loadTrips();
                } else {
                    showNotification(data.message || 'Ошибка при создании поездки', 'danger');
                }
            } catch (error) {
                console.error('Error creating trip:', error);
                showNotification('Не удалось создать поездку', 'danger');
            }
        }

        // Открыть модальное окно приглашения друзей
        async function openInviteModal(tripId) {
            document.getElementById('inviteTripId').value = tripId;

            try {
                const response = await fetch(`/Trips/GetFriendsForInvite?tripId=${tripId}`);
                const data = await response.json();

                const container = document.getElementById('inviteFriendsList');

                if (!data.success || !data.data || data.data.length === 0) {
                    container.innerHTML = `
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-user-friends fa-3x mb-3 opacity-50"></i>
                            <p>Нет друзей для приглашения</p>
                        </div>
                    `;
                } else {
                    let html = '';
                    data.data.forEach(friend => {
                        html += `
                            <div class="friend-checkbox">
                                <input class="form-check-input" type="checkbox" value="${friend.friendId}" id="invite_${friend.friendId}">
                                <label class="form-check-label d-flex align-items-center flex-grow-1" for="invite_${friend.friendId}">
                                    <div class="me-2">
                                        ${friend.avatarPath ?
                                            `<img src="${friend.avatarPath}" class="rounded-circle" width="32" height="32" style="object-fit: cover;">` :
                                            `<div class="avatar-circle-sm bg-primary" style="width:32px;height:32px; font-size:12px;">${getInitials(friend.fullName)}</div>`
                                        }
                                    </div>
                                    <div>
                                        <div class="fw-bold">${escapeHtml(friend.fullName)}</div>
                                        <small class="text-muted">${escapeHtml(friend.email)}</small>
                                    </div>
                                </label>
                            </div>
                        `;
                    });
                    container.innerHTML = html;
                }

                const modal = new bootstrap.Modal(document.getElementById('inviteFriendsModal'));
                modal.show();
            } catch (error) {
                console.error('Error loading friends for invite:', error);
                showNotification('Не удалось загрузить друзей', 'danger');
            }
        }

        // Отправить приглашения
        async function sendInvites() {
            const tripId = document.getElementById('inviteTripId').value;

            const friendIds = [];
            document.querySelectorAll('#inviteFriendsList input:checked').forEach(cb => {
                friendIds.push(parseInt(cb.value));
            });

            if (friendIds.length === 0) {
                showNotification('Выберите друзей для приглашения', 'warning');
                return;
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Trips/InviteFriends', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        tripId: parseInt(tripId),
                        friendIds: friendIds
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showNotification('Друзья приглашены в поездку!', 'success');

                    // Закрываем модальное окно
                    const modal = bootstrap.Modal.getInstance(document.getElementById('inviteFriendsModal'));
                    modal.hide();

                    // Перезагружаем поездки
                    await loadTrips();
                } else {
                    showNotification(data.message || 'Ошибка при приглашении', 'danger');
                }
            } catch (error) {
                console.error('Error sending invites:', error);
                showNotification('Не удалось отправить приглашения', 'danger');
            }
        }

        // Перейти в чат поездки
        function goToTripChat(chatId) {
            window.location.href = `/Home/Chats?chatId=${chatId}`;
        }

        // Просмотр деталей поездки
        function viewTripDetails(tripId) {
            showNotification('Функция просмотра деталей в разработке', 'info');
        }

        // Подтверждение удаления поездки
        function confirmDeleteTrip(tripId, tripTitle, hasChat) {
            document.getElementById('deleteTripId').value = tripId;
            document.getElementById('deleteTripHasChat').value = hasChat;
            document.getElementById('deleteTripTitle').textContent = `"${tripTitle}"`;

            if (hasChat) {
                // Если есть чат, показываем первый шаг, но с пониманием, что дальше будет выбор
                document.getElementById('deleteStep1').style.display = 'block';
                document.getElementById('deleteStep2').style.display = 'none';
                document.getElementById('deleteStep1Btn').style.display = 'inline-block';
                document.getElementById('deleteStep2Btns').style.display = 'none';
            } else {
                // Если нет чата, сразу показываем простое подтверждение
                document.getElementById('deleteStep1').style.display = 'block';
                document.getElementById('deleteStep2').style.display = 'none';
                document.getElementById('deleteStep1Btn').style.display = 'inline-block';
                document.getElementById('deleteStep2Btns').style.display = 'none';

                // Меняем текст кнопки
                document.getElementById('deleteStep1Btn').innerHTML = '<i class="fas fa-trash-alt me-2"></i>Удалить поездку';
            }

            deleteTripModal.show();
        }

        // Переход ко второму шагу (выбор удаления чата)
        function proceedToStep2() {
            const hasChat = document.getElementById('deleteTripHasChat').value === 'true';

            if (hasChat) {
                // Если есть чат, показываем второй шаг
                document.getElementById('deleteStep1').style.display = 'none';
                document.getElementById('deleteStep2').style.display = 'block';
                document.getElementById('deleteStep1Btn').style.display = 'none';
                document.getElementById('deleteStep2Btns').style.display = 'inline-block';
            } else {
                // Если нет чата, сразу удаляем
                deleteTripWithOption();
            }
        }

        // Возврат к первому шагу
        function backToStep1() {
            document.getElementById('deleteStep1').style.display = 'block';
            document.getElementById('deleteStep2').style.display = 'none';
            document.getElementById('deleteStep1Btn').style.display = 'inline-block';
            document.getElementById('deleteStep2Btns').style.display = 'none';
        }

        // Удаление поездки с выбранной опцией
        function deleteTripWithOption() {
            const tripId = document.getElementById('deleteTripId').value;
            const deleteChat = document.getElementById('deleteChatYes').checked;

            deleteTrip(tripId, deleteChat);
        }

        // Удаление поездки
        async function deleteTrip(tripId, deleteChat = true) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch(`/Trips/DeleteTrip/${tripId}?deleteChat=${deleteChat}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    }
                });

                const data = await response.json();

                if (data.success) {
                    showNotification('Поездка успешно удалена', 'success');
                    deleteTripModal.hide();
                    await loadTrips(); // Перезагружаем список поездок
                } else {
                    showNotification(data.message || 'Ошибка при удалении поездки', 'danger');
                }
            } catch (error) {
                console.error('Error deleting trip:', error);
                showNotification('Не удалось удалить поездку', 'danger');
            }
        }

        // Получить склонение слова "день"
        function getDaysWord(days) {
            if (days % 10 === 1 && days % 100 !== 11) return 'день';
            if ([2,3,4].includes(days % 10) && ![12,13,14].includes(days % 100)) return 'дня';
            return 'дней';
        }

        // Форматирование денег
        function formatMoney(amount) {
            if (amount === null || amount === undefined) return '0';
            return amount.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
        }

        // Получение инициалов
        function getInitials(fullName) {
            if (!fullName) return '?';
            const parts = fullName.split(' ');
            if (parts.length >= 2) {
                return (parts[0][0] + parts[1][0]).toUpperCase();
            }
            return parts[0][0].toUpperCase();
        }

        // Экранирование HTML
        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Показать уведомление
        function showNotification(message, type = 'info') {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            alertDiv.style.top = '20px';
            alertDiv.style.right = '20px';
            alertDiv.style.zIndex = '9999';
            alertDiv.style.minWidth = '300px';
            alertDiv.style.maxWidth = '400px';
            alertDiv.innerHTML = `
                <div class="d-flex align-items-center">
                    <i class="fas ${type === 'success' ? 'fa-check-circle' :
                                        type === 'danger' ? 'fa-exclamation-circle' :
                                        'fa-info-circle'} me-2"></i>
                    <div class="flex-grow-1">${message}</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;

            document.body.appendChild(alertDiv);

            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.classList.remove('show');
                    setTimeout(() => alertDiv.remove(), 150);
                }
            }, 3000);
        }

                        let sortSettings = {
            upcoming: { type: 'date', order: 'asc' }, // По умолчанию: сначала новые
            completed: { type: 'date', order: 'asc' }
        };

                        // Функция сортировки поездок - ОКОНЧАТЕЛЬНО ИСПРАВЛЕННАЯ
        function sortTrips(trips, sortType, sortOrder) {
            console.log('sortTrips called with:', { sortType, sortOrder, tripsCount: trips.length });

            return [...trips].sort((a, b) => {
                switch(sortType) {
                    case 'date':
                        const dateA = new Date(a.startDate).getTime();
                        const dateB = new Date(b.startDate).getTime();

                        console.log('Comparing dates:', {
                            a: { title: a.title, date: a.startDate, timestamp: dateA },
                            b: { title: b.title, date: b.startDate, timestamp: dateB },
                            sortOrder
                        });

                        if (sortOrder === 'asc') {
                            // Сначала новые: более поздние даты первыми
                            // Для "новые": 29 апреля (dateA=1777410000000) должно быть перед 1 апреля (dateB=1774990800000)
                            // Нужно вернуть отрицательное, когда dateA > dateB
                            console.log('asc result:', dateB - dateA);
                            return dateB - dateA; // Отрицательное когда dateA > dateB ✓
                        } else {
                            // Сначала старые: более ранние даты первыми
                            // Для "старые": 1 апреля (dateA=1774990800000) должно быть перед 29 апреля (dateB=1777410000000)
                            // Нужно вернуть отрицательное, когда dateA < dateB
                            console.log('desc result:', dateA - dateB);
                            return dateA - dateB; // Отрицательное когда dateA < dateB ✓
                        }

                    case 'name':
                        const nameCompare = a.title.localeCompare(b.title, 'ru');
                        return sortOrder === 'asc' ? nameCompare : -nameCompare;

                    case 'budget':
                        if (sortOrder === 'asc') {
                            // Сначала дорогие: от большего к меньшему
                            return b.totalBudget - a.totalBudget;
                        } else {
                            // Сначала бюджетные: от меньшего к большему
                            return a.totalBudget - b.totalBudget;
                        }

                    case 'duration':
                        if (sortOrder === 'asc') {
                            // Сначала короткие: от меньшего к большему
                            return a.duration - b.duration;
                        } else {
                            // Сначала длинные: от большего к меньшему
                            return b.duration - a.duration;
                        }

                    default:
                        return 0;
                }
            });
        }
    </script>
