        // Переход ко второму шагу
        function proceedToStep2() {
            const hasChat = document.getElementById('deleteTripHasChat').value === 'true';

            if (hasChat) {
                document.getElementById('deleteStep1').style.display = 'none';
                document.getElementById('deleteStep2').style.display = 'block';
                document.getElementById('deleteStep1Btn').style.display = 'none';
                document.getElementById('deleteStep2Btns').style.display = 'inline-block';
            } else {
                deleteTripWithOption();
            }
        }

        // Возврат к первому шагу
        function backToStep1() {
            document.getElementById('deleteStep1').style.display = 'block';
            document.getElementById('deleteStep2').style.display = 'none';
            document.getElementById('deleteStep1Btn').style.display = 'inline-block';
            document.getElementById('deleteStep2Btns').style.display = 'none';
        }

        // Удаление поездки с опцией
        function deleteTripWithOption() {
            const tripId = document.getElementById('deleteTripId').value;
            const deleteChat = document.getElementById('deleteChatYes').checked;
            deleteTrip(tripId, deleteChat);
        }

        // Удаление поездки
        async function deleteTrip(tripId, deleteChat = true) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch(`/Trips/DeleteTrip/${tripId}?deleteChat=${deleteChat}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    }
                });

                const data = await response.json();

                if (data.success) {
                    showNotification('Поездка успешно удалена', 'success');
                    deleteTripModal.hide();
                    await loadTrips();
                } else {
                    showNotification(data.message || 'Ошибка при удалении поездки', 'danger');
                }
            } catch (error) {
                console.error('Error deleting trip:', error);
                showNotification('Не удалось удалить поездку', 'danger');
            }
        }

        // Открыть модальное окно редактирования
        async function openEditTripModal(tripId) {
            try {
                const response = await fetch(`/Trips/GetTripForEdit/${tripId}`);
                const data = await response.json();

                if (data.success) {
                    const trip = data.data;

                    document.getElementById('editTripId').value = trip.idTrip;
                    document.getElementById('editTripName').value = trip.title;
                    document.getElementById('editTripDescription').value = trip.description || '';
                    document.getElementById('editStartDate').value = trip.startDate;
                    document.getElementById('editEndDate').value = trip.endDate;
                    document.getElementById('editTotalBudget').value = trip.totalBudget;

                    const chatInfo = document.getElementById('editChatInfo');
                    const publicSwitch = document.getElementById('editPublicSwitch');
                    const isPublicCheckbox = document.getElementById('editIsPublic');

                    if (trip.hasChat) {
                        publicSwitch.style.display = 'block';
                        chatInfo.style.display = 'none';
                        isPublicCheckbox.checked = true;
                    } else {
                        publicSwitch.style.display = 'block';
                        chatInfo.style.display = 'none';
                        isPublicCheckbox.checked = false;
                    }

                    editTripModal.show();
                } else {
                    showNotification(data.message || 'Ошибка загрузки данных', 'danger');
                }
            } catch (error) {
                console.error('Error loading trip for edit:', error);
                showNotification('Не удалось загрузить данные поездки', 'danger');
            }
        }

        // Обновление поездки
        async function updateTrip(event) {
            event.preventDefault();

            const tripId = document.getElementById('editTripId').value;
            const title = document.getElementById('editTripName').value;
            const description = document.getElementById('editTripDescription').value;
            const startDate = document.getElementById('editStartDate').value;
            const endDate = document.getElementById('editEndDate').value;
            const totalBudget = parseFloat(document.getElementById('editTotalBudget').value) || 0;
            const isPublic = document.getElementById('editIsPublic')?.checked || false;

            if (!title || !startDate || !endDate) {
                showNotification('Заполните все обязательные поля', 'warning');
                return;
            }

            if (new Date(endDate) <= new Date(startDate)) {
                showNotification('Дата окончания должна быть позже даты начала', 'warning');
                return;
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Trips/UpdateTrip', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        id: parseInt(tripId),
                        title: title,
                        description: description,
                        startDate: new Date(startDate).toISOString(),
                        endDate: new Date(endDate).toISOString(),
                        totalBudget: totalBudget,
                        isPublic: isPublic
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showNotification('Поездка успешно обновлена!', 'success');
                    editTripModal.hide();
                    await loadTrips();
                } else {
                    showNotification(data.message || 'Ошибка при обновлении поездки', 'danger');
                }
            } catch (error) {
                console.error('Error updating trip:', error);
                showNotification('Не удалось обновить поездку', 'danger');
            }
        }

        // Вспомогательные функции
        function getDaysWord(days) {
            if (days % 10 === 1 && days % 100 !== 11) return 'день';
            if ([2,3,4].includes(days % 10) && ![12,13,14].includes(days % 100)) return 'дня';
            return 'дней';
        }

        function formatMoney(amount) {
            if (amount === null || amount === undefined) return '0';
            return amount.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
        }

        function getInitials(fullName) {
            if (!fullName) return '?';
            const parts = fullName.split(' ');
            if (parts.length >= 2) {
                return (parts[0][0] + parts[1][0]).toUpperCase();
            }
            return parts[0][0].toUpperCase();
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function showNotification(message, type = 'info') {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            alertDiv.style.top = '20px';
            alertDiv.style.right = '20px';
            alertDiv.style.zIndex = '9999';
            alertDiv.style.minWidth = '300px';
            alertDiv.style.maxWidth = '400px';
            alertDiv.innerHTML = `
                <div class="d-flex align-items-center">
                    <i class="fas ${type === 'success' ? 'fa-check-circle' :
                                        type === 'danger' ? 'fa-exclamation-circle' :
                                        'fa-info-circle'} me-2"></i>
                    <div class="flex-grow-1">${message}</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;

            document.body.appendChild(alertDiv);

            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.classList.remove('show');
                    setTimeout(() => alertDiv.remove(), 150);
                }
            }, 3000);
        }
                async function openManageParticipantsModal(tripId) {
            document.getElementById('manageParticipantsTripId').value = tripId;

            try {
                const response = await fetch(`/Trips/GetTripParticipants?tripId=${tripId}`);
                const data = await response.json();

                if (data.success) {
                    renderParticipantsList(data.data.participants, data.data.chatId, tripId);
                    manageParticipantsModal.show();
                } else {
                    showNotification(data.message || 'Ошибка загрузки участников', 'danger');
                }
            } catch (error) {
                console.error('Error loading participants:', error);
                showNotification('Не удалось загрузить участников', 'danger');
            }
        }

        // Отображение списка участников
        function renderParticipantsList(participants, chatId, tripId) {
            const container = document.getElementById('participantsList');

            if (!participants || participants.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-4">
                        <i class="fas fa-users fa-3x text-muted mb-3"></i>
                        <p class="text-muted">Нет участников</p>
                    </div>
                `;
                return;
            }

            let html = '<div class="list-group list-group-flush">';

            participants.forEach(participant => {
                const joinedDate = new Date(participant.joinedAt).toLocaleDateString('ru-RU', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric'
                });

                const roleBadge = participant.isCreator
                    ? '<span class="badge bg-primary ms-2">Организатор</span>'
                    : '<span class="badge bg-secondary ms-2">Участник</span>';

                const friendBadge = participant.isFriend
                    ? '<span class="badge bg-success ms-2"><i class="fas fa-user-friends me-1"></i>Друг</span>'
                    : '';

                html += `
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3" data-user-id="${participant.userId}">
                        <div class="d-flex align-items-center">
                            <div class="me-3">
                                ${participant.avatarPath ?
                                    `<img src="${participant.avatarPath}" class="rounded-circle" width="48" height="48" style="object-fit: cover;">` :
                                    `<div class="avatar-circle-sm bg-primary" style="width:48px;height:48px; font-size:18px;">${getInitials(participant.fullName)}</div>`
                                }
                            </div>
                            <div>
                                <div class="fw-bold">
                                    ${escapeHtml(participant.fullName)}
                                    ${roleBadge}
                                    ${friendBadge}
                                </div>
                                <small class="text-muted">Присоединился: ${joinedDate}</small>
                            </div>
                        </div>
                        <div class="btn-group">
                            ${!participant.isCreator && !participant.isCurrentUser ? `
                                <button class="btn btn-sm btn-outline-danger" onclick="removeParticipant(${tripId}, ${participant.userId})" title="Удалить из поездки">
                                    <i class="fas fa-user-minus"></i>
                                </button>
                            ` : ''}
                            ${!participant.isCreator && participant.isCurrentUser ? `
                                <button class="btn btn-sm btn-outline-warning" onclick="leaveTrip(${tripId})" title="Покинуть поездку">
                                    <i class="fas fa-sign-out-alt"></i>
                                </button>
                            ` : ''}
                            ${chatId && !participant.isCurrentUser ? `
                                <button class="btn btn-sm btn-outline-primary" onclick="startPrivateChatWithParticipant(${participant.userId})" title="Написать лично">
                                    <i class="fas fa-comment"></i>
                                </button>
                            ` : ''}
                        </div>
                    </div>
                `;
            });

            html += '</div>';
            container.innerHTML = html;
        }
                async function removeParticipant(tripId, userIdToRemove) {
            if (!confirm('Вы уверены, что хотите удалить этого участника из поездки? Он также будет удален из общего чата.')) {
                return;
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Trips/RemoveParticipant', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        tripId: tripId,
                        userId: userIdToRemove
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showNotification(data.message, 'success');

                    // Обновляем список участников
                    await openManageParticipantsModal(tripId);

                    // Обновляем карточки поездок
                    await loadTrips();
                } else {
                    showNotification(data.message || 'Ошибка при удалении участника', 'danger');
                }
            } catch (error) {
                console.error('Error removing participant:', error);
                showNotification('Не удалось удалить участника', 'danger');
            }
        }

        // Покинуть поездку (для обычных участников)
        async function leaveTrip(tripId) {
            if (!confirm('Вы уверены, что хотите покинуть эту поездку? Вы также будете удалены из общего чата.')) {
                return;
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Trips/RemoveParticipant', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        tripId: tripId,
                        userId: currentUserId
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showNotification(data.message, 'success');

                    // Закрываем модальное окно
                    manageParticipantsModal.hide();

                    // Обновляем карточки поездок
                    await loadTrips();
                } else {
                    showNotification(data.message || 'Ошибка при выходе из поездки', 'danger');
                }
            } catch (error) {
                console.error('Error leaving trip:', error);
                showNotification('Не удалось покинуть поездку', 'danger');
            }
        }

        // Начать личный чат с участником
        async function startPrivateChatWithParticipant(userId) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Chats/CreatePrivateChat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(userId)
                });

                const result = await response.json();

                if (result.success) {
                    const chatId = result.data;
                    window.location.href = `/Home/Chats?chatId=${chatId}`;
                } else {
                    showNotification(result.message || 'Ошибка при создании чата', 'danger');
                }
            } catch (error) {
                console.error('Error starting private chat:', error);
                showNotification('Не удалось создать чат', 'danger');
            }
        }
                // Загрузка приглашений
        async function loadInvitations() {
            try {
                const response = await fetch('/Trips/GetMyInvitations');
                const data = await response.json();

                if (data.success) {
                    renderInvitations(data.data);
                } else {
                    console.error('Error loading invitations:', data.message);
                }
            } catch (error) {
                console.error('Error loading invitations:', error);
            }
        }

        // Отображение приглашений
        function renderInvitations(invitations) {
            const container = document.getElementById('invitationsContainer');

            if (!invitations || invitations.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-envelope-open-text fa-3x text-muted mb-3"></i>
                        <h5>Нет приглашений</h5>
                        <p class="text-muted">Когда вас пригласят в поездку, они появятся здесь</p>
                    </div>
                `;
                return;
            }

            let html = '<div class="row g-4">';

            invitations.forEach(inv => {
                const date = new Date(inv.invitedAt).toLocaleDateString('ru-RU', {
                    day: 'numeric',
                    month: 'long',
                    hour: '2-digit',
                    minute: '2-digit'
                });

                html += `
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-warning invitation-card">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="me-3">
                                        ${inv.inviterAvatar ?
                                            `<img src="${inv.inviterAvatar}" class="rounded-circle" width="50" height="50" style="object-fit: cover;">` :
                                            `<div class="avatar-circle-sm bg-warning" style="width:50px;height:50px; font-size:20px;">${getInitials(inv.inviterName)}</div>`
                                        }
                                    </div>
                                    <div>
                                        <h5 class="mb-0">${escapeHtml(inv.tripTitle)}</h5>
                                        <small class="text-muted">
                                            <i class="fas fa-user me-1"></i>${escapeHtml(inv.inviterName)}
                                        </small>
                                    </div>
                                </div>

                                ${inv.message ? `
                                    <div class="alert alert-light mt-2 p-2">
                                        <i class="fas fa-quote-left text-muted me-1"></i>
                                        "${escapeHtml(inv.message)}"
                                    </div>
                                ` : ''}

                                <div class="text-muted small mb-3">
                                    <i class="far fa-clock me-1"></i>${date}
                                </div>

                                <div class="d-flex gap-2">
                                    <button class="btn btn-success flex-grow-1" onclick="respondToInvitation(${inv.id}, true)">
                                        <i class="fas fa-check me-1"></i>Принять
                                    </button>
                                    <button class="btn btn-outline-danger flex-grow-1" onclick="respondToInvitation(${inv.id}, false)">
                                        <i class="fas fa-times me-1"></i>Отклонить
                                    </button>
                                </div>

                                ${inv.chatId ? `
                                    <div class="mt-2 text-center">
                                        <small class="text-muted">
                                            <i class="fas fa-comments me-1"></i>
                                            После принятия вы попадете в общий чат поездки
                                        </small>
                                    </div>
                                ` : ''}
                            </div>
                        </div>
                    </div>
                `;
            });

            html += '</div>';
            container.innerHTML = html;
        }

        // Ответ на приглашение
        async function respondToInvitation(invitationId, accept) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Trips/RespondToInvitation', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        invitationId: invitationId,
                        accept: accept
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showNotification(data.message, accept ? 'success' : 'info');

                    // Перезагружаем приглашения и поездки
                    await loadInvitations();
                    await loadTrips();
                } else {
                    showNotification(data.message || 'Ошибка', 'danger');
                }
            } catch (error) {
                console.error('Error responding to invitation:', error);
                showNotification('Не удалось обработать приглашение', 'danger');
            }
        }

        // Отправка приглашения другу (для использования в openInviteModal)
        async function sendInvitation(tripId, friendId, message) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Trips/SendInvitation', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        tripId: tripId,
                        friendId: friendId,
                        message: message
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showNotification(data.message, 'success');
                    return true;
                } else {
                    showNotification(data.message || 'Ошибка при отправке приглашения', 'danger');
                    return false;
                }
            } catch (error) {
                console.error('Error sending invitation:', error);
                showNotification('Не удалось отправить приглашение', 'danger');
                return false;
            }
        }
    </script>
}