        // Экранирование спецсимволов для регулярного выражения
        function escapeRegex(string) {
            return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        }

                // Функция сортировки поездок
        function sortTrips(trips, sortType, sortOrder, isCompleted = false) {
            return [...trips].sort((a, b) => {
                switch(sortType) {
                    case 'date':
                        const dateA = new Date(a.startDate).getTime();
                        const dateB = new Date(b.startDate).getTime();

                        if (isCompleted) {
                            // Для завершенных поездок
                            // asc = сначала новые (более поздние даты первыми)
                            // desc = сначала старые (более ранние даты первыми)
                            if (sortOrder === 'asc') {
                                return dateB - dateA;
                            } else {
                                return dateA - dateB;
                            }
                        } else {
                            // Для предстоящих поездок
                            // asc = сначала новые (более ранние даты первыми)
                            // desc = сначала старые (более поздние даты первыми)
                            if (sortOrder === 'asc') {
                                return dateA - dateB;
                            } else {
                                return dateB - dateA;
                            }
                        }

                    case 'name':
                        const nameCompare = a.title.localeCompare(b.title, 'ru');
                        return sortOrder === 'asc' ? nameCompare : -nameCompare;

                    case 'budget':
                        if (sortOrder === 'asc') {
                            // Сначала дорогие: от большего к меньшему
                            return b.totalBudget - a.totalBudget;
                        } else {
                            // Сначала бюджетные: от меньшего к большему
                            return a.totalBudget - b.totalBudget;
                        }

                    case 'duration':
                        if (sortOrder === 'asc') {
                            // Сначала короткие: от меньшего к большему
                            return a.duration - b.duration;
                        } else {
                            // Сначала длинные: от большего к меньшему
                            return b.duration - a.duration;
                        }

                    default:
                        return 0;
                }
            });
        }

                // Отфильтрованные поездки с учетом поиска
        function renderFilteredTrips() {
            const now = new Date();

            let upcoming = allTrips.filter(trip => new Date(trip.endDate) >= now);
            let completed = allTrips.filter(trip => new Date(trip.endDate) < now);

            if (searchTerm) {
                upcoming = filterTripsBySearch(upcoming, searchTerm);
                completed = filterTripsBySearch(completed, searchTerm);
            }

            console.log('=== BEFORE SORTING ===');
            console.log('Upcoming:', upcoming.map(t => ({ title: t.title, startDate: t.startDate })));
            console.log('Completed:', completed.map(t => ({ title: t.title, endDate: t.endDate })));

            // Применяем сортировку с указанием типа поездки
            upcoming = sortTrips(upcoming, sortSettings.upcoming.type, sortSettings.upcoming.order, false);
            completed = sortTrips(completed, sortSettings.completed.type, sortSettings.completed.order, true);

            console.log('=== AFTER SORTING ===');
            console.log('Upcoming (sorted):', upcoming.map(t => ({ title: t.title, startDate: t.startDate })));
            console.log('Completed (sorted):', completed.map(t => ({ title: t.title, endDate: t.endDate })));

            renderTrips(upcoming, 'upcoming');
            renderTrips(completed, 'completed');
            updateSearchResultsInfo(upcoming.length, completed.length);
        }

        // Поиск по поездкам
        function filterTripsBySearch(trips, term) {
            if (!term || term.trim() === '') return trips;

            const searchLower = term.toLowerCase().trim();
            return trips.filter(trip =>
                trip.title.toLowerCase().includes(searchLower) ||
                (trip.description && trip.description.toLowerCase().includes(searchLower)) ||
                trip.createdBy.fullName.toLowerCase().includes(searchLower) ||
                trip.participants.some(p => p.fullName.toLowerCase().includes(searchLower))
            );
        }

