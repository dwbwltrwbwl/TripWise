                // Проверка новых сообщений
                        async function checkNewMessages(chatId) {
            try {
                const response = await fetch(`/Chats/GetNewMessages?chatId=${chatId}&lastMessageId=${lastMessageId}`);
                const data = await response.json();

                if (data.success && data.data && data.data.length > 0) {
                    // Получаем существующие ID сообщений в UI
                    const existingMessageIds = new Set();
                    document.querySelectorAll('.message').forEach(msgElement => {
                        const msgId = msgElement.getAttribute('data-message-id');
                        if (msgId) existingMessageIds.add(parseInt(msgId));
                    });

                    // Добавляем только новые сообщения, которых еще нет в UI
                    const newMessages = data.data.filter(msg => !existingMessageIds.has(msg.id));

                    newMessages.forEach(msg => {
                        // Подготавливаем attachments для отображения
                        if (msg.attachments) {
                            // Уже в правильном формате
                        } else if (msg.attachmentUrl) {
                            msg.attachments = [{
                                fileName: msg.attachmentName,
                                fileUrl: msg.attachmentUrl,
                                fileSize: msg.attachmentSize,
                                fileType: msg.attachmentType
                            }];
                        }
                        appendMessageToUI(msg);
                    });

                    await markMessagesAsRead(chatId);

                    // Обновляем lastMessageId
                    if (data.data.length > 0) {
                        lastMessageId = Math.max(...data.data.map(m => m.id));
                    }
                }
            } catch (error) {
                console.error('Ошибка проверки новых сообщений:', error);
            }
        }

