               let selectedFiles = []; // Массив выбранных файлов
        const MAX_FILES = 10;

        // Выбор файла
                function attachFile() {
            if (selectedFiles.length >= MAX_FILES) {
                showNotification(`Максимум можно прикрепить ${MAX_FILES} файлов`, 'warning');
                return;
            }

            // Создаем input для выбора файлов
            const fileInput = document.createElement('input');
            fileInput.type = 'file';
            fileInput.style.display = 'none';
            fileInput.multiple = true; // Разрешаем множественный выбор
            fileInput.accept = '.jpg,.jpeg,.png,.gif,.webp,.pdf,.doc,.docx,.xls,.xlsx,.txt,.zip,.rar,.7z';
            fileInput.onchange = handleFileSelect;

            document.body.appendChild(fileInput);
            fileInput.click();

            setTimeout(() => {
                document.body.removeChild(fileInput);
            }, 1000);
        }

        // Обработка выбора файла
                async function handleFileSelect(event) {
            const files = Array.from(event.target.files);

            if (files.length === 0) return;

            // Проверяем общее количество
            if (selectedFiles.length + files.length > MAX_FILES) {
                showNotification(`Максимум можно прикрепить ${MAX_FILES} файлов (сейчас ${selectedFiles.length})`, 'warning');
                return;
            }

            // Проверяем каждый файл
            for (const file of files) {
                // Проверка размера (10 МБ)
                if (file.size > 10 * 1024 * 1024) {
                    showNotification(`Файл "${file.name}" слишком большой (макс. 10 МБ)`, 'danger');
                    continue;
                }

                // Загружаем файл
                await uploadFile(file);
            }
        }
                // Загрузка одного файла
        async function uploadFile(file) {
            // Показываем индикатор загрузки
            showNotification(`Загрузка "${file.name}"...`, 'info');

            const formData = new FormData();
            formData.append('file', file);

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Chats/UploadFile', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });

                const data = await response.json();

                if (data.success) {
                    selectedFiles.push(data.data);
                    showNotification(`Файл "${data.data.fileName}" загружен`, 'success');
                    updateSelectedFilesIndicator();
                } else {
                    showNotification(data.message || `Ошибка при загрузке "${file.name}"`, 'danger');
                }
            } catch (error) {
                console.error('Ошибка при загрузке файла:', error);
                showNotification(`Не удалось загрузить "${file.name}": ` + error.message, 'danger');
            }
        }
                function updateSelectedFilesIndicator() {
            const container = document.getElementById('messageInputContainer');
            if (!container) return;

            // Удаляем старый индикатор
            const oldIndicator = document.getElementById('selectedFilesIndicator');
            if (oldIndicator) oldIndicator.remove();

            if (selectedFiles.length === 0) return;

            const indicator = document.createElement('div');
            indicator.id = 'selectedFilesIndicator';
            indicator.className = 'selected-files-indicator mt-2';

            let html = '<div class="bg-light rounded p-2">';
            html += '<div class="d-flex justify-content-between align-items-center mb-2">';
            html += `<span class="fw-bold">Прикреплено файлов: ${selectedFiles.length}/${MAX_FILES}</span>`;
            html += '<button class="btn btn-sm btn-link text-danger" onclick="clearAllFiles()">Очистить все</button>';
            html += '</div>';
            html += '<div class="file-list" style="max-height: 200px; overflow-y: auto;">';

            selectedFiles.forEach((file, index) => {
                const fileExt = file.fileName.split('.').pop()?.toLowerCase();
                let fileIcon = 'fa-file';

                if (file.fileType.includes('image')) fileIcon = 'fa-file-image';
                else if (file.fileType.includes('pdf')) fileIcon = 'fa-file-pdf';
                else if (file.fileType.includes('doc')) fileIcon = 'fa-file-word';
                else if (file.fileType.includes('xls')) fileIcon = 'fa-file-excel';
                else if (file.fileType.includes('zip') || file.fileType.includes('rar')) fileIcon = 'fa-file-archive';

                html += `
                    <div class="d-flex align-items-center p-1 border-bottom">
                        <i class="fas ${fileIcon} me-2"></i>
                        <span class="flex-grow-1 text-truncate" style="max-width: 200px;">${escapeHtml(file.fileName)}</span>
                        <small class="text-muted me-2">${formatFileSize(file.fileSize)}</small>
                        <button class="btn btn-sm btn-link text-danger" onclick="removeFile(${index})">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                `;
            });

            html += '</div></div>';
            indicator.innerHTML = html;
            container.appendChild(indicator);
        }
                // Удаление одного файла
        function removeFile(index) {
            selectedFiles.splice(index, 1);
            updateSelectedFilesIndicator();
        }
                function clearAllFiles() {
            selectedFiles = [];
            updateSelectedFilesIndicator();
        }
        // Отображение индикатора выбранного файла
        function showSelectedFileIndicator() {
            const container = document.getElementById('messageInputContainer');
            if (!container) return;

            // Удаляем старый индикатор, если есть
            const oldIndicator = document.getElementById('selectedFileIndicator');
            if (oldIndicator) oldIndicator.remove();

            const indicator = document.createElement('div');
            indicator.id = 'selectedFileIndicator';
            indicator.className = 'selected-file-indicator';
            indicator.innerHTML = `
                <div class="d-flex align-items-center p-2 bg-light rounded mt-2">
                    <i class="fas fa-file me-2"></i>
                    <span class="flex-grow-1 text-truncate">${escapeHtml(selectedFile.fileName)}</span>
                    <small class="text-muted me-2">${formatFileSize(selectedFile.fileSize)}</small>
                    <button class="btn btn-sm btn-link text-danger" onclick="clearSelectedFile()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            `;

            container.appendChild(indicator);
        }

        // Очистка выбранного файла
        function clearSelectedFile() {
            selectedFile = null;
            const indicator = document.getElementById('selectedFileIndicator');
            if (indicator) indicator.remove();
        }

        // Форматирование размера файла
                function formatFileSize(bytes) {
            if (bytes === 0 || !bytes) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }
                // ==================== ОТОБРАЖЕНИЕ ВЛОЖЕНИЙ ====================

        function renderAttachment(file) {
            if (!file || !file.fileUrl) return '';

            const fileExt = file.fileName?.split('.').pop()?.toLowerCase();
            const fileType = file.fileType || '';

            // Определяем, является ли файл изображением
            const isImage = fileType.startsWith('image/') || ['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(fileExt);

            // Создаем URL для скачивания
            const fileName = encodeURIComponent(file.fileName || 'file');

            if (isImage) {
                return `
                    <div class="attachment-container">
                        <a href="${file.fileUrl}" target="_blank" class="image-preview">
                            <img src="${file.fileUrl}" alt="${escapeHtml(file.fileName)}"
                                 style="max-width: 200px; max-height: 200px; border-radius: 5px; cursor: pointer;">
                        </a>
                        <div class="attachment-actions mt-1">
                            <a href="${file.fileUrl}" download="${fileName}" class="btn btn-sm btn-outline-primary" title="Скачать">
                                <i class="fas fa-download"></i> Скачать
                            </a>
                        </div>
                    </div>
                `;
            } else {
                // Определяем иконку по расширению или типу
                let fileIcon = 'fa-file';
                let fileColor = '';

                if (fileType.includes('pdf') || fileExt === 'pdf') {
                    fileIcon = 'fa-file-pdf';
                    fileColor = 'text-danger';
                } else if (fileType.includes('doc') || ['doc', 'docx'].includes(fileExt)) {
                    fileIcon = 'fa-file-word';
                    fileColor = 'text-primary';
                } else if (fileType.includes('xls') || ['xls', 'xlsx'].includes(fileExt)) {
                    fileIcon = 'fa-file-excel';
                    fileColor = 'text-success';
                } else if (fileType.includes('zip') || fileType.includes('rar') || fileType.includes('7z') ||
                           ['zip', 'rar', '7z'].includes(fileExt)) {
                    fileIcon = 'fa-file-archive';
                    fileColor = 'text-warning';
                } else if (fileType.includes('text') || fileExt === 'txt') {
                    fileIcon = 'fa-file-alt';
                    fileColor = 'text-secondary';
                }

                return `
                    <div class="attachment-container">
                        <a href="${file.fileUrl}" target="_blank" class="file-attachment d-flex align-items-center p-2 bg-light rounded text-decoration-none">
                            <i class="fas ${fileIcon} ${fileColor} me-2 fa-lg"></i>
                            <span class="flex-grow-1 text-truncate">${escapeHtml(file.fileName)}</span>
                            <small class="text-muted ms-2">${formatFileSize(file.fileSize)}</small>
                        </a>
                        <div class="attachment-actions mt-1">
                            <a href="${file.fileUrl}" download="${fileName}" class="btn btn-sm btn-outline-primary" title="Скачать">
                                <i class="fas fa-download"></i> Скачать
                            </a>
                        </div>
                    </div>
                `;
            }
        }
        // Обновленная функция отправки сообщения с файлом
                async function sendMessage() {
            const input = document.getElementById('messageInput');
            const text = input.value.trim();

            if ((!text || text === '') && selectedFiles.length === 0) {
                console.log('Нет текста и не выбрано файлов');
                return;
            }

            if (!currentChatId) {
                console.log('Не выбран чат');
                return;
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                if (!token) {
                    console.error('Token не найден');
                    showNotification('Ошибка аутентификации', 'danger');
                    return;
                }

                const messageData = {
                    chatId: currentChatId,
                    text: text || '',
                    attachments: selectedFiles // Отправляем все файлы
                };

                console.log('Отправка сообщения с файлами:', messageData);

                const response = await fetch('/Chats/SendMessage', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(messageData)
                });

                if (!response.ok) {
                    throw new Error(`HTTP ошибка: ${response.status}`);
                }

                const data = await response.json();

                if (data.success) {
                    input.value = '';
                    clearAllFiles(); // Очищаем все файлы
                    // Сообщение придет через checkNewMessages
                } else {
                    showNotification(data.message || 'Ошибка при отправке', 'danger');
                }
            } catch (error) {
                console.error('Ошибка отправки сообщения:', error);
                showNotification('Не удалось отправить сообщение: ' + error.message, 'danger');
            }
        }
                // ==================== ПЕРЕИМЕНОВАНИЕ ЧАТА ====================

                async function renameChat() {
            if (!currentChatId) return;

            // Получаем текущее название чата
            const currentTitle = document.getElementById('chatTitle').textContent;

            // Создаем модальное окно для ввода нового названия
            const modalHtml = `
                <div class="modal fade" id="renameChatModal" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Переименовать чат</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label">Новое название чата</label>
                                    <input type="text" class="form-control" id="newChatNameInput"
                                           value="${escapeHtml(currentTitle)}" maxlength="200" placeholder="Введите название чата">
                                    <small class="text-muted">Максимум 200 символов</small>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                                <button type="button" class="btn btn-primary" onclick="submitRenameChat()">Сохранить</button>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            // Добавляем модальное окно в DOM
            const modalContainer = document.createElement('div');
            modalContainer.innerHTML = modalHtml;
            document.body.appendChild(modalContainer);

            // Показываем модальное окно
            const modal = new bootstrap.Modal(document.getElementById('renameChatModal'));
            modal.show();

            // Обработчик закрытия модального окна
            document.getElementById('renameChatModal').addEventListener('hidden.bs.modal', function() {
                this.remove();
            });

            // Автоматически выделяем текст для удобства
            setTimeout(() => {
                const input = document.getElementById('newChatNameInput');
                if (input) {
                    input.focus();
                    input.select();
                }
            }, 500);
        }



        async function submitRenameChat() {
            const newName = document.getElementById('newChatNameInput').value.trim();

            if (!newName) {
                showNotification('Введите название чата', 'warning');
                return;
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Chats/RenameChat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        chatId: currentChatId,
                        newName: newName
                    })
                });

                const data = await response.json();
                console.log('Результат переименования:', data);

                if (data.success) {
                    showNotification('Название чата изменено', 'success');

                    // Обновляем название в заголовке
                    document.getElementById('chatTitle').textContent = newName;

                    // Обновляем название в списке чатов
                    updateChatNameInList(currentChatId, newName);

                    // Закрываем модальное окно
                    const modal = bootstrap.Modal.getInstance(document.getElementById('renameChatModal'));
                    modal.hide();
                } else {
                    showNotification(data.message || 'Ошибка при переименовании', 'danger');
                }
            } catch (error) {
                console.error('Ошибка при переименовании:', error);
                showNotification('Не удалось переименовать чат: ' + error.message, 'danger');
            }
        }

        // Функция для обновления названия в списке чатов
        function updateChatNameInList(chatId, newName) {
            const chatElement = document.querySelector(`.chat-item[data-chat-id="${chatId}"]`);
            if (chatElement) {
                const nameElement = chatElement.querySelector('h6');
                if (nameElement) {
                    nameElement.textContent = newName;
                }
            }
        }
                // Функция для быстрого переименования из списка (двойной клик по названию)
        function enableChatRename(chatId, element) {
            const currentName = element.textContent;

            // Создаем input для редактирования
            const input = document.createElement('input');
            input.type = 'text';
            input.className = 'form-control form-control-sm';
            input.value = currentName;
            input.style.width = '140px';

            // Заменяем текст на input
            element.style.display = 'none';
            element.parentNode.insertBefore(input, element.nextSibling);

            input.focus();

            // Обработчик потери фокуса
            input.addEventListener('blur', function() {
                submitQuickRename(chatId, input.value, element, input);
            });

            // Обработчик нажатия Enter
            input.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    submitQuickRename(chatId, input.value, element, input);
                }
            });
        }

        async function submitQuickRename(chatId, newName, textElement, inputElement) {
            if (!newName.trim()) {
                // Если название пустое, возвращаем старое
                textElement.style.display = 'block';
                inputElement.remove();
                return;
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Chats/RenameChat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        chatId: chatId,
                        newName: newName.trim()
                    })
                });

                const data = await response.json();

                if (data.success) {
                    textElement.textContent = newName.trim();
                    showNotification('Название изменено', 'success');

                    // Если это текущий открытый чат, обновляем и заголовок
                    if (currentChatId === chatId) {
                        document.getElementById('chatTitle').textContent = newName.trim();
                    }
                } else {
                    showNotification(data.message || 'Ошибка при переименовании', 'danger');
                }
            } catch (error) {
                console.error('Ошибка при переименовании:', error);
                showNotification('Не удалось переименовать чат', 'danger');
            }

            // Возвращаем обычное отображение
            textElement.style.display = 'block';
            inputElement.remove();
        }
                // ==================== УДАЛЕНИЕ СООБЩЕНИЯ ====================

        async function deleteMessage(messageId, event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            if (!confirm('Вы уверены, что хотите удалить это сообщение?')) {
                return;
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Chats/DeleteMessage', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ messageId: messageId })
                });

                const data = await response.json();
                console.log('Результат удаления сообщения:', data);

                if (data.success) {
                    showNotification('Сообщение удалено', 'success');

                    // Удаляем сообщение из DOM
                    const messageElement = document.querySelector(`.message[data-message-id="${messageId}"]`);
                    if (messageElement) {
                        messageElement.remove();

                        // Если после удаления не осталось сообщений, показываем заглушку
                        const messagesList = document.getElementById('messagesList');
                        if (messagesList.children.length === 0) {
                            messagesList.innerHTML = `
                                <div class="text-center text-muted py-5">
                                    <i class="fas fa-comment-dots fa-3x mb-3"></i>
                                    <p>Здесь пока нет сообщений</p>
                                    <p class="small">Напишите что-нибудь, чтобы начать общение</p>
                                </div>
                            `;
                        }
                    }
                } else {
                    showNotification(data.message || 'Ошибка при удалении сообщения', 'danger');
                }
            } catch (error) {
                console.error('Ошибка при удалении сообщения:', error);
                showNotification('Не удалось удалить сообщение: ' + error.message, 'danger');
            }
        }
                // ==================== ЗАКРЕПЛЕНИЕ СООБЩЕНИЙ ====================

        async function pinMessage(messageId, pinForAll, event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Chats/PinMessage', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        messageId: messageId,
                        pinForAll: pinForAll
                    })
                });

                const data = await response.json();
                console.log('Результат закрепления:', data);

                if (data.success) {
                    showNotification(data.message || 'Сообщение закреплено', 'success');

                    // Обновляем отображение закрепленного сообщения
                    await loadPinnedMessage(currentChatId);
                } else {
                    showNotification(data.message || 'Ошибка при закреплении', 'danger');
                }
            } catch (error) {
                console.error('Ошибка при закреплении сообщения:', error);
                showNotification('Не удалось закрепить сообщение: ' + error.message, 'danger');
            }
        }

        async function unpinMessage(chatId, event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            if (!confirm('Открепить сообщение?')) return;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Chats/UnpinMessage', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ chatId: chatId })
                });

                const data = await response.json();
                console.log('Результат открепления:', data);

                if (data.success) {
                    showNotification('Сообщение откреплено', 'success');

                    // Удаляем блок с закрепленным сообщением
                    const pinnedContainer = document.getElementById('pinnedMessageContainer');
                    if (pinnedContainer) {
                        pinnedContainer.remove();
                    }
                } else {
                    showNotification(data.message || 'Ошибка при откреплении', 'danger');
                }
            } catch (error) {
                console.error('Ошибка при откреплении сообщения:', error);
                showNotification('Не удалось открепить сообщение: ' + error.message, 'danger');
            }
        }

        async function loadPinnedMessage(chatId) {
            try {
                const response = await fetch(`/Chats/GetPinnedMessage?chatId=${chatId}`);
                const data = await response.json();

                if (data.success && data.data) {
                    displayPinnedMessage(data.data);
                } else {
                    // Удаляем блок, если он есть
                    const pinnedContainer = document.getElementById('pinnedMessageContainer');
                    if (pinnedContainer) {
                        pinnedContainer.remove();
                    }
                }
            } catch (error) {
                console.error('Ошибка при загрузке закрепленного сообщения:', error);
            }
        }

        function displayPinnedMessage(message) {
            // Удаляем старый блок, если есть
            const oldContainer = document.getElementById('pinnedMessageContainer');
            if (oldContainer) {
                oldContainer.remove();
            }

            const chatHeader = document.getElementById('chatHeader');
            if (!chatHeader) return;

            const pinnedContainer = document.createElement('div');
            pinnedContainer.id = 'pinnedMessageContainer';
            pinnedContainer.className = 'pinned-message-container bg-light p-2 border-bottom';
            pinnedContainer.innerHTML = `
                <div class="d-flex align-items-center">
                    <i class="fas fa-thumbtack text-primary me-2" style="transform: rotate(45deg);"></i>
                    <div class="flex-grow-1">
                        <small class="text-muted">Закрепленное сообщение</small>
                        <div class="d-flex align-items-center">
                            <span class="fw-bold me-2">${escapeHtml(message.senderName)}:</span>
                            <span class="text-truncate" style="max-width: 300px;">${escapeHtml(message.text || 'Файл')}</span>
                        </div>
                        <small class="text-muted">
                            Закрепил(а) ${escapeHtml(message.pinnedBy)} • ${formatTime(message.pinnedAt)}
                        </small>
                    </div>
                    <button class="btn btn-sm btn-link text-danger" onclick="unpinMessage(${currentChatId}, event)" title="Открепить">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            `;

            chatHeader.after(pinnedContainer);
        }
    </script>
}