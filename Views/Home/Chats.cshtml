                                        async function loadPinnedMessages(chatId) {
            try {
                // Загружаем общее закрепленное сообщение
                const response = await fetch(`/Chats/GetPinnedMessage?chatId=${chatId}`);
                const data = await response.json();

                // Загружаем личное закрепленное сообщение
                const userResponse = await fetch(`/Chats/GetUserPinnedMessage?chatId=${chatId}`);
                const userData = await userResponse.json();

                // Отображаем оба, если есть
                displayPinnedMessages(data.data, userData.data);

                // Если есть закрепленные сообщения, но они не загружены в истории,
                // можно загрузить больше сообщений
                if (data.data && !document.querySelector(`.message[data-message-id="${data.data.id}"]`)) {
                    await loadMoreMessagesIfNeeded(chatId, data.data.sentAt);
                }
                if (userData.data && !document.querySelector(`.message[data-message-id="${userData.data.id}"]`)) {
                    await loadMoreMessagesIfNeeded(chatId, userData.data.sentAt);
                }
            } catch (error) {
                console.error('Ошибка при загрузке закрепленных сообщений:', error);
            }
        }
