        // Отправка сообщения
                        async function sendMessage() {
            const input = document.getElementById('messageInput');
            const text = input.value.trim();

            if ((!text || text === '') && selectedFiles.length === 0) {
                console.log('Нет текста и не выбрано файлов');
                return;
            }

            if (!currentChatId) {
                console.log('Не выбран чат');
                return;
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                if (!token) {
                    console.error('Token не найден');
                    showNotification('Ошибка аутентификации', 'danger');
                    return;
                }

                const messageData = {
                    chatId: currentChatId,
                    text: text || '',
                    attachments: selectedFiles
                };

                console.log('Отправка сообщения:', messageData);

                const response = await fetch('/Chats/SendMessage', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(messageData)
                });

                if (!response.ok) {
                    throw new Error(`HTTP ошибка: ${response.status}`);
                }

                const data = await response.json();

                if (data.success) {
                    input.value = '';
                    clearAllFiles();

                    // Не добавляем сообщение вручную - ждем checkNewMessages
                    // Он придет с правильным UTC временем

                } else {
                    showNotification(data.message || 'Ошибка при отправке', 'danger');
                }
            } catch (error) {
                console.error('Ошибка отправки сообщения:', error);
                showNotification('Не удалось отправить сообщение: ' + error.message, 'danger');
            }
        }

        // Добавление сообщения в UI
                                        function appendMessageToUI(message) {
            const messagesList = document.getElementById('messagesList');

            if (messagesList.children.length === 1 &&
                messagesList.children[0].classList.contains('text-center')) {
                messagesList.innerHTML = '';
            }

            // Нормализуем время
            let sentAt = message.sentAt;
            if (typeof sentAt === 'string') {
                // Если время без Z, добавляем его
                if (!sentAt.endsWith('Z') && !sentAt.includes('+')) {
                    sentAt = sentAt.replace(' ', 'T') + 'Z';
                }
            }

            // Проверяем, нужно ли добавить разделитель даты
            const lastMessage = messagesList.lastElementChild;
            let shouldAddDateSeparator = true;

            if (lastMessage && !lastMessage.classList.contains('date-separator')) {
                const lastMessageElement = lastMessage.previousElementSibling;
                if (lastMessageElement && lastMessageElement.classList.contains('date-separator')) {
                    const lastDateStr = lastMessageElement.querySelector('span').textContent;
                    const currentDateStr = formatDate(sentAt);
                    shouldAddDateSeparator = lastDateStr !== currentDateStr;
                }
            }

            if (shouldAddDateSeparator) {
                const dateSeparator = document.createElement('div');
                dateSeparator.className = 'date-separator';
                dateSeparator.innerHTML = `<span>${formatDate(sentAt)}</span>`;
                messagesList.appendChild(dateSeparator);
            }

            const isOutgoing = message.senderId === currentUserId;

            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${isOutgoing ? 'message-outgoing' : 'message-incoming'}`;
            messageDiv.setAttribute('data-message-id', message.id);

            // Получаем файлы для отображения
            let attachments = message.attachments || [];

            // Для обратной совместимости
            if (attachments.length === 0 && message.attachmentUrl) {
                attachments = [{
                    fileName: message.attachmentName,
                    fileUrl: message.attachmentUrl,
                    fileSize: message.attachmentSize,
                    fileType: message.attachmentType
                }];
            }

            // Формируем содержимое
            let content = `
                <div class="message-content">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            ${!isOutgoing ? `<div class="message-sender">${escapeHtml(message.senderName || 'Пользователь')}</div>` : ''}
                            <div class="message-text">${escapeHtml(message.text || '')}</div>
                        </div>
                        ${isOutgoing ? `
                        <div class="dropdown ms-2">
                            <button class="btn btn-sm btn-link text-muted p-0" data-bs-toggle="dropdown">
                                <i class="fas fa-ellipsis-v"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#" onclick="pinMessage(${message.id}, false, event)">
                                    <i class="fas fa-thumbtack text-success me-2"></i>Закрепить для себя
                                </a></li>
                                <li><a class="dropdown-item" href="#" onclick="pinMessage(${message.id}, true, event)">
                                    <i class="fas fa-thumbtack text-primary me-2"></i>Закрепить для всех
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="#" onclick="deleteMessage(${message.id}, event)">
                                    <i class="fas fa-trash me-2"></i>Удалить
                                </a></li>
                            </ul>
                        </div>
                        ` : ''}
                    </div>
            `;

            // Добавляем вложения если есть
            if (attachments.length > 0) {
                content += `<div class="message-attachments mt-2">`;
                attachments.forEach(att => {
                    content += renderAttachment(att);
                });
                content += `</div>`;
            }

            content += `<div class="message-time">${formatTime(sentAt)}</div></div>`;

            messageDiv.innerHTML = content;
            messagesList.appendChild(messageDiv);
            scrollToBottom();
        }

