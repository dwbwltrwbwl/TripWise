                // Загрузка сообщений чата
                async function loadChatMessages(chatId) {
            try {
                console.log('Загрузка сообщений чата:', chatId);
                const response = await fetch(`/Chats/GetChatMessages?chatId=${chatId}`);

                if (!response.ok) {
                    throw new Error(`HTTP ошибка: ${response.status}`);
                }

                const data = await response.json();
                console.log('Сообщения чата:', data);

                if (data.success) {
                    // Загружаем голосования для этого чата
                    await loadVotesForChat(chatId);

                    // Обрабатываем сообщения, заменяя голосования на интерактивные элементы
                    const processedMessages = data.data.map(msg => {
                        if (msg.attachmentType === 'vote' && msg.attachmentsJson) {
                            try {
                                const voteInfo = JSON.parse(msg.attachmentsJson);
                                const vote = window.votesData?.find(v => v.id === voteInfo.voteId);
                                if (vote) {
                                    // Создаем копию сообщения с визуализацией голосования
                                    return {
                                        ...msg,
                                        isVoteMessage: true,
                                        voteData: {
                                            voteId: vote.id,
                                            question: vote.question,
                                            options: vote.options,
                                            expiresAt: vote.expiresAt,
                                            isExpired: vote.isExpired,
                                            userHasVoted: vote.userHasVoted,
                                            userVoteOptionId: vote.userVoteOptionId
                                        }
                                    };
                                }
                            } catch (e) {
                                console.error('Error parsing vote data:', e);
                            }
                        }
                        return msg;
                    });

                    renderMessages(processedMessages);

                    // Обновляем lastMessageId
                    if (data.data && data.data.length > 0) {
                        lastMessageId = Math.max(...data.data.map(m => m.id));
                    }

                    markMessagesAsRead(chatId);
                    return { success: true };
                } else {
                    console.error('Ошибка загрузки сообщений:', data.message);
                    return { success: false, message: data.message };
                }
            } catch (error) {
                console.error('Ошибка загрузки сообщений:', error);
                return { success: false, message: error.message };
            }
        }
