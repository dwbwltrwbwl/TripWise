               let selectedFiles = []; // Массив выбранных файлов
        const MAX_FILES = 10;

        // Выбор файла
                function attachFile() {
            if (selectedFiles.length >= MAX_FILES) {
                showNotification(`Максимум можно прикрепить ${MAX_FILES} файлов`, 'warning');
                return;
            }

            // Создаем input для выбора файлов
            const fileInput = document.createElement('input');
            fileInput.type = 'file';
            fileInput.style.display = 'none';
            fileInput.multiple = true; // Разрешаем множественный выбор
            fileInput.accept = '.jpg,.jpeg,.png,.gif,.webp,.pdf,.doc,.docx,.xls,.xlsx,.txt,.zip,.rar,.7z';
            fileInput.onchange = handleFileSelect;

            document.body.appendChild(fileInput);
            fileInput.click();

            setTimeout(() => {
                document.body.removeChild(fileInput);
            }, 1000);
        }

        // Обработка выбора файла
                async function handleFileSelect(event) {
            const files = Array.from(event.target.files);

            if (files.length === 0) return;

            // Проверяем общее количество
            if (selectedFiles.length + files.length > MAX_FILES) {
                showNotification(`Максимум можно прикрепить ${MAX_FILES} файлов (сейчас ${selectedFiles.length})`, 'warning');
                return;
            }

            // Проверяем каждый файл
            for (const file of files) {
                // Проверка размера (10 МБ)
                if (file.size > 10 * 1024 * 1024) {
                    showNotification(`Файл "${file.name}" слишком большой (макс. 10 МБ)`, 'danger');
                    continue;
                }

                // Загружаем файл
                await uploadFile(file);
            }
        }
                // Загрузка одного файла
        async function uploadFile(file) {
            // Показываем индикатор загрузки
            showNotification(`Загрузка "${file.name}"...`, 'info');

            const formData = new FormData();
            formData.append('file', file);

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Chats/UploadFile', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });

                const data = await response.json();

                if (data.success) {
                    selectedFiles.push(data.data);
                    showNotification(`Файл "${data.data.fileName}" загружен`, 'success');
                    updateSelectedFilesIndicator();
                } else {
                    showNotification(data.message || `Ошибка при загрузке "${file.name}"`, 'danger');
                }
            } catch (error) {
                console.error('Ошибка при загрузке файла:', error);
                showNotification(`Не удалось загрузить "${file.name}": ` + error.message, 'danger');
            }
        }
                function updateSelectedFilesIndicator() {
            const container = document.getElementById('messageInputContainer');
            if (!container) return;

            // Удаляем старый индикатор
            const oldIndicator = document.getElementById('selectedFilesIndicator');
