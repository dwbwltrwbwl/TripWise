            if (!firstMessageId) return;

            // Если целевое сообщение старше самого раннего загруженного, загружаем еще
            const targetTime = new Date(targetDate).getTime();
            const firstMessageElement = Array.from(messages).find(m => m.getAttribute('data-message-id') === firstMessageId);

            if (firstMessageElement) {
                // Здесь можно реализовать подгрузку более старых сообщений
