                if (data.success) {
                    showNotification(data.message || 'Чат удален', 'success');

                    // Сбрасываем текущий чат
                    currentChatId = null;

                    // ТОЛЬКО вызываем updateChatVisibility - она сама все сделает
                    updateChatVisibility();

                    // Удаляем chatId из URL
                    const url = new URL(window.location);
                    url.searchParams.delete('chatId');
                    window.history.replaceState({}, '', url);

                    // Перезагружаем список чатов
                    await loadUserChats();
                } else {
                    showNotification(data.message || 'Ошибка при удалении чата', 'danger');
                }
            } catch (error) {
                console.error('Ошибка при удалении чата:', error);
