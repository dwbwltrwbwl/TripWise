        // Добавить вариант ответа
        function addVoteOption() {
            const container = document.getElementById('voteOptionsContainer');
            const newOption = document.createElement('div');
            newOption.className = 'vote-option-input mb-2';
            newOption.innerHTML = `
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Вариант ответа" required>
                    <button class="btn btn-outline-danger" type="button" onclick="removeVoteOption(this)">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            `;
            container.appendChild(newOption);
        }

        // Удалить вариант ответа
        function removeVoteOption(button) {
            const container = document.getElementById('voteOptionsContainer');
            if (container.children.length > 2) {
                button.closest('.vote-option-input').remove();
            } else {
                showNotification('Должно быть минимум 2 варианта', 'warning');
            }
        }

        // Создать голосование
        async function createVote() {
            const question = document.getElementById('voteQuestion').value.trim();
            const options = [];
            const expiresAt = document.getElementById('voteExpiresAt').value;

            document.querySelectorAll('#voteOptionsContainer input[type="text"]').forEach(input => {
                const text = input.value.trim();
                if (text) {
                    options.push(text);
                }
            });

            if (!question) {
                showNotification('Введите вопрос', 'warning');
                return;
            }

            if (options.length < 2) {
                showNotification('Добавьте минимум 2 варианта ответа', 'warning');
                return;
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Chats/CreateVote', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        chatId: currentChatId,
                        question: question,
                        options: options,
                        expiresAt: expiresAt ? new Date(expiresAt).toISOString() : null
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showNotification('Голосование создано!', 'success');

                    const modal = bootstrap.Modal.getInstance(document.getElementById('createVoteModal'));
                    modal.hide();

                    // Обновляем чат (добавляем сообщение о голосовании)
                    await loadChatMessages(currentChatId);
                } else {
                    showNotification(data.message || 'Ошибка при создании', 'danger');
                }
            } catch (error) {
                console.error('Error creating vote:', error);
                showNotification('Не удалось создать голосование', 'danger');
            }
        }
                // Рендеринг сообщения с голосованием
        function renderVoteMessage(voteData) {
            const isExpired = voteData.isExpired;
            const totalVotes = voteData.options.reduce((sum, opt) => sum + opt.votesCount, 0);

            let html = `
                <div class="vote-message">
                    <div class="vote-question">
                        <i class="fas fa-poll me-2 text-primary"></i>
                        ${escapeHtml(voteData.question)}
                    </div>
                    <div class="vote-options">
            `;

            voteData.options.forEach(option => {
                const percentage = totalVotes > 0 ? Math.round((option.votesCount / totalVotes) * 100) : 0;
                const isSelected = voteData.userHasVoted && voteData.userVoteOptionId === option.id;
                const disabled = isExpired || voteData.userHasVoted;

                html += `
                    <div class="vote-option ${isSelected ? 'selected' : ''} ${disabled ? 'disabled' : ''}"
                         data-option-id="${option.id}"
                         ${!disabled ? `onclick="submitVote(${voteData.voteId}, ${option.id})"` : ''}>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="option-text">
                                ${escapeHtml(option.text)}
                                ${isSelected ? '<span class="badge bg-success ms-2">Ваш голос</span>' : ''}
                            </div>
                            <div class="vote-count">${option.votesCount} голос(ов)</div>
                        </div>
                        <div class="progress">
                            <div class="progress-bar bg-primary" style="width: ${percentage}%"></div>
                        </div>
                    </div>
                `;
            });

            html += `
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <div class="vote-total">
                            <i class="fas fa-users me-1"></i>Всего голосов: ${totalVotes}
                        </div>
                        ${voteData.expiresAt ? `
                            <div class="vote-expired">
                                ${isExpired ?
                                    '<i class="fas fa-clock me-1"></i>Голосование завершено' :
                                    `<i class="fas fa-hourglass-half me-1"></i>До ${new Date(voteData.expiresAt).toLocaleDateString()}`
                                }
                            </div>
                        ` : ''}
                    </div>
                </div>
            `;

            return html;
        }

        // Отправить голос
        async function submitVote(voteId, optionId) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch('/Chats/SubmitVote', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        voteId: voteId,
                        optionId: optionId
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showNotification('Ваш голос учтен!', 'success');
                    // Обновляем сообщения в чате, чтобы показать актуальные результаты
                    await loadChatMessages(currentChatId);
                } else {
                    showNotification(data.message || 'Ошибка при голосовании', 'danger');
                }
            } catch (error) {
                console.error('Error submitting vote:', error);
                showNotification('Не удалось отправить голос', 'danger');
            }
        }

        // Загрузка голосований для чата
        async function loadVotesForChat(chatId) {
            try {
                const response = await fetch(`/Chats/GetVotes?chatId=${chatId}`);
                const data = await response.json();

                if (data.success) {
                    // Сохраняем голосования в глобальную переменную для быстрого доступа
                    window.votesData = data.data;
                }
            } catch (error) {
                console.error('Error loading votes:', error);
            }
        }
    </script>
