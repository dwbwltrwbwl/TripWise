@{
    ViewData["Title"] = "Чаты";
    var userId = Context.Session.GetInt32("UserId");
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4" style="font-family: 'Nunito', sans-serif; font-weight: 800; font-size: 2.5rem; color: #0379D9;">
                Чаты
            </h1>
            <p class="lead">Общайтесь с попутчиками, планируйте совместные путешествия и находите новых друзей</p>

            @if (userId == null)
            {
                <div class="alert alert-info">
                    <h5>Войдите в аккаунт</h5>
                    <p>Чтобы использовать чаты и находить попутчиков, войдите в свой аккаунт.</p>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Войти</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary">Зарегистрироваться</a>
                </div>
            }
            else
            {
                <!-- Основной контент чатов -->
                <div class="row">
                    <!-- Левая колонка: Список чатов и поиск друзей -->
                    <div class="col-md-4">
                        <!-- Карточка со списком чатов -->
                        <div class="card shadow-sm mb-4" style="height: 400px;">
                            <div class="card-header bg-light">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0" style="font-family: 'Nunito', sans-serif;">
                                        <i class="fas fa-comments me-2"></i>Мои чаты
                                    </h5>
                                    <button class="btn btn-sm btn-primary" onclick="openNewChatModal()">
                                        <i class="fas fa-plus me-1"></i>Новый
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-0" style="overflow-y: auto;">
                                <!-- Поиск по чатам -->
                                <div class="p-3 border-bottom">
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                                        <input type="text"
                                               class="form-control"
                                               placeholder="Поиск по чатам..."
                                               id="chatSearch"
                                               onkeyup="filterChats()">
                                    </div>
                                </div>

                                <!-- Список чатов - загружается динамически -->
                                <div id="chatsList" class="list-group list-group-flush">
                                    <div class="text-center py-4">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Загрузка...</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Карточка поиска друзей -->
                        <div class="card shadow-sm" style="height: 280px;">
                            <div class="card-header bg-light">
                                <h5 class="mb-0" style="font-family: 'Nunito', sans-serif;">
                                    <i class="fas fa-user-friends me-2"></i>Поиск друзей
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <div class="input-group">
                                        <input type="text"
                                               class="form-control"
                                               placeholder="Введите имя или email..."
                                               id="friendSearch"
                                               onkeyup="searchFriends(event)">
                                        <button class="btn btn-primary" onclick="searchFriends()">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                                <div id="friendsSearchResults" style="max-height: 180px; overflow-y: auto;">
                                    <!-- Результаты поиска друзей будут здесь -->
                                    <div class="text-center text-muted py-3">
                                        <i class="fas fa-user-plus fa-2x mb-2"></i>
                                        <p class="small">Найдите пользователей, чтобы начать общение</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Правая колонка: Окно чата -->
                    <div class="col-md-8">
                        <div class="card shadow-sm" style="height: 700px;" id="chatContainer" style="display: none;">
                            <!-- Шапка чата -->
                            <div class="card-header bg-light" id="chatHeader">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center" id="chatInfo">
                                        <!-- Информация о чате загружается динамически -->
                                        <div class="chat-avatar me-3">
                                            <div class="avatar-circle bg-primary" id="chatAvatar">
                                                <i class="fas fa-users"></i>
                                            </div>
                                        </div>
                                        <div>
                                            <h5 class="mb-0" id="chatTitle">Выберите чат</h5>
                                            <small class="text-muted" id="chatMembers"></small>
                                        </div>
                                    </div>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item" href="#" onclick="showChatInfo()"><i class="fas fa-info-circle me-2"></i>Информация</a></li>
                                            <li><a class="dropdown-item" href="#" onclick="addMembersToChat()"><i class="fas fa-user-plus me-2"></i>Добавить участников</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item text-danger" href="#" onclick="leaveChat()"><i class="fas fa-sign-out-alt me-2"></i>Покинуть чат</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <!-- Область сообщений -->
                            <div class="card-body p-0" style="overflow-y: auto; height: 550px; background-color: #f8f9fa;" id="messagesArea">
                                <div class="p-3" id="messagesList">
                                    <!-- Сообщения загружаются динамически -->
                                    <div class="text-center text-muted py-5">
                                        <i class="fas fa-comments fa-3x mb-3"></i>
                                        <p>Выберите чат для просмотра сообщений</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Поле ввода сообщения -->
                            <div class="card-footer" id="messageInputContainer" style="display: none;">
                                <div class="input-group">
                                    <button class="btn btn-outline-secondary" type="button" onclick="attachFile()">
                                        <i class="fas fa-paperclip"></i>
                                    </button>
                                    <input type="text"
                                           class="form-control"
                                           placeholder="Введите сообщение..."
                                           id="messageInput"
                                           onkeypress="handleMessageKeyPress(event)">
                                    <button class="btn btn-primary" type="button" onclick="sendMessage()">
                                        <i class="fas fa-paper-plane"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Заглушка, когда чат не выбран -->
                        <div class="card shadow-sm d-flex align-items-center justify-content-center"
                             style="height: 700px; background-color: #f8f9fa;"
                             id="noChatSelected">
                            <div class="text-center">
                                <i class="fas fa-comments fa-4x text-muted mb-3"></i>
                                <h4 class="text-muted">Чат не выбран</h4>
                                <p class="text-muted">Выберите чат из списка слева или создайте новый</p>
                                <button class="btn btn-primary" onclick="openNewChatModal()">
                                    <i class="fas fa-plus me-2"></i>Новый чат
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Модальное окно создания нового чата -->
<div class="modal fade" id="newChatModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Создать новый чат</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Выберите участников</label>
                    <div class="mb-2">
                        <input type="text"
                               class="form-control"
                               id="newChatUserSearch"
                               placeholder="Поиск пользователей..."
                               onkeyup="searchUsersForChat()">
                    </div>
                    <div id="userSearchResults" class="mt-2" style="max-height: 200px; overflow-y: auto;">
                        <!-- Результаты поиска пользователей -->
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Выбранные участники</label>
                    <div id="selectedUsersList" class="d-flex flex-wrap gap-2 p-2 border rounded bg-light min-height-50">
                        <span class="text-muted">Никто не выбран</span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Название чата (необязательно)</label>
                    <input type="text" class="form-control" id="newChatName"
                           placeholder="Будет создано автоматически из имен участников">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-primary" onclick="createNewChat()" id="createChatBtn">
                    Создать чат
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно добавления участников -->
<div class="modal fade" id="addMembersModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Добавить участников</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="addMembersChatId">
                <div class="mb-3">
                    <label class="form-label">Поиск пользователей</label>
                    <input type="text"
                           class="form-control"
                           id="addMembersSearch"
                           placeholder="Введите имя или email..."
                           onkeyup="searchUsersToAdd()">
                </div>
                <div id="addMembersResults" class="mt-3" style="max-height: 300px; overflow-y: auto;">
                    <!-- Результаты поиска -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Стили для чатов */
    .chat-item {
        cursor: pointer;
        transition: all 0.2s ease;
        border-left: 3px solid transparent;
        padding: 12px 15px;
    }

        .chat-item:hover {
            background-color: #f8f9fa;
            border-left-color: #dee2e6;
        }

        .chat-item.active {
            background-color: #e7f1ff;
            border-left-color: #0379D9;
        }

    .chat-avatar .avatar-circle {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 18px;
    }

    .avatar-circle-sm {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 14px;
        font-weight: 500;
    }

    .truncate {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 200px;
    }

    /* Стили для сообщений */
    .message {
        margin-bottom: 15px;
        display: flex;
    }

        .message.message-outgoing {
            justify-content: flex-end;
        }

        .message.message-incoming {
            justify-content: flex-start;
        }

    .message-content {
        max-width: 70%;
        padding: 10px 15px;
        border-radius: 15px;
        position: relative;
        word-break: break-word;
    }

    .message-outgoing .message-content {
        background-color: #0379D9;
        color: white;
        border-bottom-right-radius: 5px;
    }

    .message-incoming .message-content {
        background-color: white;
        color: #333;
        border-bottom-left-radius: 5px;
        border: 1px solid #e9ecef;
    }

    .message-sender {
        font-weight: 600;
        font-size: 0.85em;
        margin-bottom: 3px;
        color: #666;
    }

    .message-incoming .message-sender {
        color: #0379D9;
    }

    .message-text {
        margin-bottom: 5px;
    }

    .message-time {
        font-size: 0.75em;
        opacity: 0.7;
        text-align: right;
    }

    .message-outgoing .message-time {
        color: rgba(255, 255, 255, 0.8);
    }

    /* Стили для поиска друзей */
    .user-result-item {
        display: flex;
        align-items: center;
        padding: 10px;
        border-bottom: 1px solid #e9ecef;
        transition: background-color 0.2s;
    }

        .user-result-item:hover {
            background-color: #f8f9fa;
        }

        .user-result-item:last-child {
            border-bottom: none;
        }

    .add-user-btn {
        margin-left: auto;
    }

    .selected-user-tag {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        background-color: #e7f1ff;
        border-radius: 20px;
        font-size: 0.9em;
    }

        .selected-user-tag .btn-close {
            margin-left: 8px;
            font-size: 0.7em;
        }

    .min-height-50 {
        min-height: 50px;
    }

    /* Анимация */
    .message {
        animation: messageAppear 0.3s ease;
    }

    @@keyframes messageAppear {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Стили для даты разделителя */
    .date-separator {
        position: relative;
        text-align: center;
        margin: 20px 0;
    }

        .date-separator span {
            background-color: #e9ecef;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.85em;
            color: #6c757d;
        }
</style>

<script>
    console.log('Chats script loaded');
    console.log('Current path:', window.location.pathname);
    console.log('Window width:', window.innerWidth);
    console.log('Is mobile:', window.innerWidth < 768);
    // Глобальные переменные
    let currentUserId = @Json.Serialize(userId);
    let currentChatId = null;
    let selectedUsers = [];
    let messagesRefreshInterval = null;

    document.addEventListener('DOMContentLoaded', function() {
        console.log('DOM Content Loaded');
        console.log('Current User ID:', currentUserId);

        if (currentUserId) {
            console.log('Loading user chats...');
            loadUserChats();
        } else {
            console.log('User not logged in');
        }
    });

    // ==================== ЧАТЫ ====================

        // Загрузка чатов пользователя
    async function loadUserChats() {
        try {
            console.log('Загрузка чатов...');
            const response = await fetch('/Chats/GetUserChats');

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const data = await response.json();
            console.log('Ответ от сервера:', data);

            if (data.success) {
                renderChatsList(data.data || []);
            } else {
                console.error('Ошибка загрузки чатов:', data.message);
                showNotification(data.message || 'Не удалось загрузить чаты', 'danger');

                // Показываем пустой список
                const chatsList = document.getElementById('chatsList');
                chatsList.innerHTML = `
                    <div class="text-center py-5">
                        <i class="fas fa-comments fa-3x text-muted mb-3"></i>
                        <p class="text-muted">У вас пока нет чатов</p>
                        <button class="btn btn-sm btn-outline-primary" onclick="openNewChatModal()">
                            <i class="fas fa-plus me-1"></i>Создать чат
                        </button>
                    </div>
                `;
            }
        } catch (error) {
            console.error('Ошибка при загрузке чатов:', error);
            showNotification('Не удалось загрузить чаты: ' + error.message, 'danger');

            // Показываем сообщение об ошибке
            const chatsList = document.getElementById('chatsList');
            chatsList.innerHTML = `
                <div class="text-center py-5">
                    <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
                    <p class="text-danger">Ошибка загрузки чатов</p>
                    <button class="btn btn-sm btn-outline-primary" onclick="loadUserChats()">
                        <i class="fas fa-sync me-1"></i>Повторить
                    </button>
                </div>
            `;
        }
    }

        // Отображение списка чатов
    function renderChatsList(chats) {
        const chatsList = document.getElementById('chatsList');

        if (!chatsList) {
            console.error('Элемент chatsList не найден');
            return;
        }

        if (!chats || chats.length === 0) {
            chatsList.innerHTML = `
                <div class="text-center py-5">
                    <i class="fas fa-comments fa-3x text-muted mb-3"></i>
                    <p class="text-muted">У вас пока нет чатов</p>
                    <button class="btn btn-sm btn-outline-primary" onclick="openNewChatModal()">
                        <i class="fas fa-plus me-1"></i>Создать чат
                    </button>
                </div>
            `;
            return;
        }

        let html = '';
        chats.forEach(chat => {
            if (!chat) return;

            const lastMessage = chat.lastMessage || {
                text: 'Нет сообщений',
                sentAt: null,
                senderName: ''
            };

            const unreadCount = chat.unreadCount || 0;
            const isActive = currentChatId === chat.id;
            const chatName = chat.name || 'Чат';
            const lastMessageTime = lastMessage.sentAt ? formatMessageTime(lastMessage.sentAt) : '';

            html += `
                <div class="chat-item ${isActive ? 'active' : ''}" onclick="selectChat(${chat.id}, this)" data-chat-id="${chat.id}">
                    <div class="d-flex align-items-center">
                        <div class="chat-avatar me-3">
                            <div class="avatar-circle" style="background-color: ${getChatColor(chat.type)};">
                                <i class="fas ${getChatIcon(chat.type)}"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1" style="min-width: 0;">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="mb-1 text-truncate" style="max-width: 140px;">${escapeHtml(chatName)}</h6>
                                <small class="text-muted flex-shrink-0 ms-2">${lastMessageTime}</small>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <p class="small text-muted mb-0 text-truncate" style="max-width: 160px;">
                                    ${lastMessage.senderName ? `<span class="fw-bold">${escapeHtml(lastMessage.senderName)}:</span> ` : ''}
                                    ${escapeHtml(lastMessage.text || 'Нет сообщений')}
                                </p>
                                ${unreadCount > 0 ? `<span class="badge bg-primary rounded-pill ms-2">${unreadCount}</span>` : ''}
                            </div>
                            <small class="text-muted">
                                <i class="fas fa-users me-1"></i>${chat.memberCount || 0}
                            </small>
                        </div>
                    </div>
                </div>
            `;
        });

        chatsList.innerHTML = html;
    }

        // Обертка для fetch запросов
    async function fetchWithErrorHandling(url, options = {}) {
        try {
            const response = await fetch(url, {
                ...options,
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken(),
                    ...options.headers
                }
            });

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const data = await response.json();
            return data;
        } catch (error) {
            console.error(`Fetch error for ${url}:`, error);
            throw error;
        }
    }

    // Выбор чата
    async function selectChat(chatId, element) {
        if (!chatId) return;

        // Убираем активный класс у всех чатов
        document.querySelectorAll('.chat-item').forEach(el => {
            el.classList.remove('active');
        });

        // Добавляем активный класс выбранному
        if (element) {
            element.classList.add('active');
        }

        currentChatId = chatId;

        // Показываем контейнер чата и скрываем заглушку
        document.getElementById('chatContainer').style.display = 'flex';
        document.getElementById('noChatSelected').style.display = 'none';
        document.getElementById('messageInputContainer').style.display = 'flex';

        // Загружаем информацию о чате
        await loadChatInfo(chatId);

        // Загружаем сообщения
        await loadChatMessages(chatId);

        // Начинаем периодическое обновление сообщений
        startMessagesRefresh(chatId);
    }

    // Загрузка информации о чате
    async function loadChatInfo(chatId) {
        try {
            const response = await fetch(`/Chats/GetChatInfo/${chatId}`);
            const data = await response.json();

            if (data.success) {
                document.getElementById('chatTitle').textContent = data.chat.name;

                const memberNames = data.chat.members.map(m => m.fullName).join(', ');
                document.getElementById('chatMembers').textContent = memberNames;

                // Обновляем аватар
                const avatarIcon = document.querySelector('#chatAvatar i');
                if (avatarIcon) {
                    avatarIcon.className = `fas ${getChatIcon(data.chat.type)}`;
                }
            }
        } catch (error) {
            console.error('Ошибка загрузки информации о чате:', error);
        }
    }

    // Загрузка сообщений чата
    async function loadChatMessages(chatId) {
        try {
            const response = await fetch(`/Chats/GetChatMessages/${chatId}`);
            const data = await response.json();

            if (data.success) {
                renderMessages(data.messages);
                markMessagesAsRead(chatId);
            }
        } catch (error) {
            console.error('Ошибка загрузки сообщений:', error);
        }
    }

    // Отображение сообщений
    function renderMessages(messages) {
        const messagesList = document.getElementById('messagesList');

        if (!messages || messages.length === 0) {
            messagesList.innerHTML = `
                <div class="text-center text-muted py-5">
                    <i class="fas fa-comment-dots fa-3x mb-3"></i>
                    <p>Здесь пока нет сообщений</p>
                    <p class="small">Напишите что-нибудь, чтобы начать общение</p>
                </div>
            `;
            return;
        }

        let html = '';
        let currentDate = null;

        messages.forEach(msg => {
            const msgDate = new Date(msg.createdAt).toLocaleDateString('ru-RU');

            // Добавляем разделитель даты
            if (currentDate !== msgDate) {
                currentDate = msgDate;
                html += `
                    <div class="date-separator">
                        <span>${formatDate(msgDate)}</span>
                    </div>
                `;
            }

            const isOutgoing = msg.senderId === currentUserId;
            const senderName = isOutgoing ? 'Вы' : msg.senderName;

            html += `
                <div class="message ${isOutgoing ? 'message-outgoing' : 'message-incoming'}">
                    <div class="message-content">
                        ${!isOutgoing ? `<div class="message-sender">${escapeHtml(senderName)}</div>` : ''}
                        <div class="message-text">${escapeHtml(msg.text)}</div>
                        <div class="message-time">${formatTime(msg.createdAt)}</div>
                    </div>
                </div>
            `;
        });

        messagesList.innerHTML = html;
        scrollToBottom();
    }

    // Отправка сообщения
    async function sendMessage() {
        const input = document.getElementById('messageInput');
        const text = input.value.trim();

        if (!text || !currentChatId) return;

        try {
            const response = await fetch('/Chats/SendMessage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify({
                    chatId: currentChatId,
                    text: text
                })
            });

            const data = await response.json();

            if (data.success) {
                input.value = '';
                // Добавляем сообщение сразу в UI
                appendMessageToUI({
                    text: text,
                    senderId: currentUserId,
                    senderName: 'Вы',
                    createdAt: new Date().toISOString()
                });
            } else {
                showNotification(data.message || 'Ошибка при отправке', 'danger');
            }
        } catch (error) {
            console.error('Ошибка отправки сообщения:', error);
            showNotification('Не удалось отправить сообщение', 'danger');
        }
    }

    // Добавление сообщения в UI
    function appendMessageToUI(message) {
        const messagesList = document.getElementById('messagesList');

        // Убираем заглушку если она есть
        if (messagesList.children.length === 1 &&
            messagesList.children[0].classList.contains('text-center')) {
            messagesList.innerHTML = '';
        }

        const msgDate = new Date(message.createdAt).toLocaleDateString('ru-RU');
        const currentDate = new Date().toLocaleDateString('ru-RU');

        // Добавляем разделитель даты если это новый день
        if (!messagesList.querySelector('.date-separator:last-child span')?.textContent.includes(msgDate) &&
            msgDate !== currentDate) {
            const dateSeparator = document.createElement('div');
            dateSeparator.className = 'date-separator';
            dateSeparator.innerHTML = `<span>${formatDate(msgDate)}</span>`;
            messagesList.appendChild(dateSeparator);
        }

        const messageDiv = document.createElement('div');
        messageDiv.className = 'message message-outgoing';
        messageDiv.innerHTML = `
            <div class="message-content">
                <div class="message-text">${escapeHtml(message.text)}</div>
                <div class="message-time">${formatTime(message.createdAt)}</div>
            </div>
        `;

        messagesList.appendChild(messageDiv);
        scrollToBottom();
    }

    // Прокрутка к последнему сообщению
    function scrollToBottom() {
        const messagesArea = document.getElementById('messagesArea');
        messagesArea.scrollTop = messagesArea.scrollHeight;
    }

    // Отметить сообщения как прочитанные
    async function markMessagesAsRead(chatId) {
        try {
            await fetch(`/Chats/MarkAsRead/${chatId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': getAntiForgeryToken()
                }
            });
        } catch (error) {
            console.error('Ошибка при отметке прочитанных:', error);
        }
    }

    // Начать периодическое обновление сообщений
    function startMessagesRefresh(chatId) {
        if (messagesRefreshInterval) {
            clearInterval(messagesRefreshInterval);
        }

        messagesRefreshInterval = setInterval(async () => {
            if (currentChatId === chatId) {
                await checkNewMessages(chatId);
            }
        }, 3000);
    }

    // Проверка новых сообщений
    async function checkNewMessages(chatId) {
        try {
            const response = await fetch(`/Chats/GetNewMessages/${chatId}?lastMessageId=${lastMessageId || 0}`);
            const data = await response.json();

            if (data.success && data.messages.length > 0) {
                data.messages.forEach(msg => appendMessageToUI(msg));
                await markMessagesAsRead(chatId);
            }
        } catch (error) {
            console.error('Ошибка проверки новых сообщений:', error);
        }
    }

    // ==================== ПОИСК ДРУЗЕЙ ====================

    // Поиск пользователей
        async function searchFriends(event) {
        if (event) {
            if (event.key === 'Escape') {
                document.getElementById('friendSearch').value = '';
                clearSearchResults();
                return;
            }
        }

        const searchTerm = document.getElementById('friendSearch').value.trim();

        if (searchTerm.length < 2) {
            clearSearchResults();
            return;
        }

        try {
            showNotification('Поиск...', 'info');
            const data = await fetchWithErrorHandling(`/Chats/SearchUsers?term=${encodeURIComponent(searchTerm)}`);

            if (data.success) {
                displaySearchResults(data.data || []);
            } else {
                showNotification(data.message || 'Ошибка поиска', 'danger');
            }
        } catch (error) {
            console.error('Ошибка поиска пользователей:', error);
            showNotification('Не удалось выполнить поиск', 'danger');
        }
    }

    // Отображение результатов поиска
    function displaySearchResults(users) {
        const resultsDiv = document.getElementById('friendsSearchResults');

        if (!users || users.length === 0) {
            resultsDiv.innerHTML = `
                <div class="text-center text-muted py-3">
                    <i class="fas fa-user-slash fa-2x mb-2"></i>
                    <p>Пользователи не найдены</p>
                </div>
            `;
            return;
        }

        let html = '';
        users.forEach(user => {
            if (user.id !== currentUserId) {
                html += `
                    <div class="user-result-item">
                        <div class="avatar-circle-sm bg-primary me-2" style="background-color: ${getUserColor(user.id)};">
                            ${getInitials(user.fullName)}
                        </div>
                        <div>
                            <div class="fw-bold">${escapeHtml(user.fullName)}</div>
                            <div class="small text-muted">${escapeHtml(user.email)}</div>
                        </div>
                        <button class="btn btn-sm btn-outline-primary add-user-btn"
                                onclick="startPrivateChat(${user.id}, '${escapeHtml(user.fullName)}')">
                            <i class="fas fa-comment me-1"></i>Написать
                        </button>
                    </div>
                `;
            }
        });

        resultsDiv.innerHTML = html || '<div class="text-center text-muted py-3">Нет пользователей для отображения</div>';
    }

    // Очистка результатов поиска
    function clearSearchResults() {
        document.getElementById('friendsSearchResults').innerHTML = `
            <div class="text-center text-muted py-3">
                <i class="fas fa-user-plus fa-2x mb-2"></i>
                <p class="small">Найдите пользователей, чтобы начать общение</p>
            </div>
        `;
    }

    // Начать личный чат
    async function startPrivateChat(userId, userName) {
        try {
            const response = await fetch('/Chats/CreatePrivateChat', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify({ userId: userId })
            });

            const data = await response.json();

            if (data.success) {
                // Закрываем модальное окно если открыто
                const modal = bootstrap.Modal.getInstance(document.getElementById('newChatModal'));
                if (modal) modal.hide();

                // Загружаем чаты и выбираем созданный
                await loadUserChats();

                // Ищем созданный чат в списке и выбираем его
                setTimeout(() => {
                    const chatElement = document.querySelector(`[onclick*="selectChat(${data.chatId}"]`);
                    if (chatElement) {
                        selectChat(data.chatId, chatElement);
                    }
                }, 100);

                showNotification(`Чат с ${userName} создан`, 'success');
            } else {
                showNotification(data.message || 'Ошибка создания чата', 'danger');
            }
        } catch (error) {
            console.error('Ошибка создания чата:', error);
            showNotification('Не удалось создать чат', 'danger');
        }
    }

    // ==================== СОЗДАНИЕ НОВОГО ЧАТА ====================

    // Открыть модальное окно создания чата
    function openNewChatModal() {
        selectedUsers = [];
        updateSelectedUsersList();
        document.getElementById('newChatName').value = '';
        document.getElementById('userSearchResults').innerHTML = `
            <div class="text-center text-muted py-3">
                <i class="fas fa-search fa-2x mb-2"></i>
                <p class="small">Введите имя для поиска пользователей</p>
            </div>
        `;

        const modal = new bootstrap.Modal(document.getElementById('newChatModal'));
        modal.show();
    }

    // Поиск пользователей для нового чата
    async function searchUsersForChat() {
        const searchTerm = document.getElementById('newChatUserSearch').value.trim();

        if (searchTerm.length < 2) {
            document.getElementById('userSearchResults').innerHTML = `
                <div class="text-center text-muted py-3">
                    <i class="fas fa-search fa-2x mb-2"></i>
                    <p class="small">Введите минимум 2 символа для поиска</p>
                </div>
            `;
            return;
        }

        try {
            const response = await fetch(`/Chats/SearchUsers?term=${encodeURIComponent(searchTerm)}`);
            const data = await response.json();

            if (data.success) {
                displayUserSearchResults(data.users);
            }
        } catch (error) {
            console.error('Ошибка поиска:', error);
        }
    }

    // Отображение результатов поиска для создания чата
    function displayUserSearchResults(users) {
        const resultsDiv = document.getElementById('userSearchResults');

        if (!users || users.length === 0) {
            resultsDiv.innerHTML = '<div class="text-center text-muted py-3">Пользователи не найдены</div>';
            return;
        }

        let html = '<div class="list-group">';
        users.forEach(user => {
            if (user.id !== currentUserId && !selectedUsers.some(u => u.id === user.id)) {
                html += `
                    <div class="list-group-item list-group-item-action d-flex align-items-center">
                        <div class="avatar-circle-sm bg-primary me-2" style="background-color: ${getUserColor(user.id)};">
                            ${getInitials(user.fullName)}
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-bold">${escapeHtml(user.fullName)}</div>
                            <div class="small text-muted">${escapeHtml(user.email)}</div>
                        </div>
                        <button class="btn btn-sm btn-primary" onclick="addUserToChat(${user.id}, '${escapeHtml(user.fullName)}')">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                `;
            }
        });
        html += '</div>';

        resultsDiv.innerHTML = html;
    }

    // Добавление пользователя в список выбранных
    function addUserToChat(userId, userName) {
        if (!selectedUsers.some(u => u.id === userId)) {
            selectedUsers.push({ id: userId, name: userName });
            updateSelectedUsersList();
            document.getElementById('newChatUserSearch').value = '';
            document.getElementById('userSearchResults').innerHTML = '';
        }
    }

    // Обновление списка выбранных пользователей
    function updateSelectedUsersList() {
        const container = document.getElementById('selectedUsersList');

        if (selectedUsers.length === 0) {
            container.innerHTML = '<span class="text-muted">Никто не выбран</span>';
            return;
        }

        let html = '';
        selectedUsers.forEach(user => {
            html += `
                <span class="selected-user-tag">
                    ${escapeHtml(user.name)}
                    <button type="button" class="btn-close" onclick="removeUserFromChat(${user.id})"></button>
                </span>
            `;
        });

        container.innerHTML = html;
    }

    // Удаление пользователя из списка выбранных
    function removeUserFromChat(userId) {
        selectedUsers = selectedUsers.filter(u => u.id !== userId);
        updateSelectedUsersList();
    }

    // Создание нового чата
    async function createNewChat() {
        if (selectedUsers.length === 0) {
            showNotification('Выберите хотя бы одного участника', 'warning');
            return;
        }

        const chatName = document.getElementById('newChatName').value.trim();

        try {
            const response = await fetch('/Chats/CreateGroupChat', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify({
                    userIds: selectedUsers.map(u => u.id),
                    name: chatName
                })
            });

            const data = await response.json();

            if (data.success) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('newChatModal'));
                modal.hide();

                await loadUserChats();
                showNotification('Чат успешно создан', 'success');
            } else {
                showNotification(data.message || 'Ошибка создания чата', 'danger');
            }
        } catch (error) {
            console.error('Ошибка создания чата:', error);
            showNotification('Не удалось создать чат', 'danger');
        }
    }

    // ==================== ДОБАВЛЕНИЕ УЧАСТНИКОВ ====================

    // Открыть модальное окно добавления участников
    async function addMembersToChat() {
        if (!currentChatId) {
            showNotification('Сначала выберите чат', 'warning');
            return;
        }

        document.getElementById('addMembersChatId').value = currentChatId;
        document.getElementById('addMembersSearch').value = '';
        document.getElementById('addMembersResults').innerHTML = `
            <div class="text-center text-muted py-3">
                <i class="fas fa-search fa-2x mb-2"></i>
                <p class="small">Введите имя для поиска</p>
            </div>
        `;

        const modal = new bootstrap.Modal(document.getElementById('addMembersModal'));
        modal.show();
    }

    // Поиск пользователей для добавления
    async function searchUsersToAdd() {
        const searchTerm = document.getElementById('addMembersSearch').value.trim();
        const chatId = document.getElementById('addMembersChatId').value;

        if (searchTerm.length < 2) return;

        try {
            const response = await fetch(`/Chats/SearchUsersToAdd?chatId=${chatId}&term=${encodeURIComponent(searchTerm)}`);
            const data = await response.json();

            if (data.success) {
                displayAddMembersResults(data.users);
            }
        } catch (error) {
            console.error('Ошибка поиска:', error);
        }
    }

    // Отображение результатов для добавления
    function displayAddMembersResults(users) {
        const resultsDiv = document.getElementById('addMembersResults');

        if (!users || users.length === 0) {
            resultsDiv.innerHTML = '<div class="text-center text-muted py-3">Пользователи не найдены</div>';
            return;
        }

        let html = '<div class="list-group">';
        users.forEach(user => {
            if (user.id !== currentUserId) {
                html += `
                    <div class="list-group-item d-flex align-items-center">
                        <div class="avatar-circle-sm bg-primary me-2" style="background-color: ${getUserColor(user.id)};">
                            ${getInitials(user.fullName)}
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-bold">${escapeHtml(user.fullName)}</div>
                            <div class="small text-muted">${escapeHtml(user.email)}</div>
                        </div>
                        <button class="btn btn-sm btn-outline-primary"
                                onclick="addMemberToChat(${user.id}, '${escapeHtml(user.fullName)}')">
                            <i class="fas fa-user-plus me-1"></i>Добавить
                        </button>
                    </div>
                `;
            }
        });
        html += '</div>';

        resultsDiv.innerHTML = html;
    }

    // Добавление участника в чат
    async function addMemberToChat(userId, userName) {
        const chatId = document.getElementById('addMembersChatId').value;

        try {
            const response = await fetch('/Chats/AddMember', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify({
                    chatId: chatId,
                    userId: userId
                })
            });

            const data = await response.json();

            if (data.success) {
                showNotification(`Пользователь ${userName} добавлен в чат`, 'success');

                // Обновляем информацию о чате
                await loadChatInfo(chatId);

                // Удаляем добавленного пользователя из результатов
                const userElement = event.target.closest('.list-group-item');
                if (userElement) userElement.remove();
            } else {
                showNotification(data.message || 'Ошибка добавления', 'danger');
            }
        } catch (error) {
            console.error('Ошибка добавления участника:', error);
            showNotification('Не удалось добавить пользователя', 'danger');
        }
    }

    // ==================== ДЕЙСТВИЯ С ЧАТОМ ====================

    // Покинуть чат
    async function leaveChat() {
        if (!currentChatId) return;

        if (!confirm('Вы уверены, что хотите покинуть этот чат?')) return;

        try {
            const response = await fetch(`/Chats/LeaveChat/${currentChatId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': getAntiForgeryToken()
                }
            });

            const data = await response.json();

            if (data.success) {
                showNotification('Вы покинули чат', 'info');

                // Очищаем текущий чат
                currentChatId = null;
                document.getElementById('chatContainer').style.display = 'none';
                document.getElementById('noChatSelected').style.display = 'flex';

                // Перезагружаем список чатов
                await loadUserChats();
            } else {
                showNotification(data.message || 'Ошибка при выходе из чата', 'danger');
            }
        } catch (error) {
            console.error('Ошибка при выходе из чата:', error);
            showNotification('Не удалось покинуть чат', 'danger');
        }
    }

    // Информация о чате
    function showChatInfo() {
        if (!currentChatId) return;

        const chatTitle = document.getElementById('chatTitle').textContent;
        const chatMembers = document.getElementById('chatMembers').textContent;

        showNotification(`Чат: ${chatTitle}\nУчастники: ${chatMembers}`, 'info');
    }

    // Вложить файл
    function attachFile() {
        const fileInput = document.createElement('input');
        fileInput.type = 'file';
        fileInput.accept = 'image/*,.pdf,.doc,.docx,.txt';
        fileInput.style.display = 'none';

        fileInput.onchange = async function(e) {
            const file = e.target.files[0];
            if (file && currentChatId) {
                // Здесь будет логика загрузки файла
                showNotification(`Функция загрузки файлов находится в разработке`, 'info');
            }
        };

        document.body.appendChild(fileInput);
        fileInput.click();
        document.body.removeChild(fileInput);
    }

    // Обработка нажатия Enter
    function handleMessageKeyPress(event) {
        if (event.key === 'Enter' && !event.shiftKey) {
            event.preventDefault();
            sendMessage();
        }
    }

    // Фильтрация чатов по поиску
    function filterChats() {
        const searchTerm = document.getElementById('chatSearch').value.toLowerCase();
        const chatItems = document.querySelectorAll('.chat-item');

        chatItems.forEach(item => {
            const text = item.textContent.toLowerCase();
            item.style.display = text.includes(searchTerm) ? 'block' : 'none';
        });
    }

    // ==================== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ====================

    // Получение AntiForgeryToken
    function getAntiForgeryToken() {
        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        return token ? token.value : '';
    }

    // Экранирование HTML
    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Инициалы из имени
    function getInitials(fullName) {
        if (!fullName) return '?';
        const parts = fullName.split(' ');
        if (parts.length >= 2) {
            return (parts[0][0] + parts[1][0]).toUpperCase();
        }
        return parts[0][0].toUpperCase();
    }

    // Форматирование времени
    function formatTime(dateString) {
        if (!dateString) return '';
        const date = new Date(dateString);
        return date.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
    }

    // Форматирование времени сообщения
    function formatMessageTime(dateString) {
        if (!dateString) return '';
        const date = new Date(dateString);
        const now = new Date();
        const diffDays = Math.floor((now - date) / (1000 * 60 * 60 * 24));

        if (diffDays === 0) {
            return date.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
        } else if (diffDays === 1) {
            return 'Вчера';
        } else if (diffDays < 7) {
            return date.toLocaleDateString('ru-RU', { weekday: 'short' });
        } else {
            return date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' });
        }
    }

    // Форматирование даты
    function formatDate(dateStr) {
        const date = new Date(dateStr);
        const today = new Date();
        const yesterday = new Date(today);
        yesterday.setDate(yesterday.getDate() - 1);

        if (date.toDateString() === today.toDateString()) {
            return 'Сегодня';
        } else if (date.toDateString() === yesterday.toDateString()) {
            return 'Вчера';
        } else {
            return date.toLocaleDateString('ru-RU', {
                day: 'numeric',
                month: 'long',
                year: date.getFullYear() !== today.getFullYear() ? 'numeric' : undefined
            });
        }
    }

    // Цвет для чата
    function getChatColor(type) {
        const colors = {
            'private': '#0379D9',
            'group': '#40B624',
            'trip': '#FF6B6B'
        };
        return colors[type] || '#6c757d';
    }

    // Иконка для чата
    function getChatIcon(type) {
        const icons = {
            'private': 'fa-user',
            'group': 'fa-users',
            'trip': 'fa-luggage-cart'
        };
        return icons[type] || 'fa-comments';
    }

    // Цвет для пользователя
    function getUserColor(userId) {
        const colors = ['#0379D9', '#40B624', '#FF6B6B', '#FFC107', '#6F42C1', '#DC3545', '#17A2B8', '#FD7E14'];
        const index = (userId % colors.length + colors.length) % colors.length;
        return colors[index];
    }

    // Показать уведомление
    function showNotification(message, type = 'info') {
        const alertDiv = document.createElement('div');
        alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
        alertDiv.style.top = '20px';
        alertDiv.style.right = '20px';
        alertDiv.style.zIndex = '9999';
        alertDiv.style.minWidth = '300px';
        alertDiv.style.maxWidth = '400px';
        alertDiv.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;

        document.body.appendChild(alertDiv);

        setTimeout(() => {
            if (alertDiv.parentNode) {
                alertDiv.classList.remove('show');
                setTimeout(() => alertDiv.remove(), 150);
            }
        }, 3000);
    }
</script>