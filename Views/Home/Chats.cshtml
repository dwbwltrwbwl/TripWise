                    return;
                }

                console.log('Отправка сообщения в чат:', currentChatId, 'Текст:', text);

                const response = await fetch('/Chats/SendMessage', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        chatId: currentChatId,
                        text: text
                    })
                });

                console.log('Статус ответа:', response.status);

                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('Ошибка ответа:', response.status, errorText);
                    throw new Error(`HTTP ошибка: ${response.status}`);
                }

                const data = await response.json();
                console.log('Ответ сервера:', data);

                if (data.success) {
                    input.value = '';
                    // НЕ добавляем сообщение в UI здесь - оно придет через checkNewMessages
                    // Просто очищаем поле ввода
                } else {
                    showNotification(data.message || 'Ошибка при отправке', 'danger');
                }
            } catch (error) {
                console.error('Ошибка отправки сообщения:', error);
                showNotification('Не удалось отправить сообщение: ' + error.message, 'danger');
            }
        }

