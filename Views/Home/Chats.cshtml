@section Scripts {
    <script src="~/js/friends.js"></script>
    <script>
        console.log('Chats script loaded');
        console.log('Current path:', window.location.pathname);
        console.log('Window width:', window.innerWidth);
        console.log('Is mobile:', window.innerWidth < 768);

        // Глобальные переменные
        let currentUserId = @Json.Serialize(userId);
        let currentChatId = null;
        let selectedUsers = [];
        let messagesRefreshInterval = null;
        let lastMessageId = 0;
        let isSelectingChat = false;
        let chatInfoModal = null;
                let createVoteModal = null;

        // Получаем chatId из URL если есть
        const urlParams = new URLSearchParams(window.location.search);
        const chatIdFromUrl = urlParams.get('chatId');
        console.log('chatId из URL:', chatIdFromUrl);

        if (chatIdFromUrl) {
            // Ждем загрузки чатов
            const checkInterval = setInterval(() => {
                const chatElements = document.querySelectorAll('[data-chat-id]');

                if (chatElements.length > 0) {
                    clearInterval(checkInterval);

                    const existingChatIds = Array.from(chatElements).map(el =>
                        parseInt(el.getAttribute('data-chat-id'))
                    );

                    console.log('Существующие чаты:', existingChatIds);

                    if (existingChatIds.includes(parseInt(chatIdFromUrl))) {
                        // Чат существует, выбираем его
                        selectChat(parseInt(chatIdFromUrl), null, null);
                    } else {
                        // Чат не существует, удаляем параметр из URL
                        console.log('Чат с ID', chatIdFromUrl, 'не найден, удаляем из URL');

                        const url = new URL(window.location);
                        url.searchParams.delete('chatId');
                        window.history.replaceState({}, '', url);

                        // Если есть другие чаты, можно показать уведомление
                        if (existingChatIds.length > 0) {
                            showNotification('Чат не найден, выберите другой чат', 'warning');
                        }
                    }
                }
            }, 100);
        }

        // В начале после загрузки страницы
                        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM Content Loaded');
            console.log('Current User ID:', currentUserId);

            if (currentUserId) {
                console.log('Loading user chats...');
                loadUserChats();

                // Устанавливаем начальное состояние (currentChatId = null)
                updateChatVisibility();

                // Инициализируем модальное окно информации о чате
                const modalElement = document.getElementById('chatInfoModal');
                if (modalElement) {
                    chatInfoModal = new bootstrap.Modal(modalElement);
                }

                // Инициализируем модальное окно создания голосования
                const voteModalElement = document.getElementById('createVoteModal');
                if (voteModalElement) {
                    // Модальное окно будет создано при вызове showCreateVoteModal()
                }
            } else {
                console.log('User not logged in');
            }
        });

        // ==================== ЧАТЫ ====================

        // Загрузка чатов пользователя
                // Загрузка чатов пользователя
        async function loadUserChats() {
            try {
                console.log('Загрузка чатов...');
                const response = await fetch('/Chats/GetUserChats');

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const data = await response.json();
                console.log('Ответ от сервера:', data);

                if (data.success) {
                    console.log('Загруженные чаты:', data.data);

                    // ТОЛЬКО отображаем список чатов
                    renderChatsList(data.data || []);

                    // НИЧЕГО БОЛЬШЕ НЕ ДЕЛАЕМ!
                    // Не меняем display у chatContainer и noChatSelected
                    // Не меняем currentChatId
                    // Не меняем URL

                } else {
                    console.error('Ошибка загрузки чатов:', data.message);
                    showNotification(data.message || 'Не удалось загрузить чаты', 'danger');

                    const chatsList = document.getElementById('chatsList');
                    if (chatsList) {
                        chatsList.innerHTML = `
                            <div class="text-center py-5">
                                <i class="fas fa-comments fa-3x text-muted mb-3"></i>
                                <p class="text-muted">У вас пока нет чатов</p>
                                <button class="btn btn-sm btn-outline-primary" onclick="openNewChatModal()">
                                    <i class="fas fa-plus me-1"></i>Создать чат
                                </button>
                            </div>
                        `;
                    }
                }
            } catch (error) {
                console.error('Ошибка при загрузке чатов:', error);
                showNotification('Не удалось загрузить чаты: ' + error.message, 'danger');

                const chatsList = document.getElementById('chatsList');
                if (chatsList) {
                    chatsList.innerHTML = `
                        <div class="text-center py-5">
                            <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
                            <p class="text-danger">Ошибка загрузки чатов</p>
                            <button class="btn btn-sm btn-outline-primary" onclick="loadUserChats()">
                                <i class="fas fa-sync me-1"></i>Повторить
                            </button>
                        </div>
                    `;
                }
            }
        }

                // Отображение списка чатов
        function renderChatsList(chats) {
            console.log('Рендеринг чатов:', chats);

            // Проверяем каждый чат на наличие id
            chats.forEach(chat => {
                if (!chat.id) {
                    console.error('Чат без id:', chat);
                } else {
                    console.log(`Чат ${chat.id}: ${chat.name}`);
                }
            });

            const chatsList = document.getElementById('chatsList');

            if (!chatsList) {
                console.error('Элемент chatsList не найден');
                return;
            }

            if (!chats || chats.length === 0) {
                chatsList.innerHTML = `
                    <div class="text-center py-5">
                        <i class="fas fa-comments fa-3x text-muted mb-3"></i>
                        <p class="text-muted">У вас пока нет чатов</p>
                        <button class="btn btn-sm btn-outline-primary" onclick="openNewChatModal()">
                            <i class="fas fa-plus me-1"></i>Создать чат
                        </button>
                    </div>
                `;
                return;
            }

            let html = '';

            chats.forEach(chat => {
                if (!chat) return;

                const lastMessage = chat.lastMessage || {
                    text: 'Нет сообщений',
                    sentAt: null,
                    senderName: ''
                };

                const unreadCount = chat.unreadCount || 0;
                const isActive = currentChatId === chat.id;

                const chatName = chat.name || 'Чат';
                const lastMessageTime = lastMessage.sentAt ? formatMessageTime(lastMessage.sentAt) : '';

                // Формируем HTML для каждого чата
                html += `
                    <div class="chat-item ${isActive ? 'active' : ''}" data-chat-id="${chat.id}"
         data-chat-type="${chat.type}">
                        <div class="d-flex align-items-center">
                                    <!-- Аватар чата с обработчиком выбора -->
        <div class="chat-avatar me-3" onclick="selectChat(${chat.id}, event, this)">
            ${chat.avatarPath ?
                `<img src="${chat.avatarPath}" class="rounded-circle" style="width: 45px; height: 45px; object-fit: cover;">` :
                `<div class="avatar-circle" style="background-color: ${getChatColor(chat.type)};">
                    <i class="fas ${getChatIcon(chat.type)}"></i>
                </div>`
            }
        </div>

                            <!-- Информация о чате с обработчиком выбора -->
                            <div class="flex-grow-1" onclick="selectChat(${chat.id}, event, this)" style="min-width: 0;">
                                <div class="d-flex justify-content-between align-items-center">
                                            <h6 class="mb-1 text-truncate" style="max-width: 140px;"
            ondblclick="${chat.type === 'group' && chat.createdById === currentUserId ? 'enableChatRename(' + chat.id + ', this)' : ''}">
            ${escapeHtml(chatName)}
        </h6>
                                    <small class="text-muted flex-shrink-0 ms-2">${lastMessageTime}</small>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <p class="small text-muted mb-0 text-truncate" style="max-width: 160px;">
                                        ${lastMessage.senderName ? `<span class="fw-bold">${escapeHtml(lastMessage.senderName)}:</span> ` : ''}
                                        ${escapeHtml(lastMessage.text || 'Нет сообщений')}
                                    </p>
                                    ${unreadCount > 0 ? `<span class="badge bg-primary rounded-pill ms-2">${unreadCount}</span>` : ''}
                                </div>
                                <small class="text-muted">
                                    <i class="fas fa-users me-1"></i>${chat.memberCount || 0}
                                </small>
                            </div>

                            <!-- Кнопка удаления для групповых чатов (только для создателя) -->
                            ${chat.type === 'group' && chat.createdById === currentUserId ?
                                `<button class="btn btn-sm btn-link text-danger" onclick="deleteChatFromList(${chat.id}, event)" title="Удалить чат">
                                    <i class="fas fa-trash"></i>
                                </button>` : ''
                            }
                        </div>
                    </div>
                `;
            });

            chatsList.innerHTML = html;
        }
                        function updateChatVisibility() {
            const noChatSelected = document.getElementById('noChatSelected');
            const chatContainer = document.getElementById('chatContainer');
            const messageInputContainer = document.getElementById('messageInputContainer');

            if (!noChatSelected || !chatContainer) return;

            if (currentChatId) {
                // Принудительно меняем display через важные стили
                chatContainer.style.setProperty('display', 'flex', 'important');
                noChatSelected.style.setProperty('display', 'none', 'important');
                if (messageInputContainer) messageInputContainer.style.setProperty('display', 'flex', 'important');

                // Дополнительно убираем класс d-flex у заглушки, если он мешает
                noChatSelected.classList.remove('d-flex');
            } else {
                chatContainer.style.setProperty('display', 'none', 'important');
                noChatSelected.style.setProperty('display', 'flex', 'important');
                // Возвращаем класс d-flex для заглушки
                noChatSelected.classList.add('d-flex');
                if (messageInputContainer) messageInputContainer.style.setProperty('display', 'none', 'important');
            }

            console.log('updateChatVisibility:', {
                currentChatId,
                chatContainerDisplay: chatContainer.style.display,
                noChatSelectedDisplay: noChatSelected.style.display
            });
        }
                // Добавьте в начало скрипта для отладки
        function debugVisibility() {
            console.log('currentChatId:', currentChatId);
            console.log('chatContainer display:', document.getElementById('chatContainer')?.style.display);
            console.log('noChatSelected display:', document.getElementById('noChatSelected')?.style.display);
            console.log('chatContainer computed style:', window.getComputedStyle(document.getElementById('chatContainer')).display);
            console.log('noChatSelected computed style:', window.getComputedStyle(document.getElementById('noChatSelected')).display);
        }

        // Вызывайте в консоли для диагностики: debugVisibility()
                // ==================== УДАЛЕНИЕ ЧАТА ====================
                // Функция для удаления чата из списка (предотвращает выбор чата при клике на кнопку)
                function deleteChatFromList(chatId, event) {
            event.stopPropagation();
            event.preventDefault();

            console.log('Удаление чата из списка:', chatId);

            // Сохраняем текущий ID чата для удаления
            currentChatId = chatId;

            // Вызываем функцию удаления
            deleteChat();
        }
                        async function deleteChat() {
            if (!currentChatId) return;

            // Получаем информацию о чате для подтверждения
            const chatTitle = document.getElementById('chatTitle').textContent;

            // Спрашиваем подтверждение
            const confirmMessage = `Вы уверены, что хотите удалить чат "${chatTitle}"?\n\n` +
                `- Для группового чата: удалится весь чат для всех участников\n` +
                `- Для личного чата: вы просто покинете чат`;

            if (!confirm(confirmMessage)) return;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch(`/Chats/DeleteChat?chatId=${currentChatId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    }
                });

                const data = await response.json();
                console.log('Результат удаления чата:', data);

                if (data.success) {
                    showNotification(data.message || 'Чат удален', 'success');

                    // Сбрасываем текущий чат
                    currentChatId = null;

                    // ТОЛЬКО вызываем updateChatVisibility - она сама все сделает
                    updateChatVisibility();

                    // Удаляем chatId из URL
                    const url = new URL(window.location);
                    url.searchParams.delete('chatId');
                    window.history.replaceState({}, '', url);

                    // Перезагружаем список чатов
                    await loadUserChats();
                } else {
                    showNotification(data.message || 'Ошибка при удалении чата', 'danger');
                }
            } catch (error) {
                console.error('Ошибка при удалении чата:', error);
                showNotification('Не удалось удалить чат: ' + error.message, 'danger');
            }
        }

        // Обертка для fetch запросов
        async function fetchWithErrorHandling(url, options = {}) {
            try {
                const response = await fetch(url, {
                    ...options,
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken(),
                        ...options.headers
                    }
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const data = await response.json();
                return data;
            } catch (error) {
                console.error(`Fetch error for ${url}:`, error);
                throw error;
            }
        }
                        // Выбор чата
        async function selectChat(chatId, event, element) {
            // Защита от повторных вызовов
            if (isSelectingChat) {
                console.log('Уже выбираем чат, пропускаем');
                return;
            }

            // ВАЖНО: проверяем chatId
            if (!chatId || chatId === undefined || chatId === null) {
                console.error('selectChat: chatId не передан или равен null/undefined');
                showNotification('Ошибка: ID чата не указан', 'danger');
                return;
            }

            console.log('selectChat вызван с chatId:', chatId, 'тип:', typeof chatId);

            // Предотвращаем стандартное поведение ссылки
            if (event) event.preventDefault();

            // Проверяем, не выбран ли уже этот чат
            if (currentChatId === chatId) {
                console.log('Чат уже выбран');
                return;
            }

            isSelectingChat = true;

            try {
                // Проверяем, существует ли элемент чата в DOM
                const chatElement = element || document.querySelector(`[data-chat-id="${chatId}"]`);
                if (!chatElement) {
                    console.error('Чат с ID', chatId, 'не найден в DOM');
                    showNotification('Чат не найден', 'warning');
                    return;
                }

                // Обновляем URL без перезагрузки страницы
                const url = new URL(window.location);
                url.searchParams.set('chatId', chatId);
                window.history.pushState({}, '', url);

                // Убираем активный класс у всех чатов
                document.querySelectorAll('.chat-item').forEach(el => {
                    el.classList.remove('active');
                });

                // Добавляем активный класс выбранному
                chatElement.classList.add('active');

                // Устанавливаем currentChatId и обновляем видимость
                currentChatId = chatId;
