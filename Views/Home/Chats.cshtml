        // Форматирование размера файла
                function formatFileSize(bytes) {
            if (bytes === 0 || !bytes) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }
                // ==================== ОТОБРАЖЕНИЕ ВЛОЖЕНИЙ ====================

        function renderAttachment(file) {
            if (!file || !file.fileUrl) return '';

            const fileExt = file.fileName?.split('.').pop()?.toLowerCase();
            const fileType = file.fileType || '';

            // Определяем, является ли файл изображением
            const isImage = fileType.startsWith('image/') || ['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(fileExt);

            // Создаем URL для скачивания
            const fileName = encodeURIComponent(file.fileName || 'file');

            if (isImage) {
                return `
                    <div class="attachment-container">
                        <a href="${file.fileUrl}" target="_blank" class="image-preview">
                            <img src="${file.fileUrl}" alt="${escapeHtml(file.fileName)}"
                                 style="max-width: 200px; max-height: 200px; border-radius: 5px; cursor: pointer;">
                        </a>
                        <div class="attachment-actions mt-1">
                            <a href="${file.fileUrl}" download="${fileName}" class="btn btn-sm btn-outline-primary" title="Скачать">
                                <i class="fas fa-download"></i> Скачать
                            </a>
                        </div>
                    </div>
                `;
            } else {
                // Определяем иконку по расширению или типу
                let fileIcon = 'fa-file';
                let fileColor = '';

                if (fileType.includes('pdf') || fileExt === 'pdf') {
                    fileIcon = 'fa-file-pdf';
                    fileColor = 'text-danger';
                } else if (fileType.includes('doc') || ['doc', 'docx'].includes(fileExt)) {
                    fileIcon = 'fa-file-word';
                    fileColor = 'text-primary';
                } else if (fileType.includes('xls') || ['xls', 'xlsx'].includes(fileExt)) {
                    fileIcon = 'fa-file-excel';
                    fileColor = 'text-success';
                } else if (fileType.includes('zip') || fileType.includes('rar') || fileType.includes('7z') ||
                           ['zip', 'rar', '7z'].includes(fileExt)) {
                    fileIcon = 'fa-file-archive';
                    fileColor = 'text-warning';
                } else if (fileType.includes('text') || fileExt === 'txt') {
                    fileIcon = 'fa-file-alt';
                    fileColor = 'text-secondary';
                }

                return `
                    <div class="attachment-container">
                        <a href="${file.fileUrl}" target="_blank" class="file-attachment d-flex align-items-center p-2 bg-light rounded text-decoration-none">
                            <i class="fas ${fileIcon} ${fileColor} me-2 fa-lg"></i>
                            <span class="flex-grow-1 text-truncate">${escapeHtml(file.fileName)}</span>
                            <small class="text-muted ms-2">${formatFileSize(file.fileSize)}</small>
                        </a>
                        <div class="attachment-actions mt-1">
                            <a href="${file.fileUrl}" download="${fileName}" class="btn btn-sm btn-outline-primary" title="Скачать">
                                <i class="fas fa-download"></i> Скачать
                            </a>
                        </div>
                    </div>
                `;
            }
