                console.log('Нужно загрузить более старые сообщения для перехода к закрепленному');
            }
        }

                        function displayPinnedMessages(globalPin, userPin) {
            const chatHeader = document.getElementById('chatHeader');
            if (!chatHeader) return;

            // Удаляем старые контейнеры
            const oldContainers = document.querySelectorAll('.pinned-message-container');
            oldContainers.forEach(container => container.remove());

            // Если есть оба закрепленных сообщения, показываем оба
            if (globalPin) {
                displayPinnedMessage(globalPin, true);
            }
            if (userPin) {
                displayPinnedMessage(userPin, false);
            }
        }

        function displayPinnedMessage(message, isGlobal) {
    const chatHeader = document.getElementById('chatHeader');
    if (!chatHeader) return;

    const pinnedContainer = document.createElement('div');
    pinnedContainer.className = `pinned-message-container bg-light p-2 border-bottom ${isGlobal ? 'global-pin' : 'user-pin'}`;
    pinnedContainer.style.cursor = 'pointer'; // Добавляем указатель мыши
    pinnedContainer.setAttribute('data-pinned-message-id', message.id);
    
    pinnedContainer.innerHTML = `
        <div class="d-flex align-items-center">
            <i class="fas fa-thumbtack ${isGlobal ? 'text-primary' : 'text-success'} me-2" style="transform: rotate(45deg);"></i>
            <div class="flex-grow-1" onclick="scrollToPinnedMessage(${message.id}, event)">
                <small class="text-muted">${isGlobal ? 'Закреплено для всех' : 'Закреплено для вас'}</small>
                <div class="d-flex align-items-center">
                    <span class="fw-bold me-2">${escapeHtml(message.senderName)}:</span>
                    <span class="text-truncate" style="max-width: 300px;">${escapeHtml(message.text || 'Файл')}</span>
                </div>
                <small class="text-muted">
                    ${isGlobal ? `Закрепил(а) ${escapeHtml(message.pinnedBy)}` : 'Закреплено вами'} • ${formatTime(message.pinnedAt)}
                </small>
            </div>
            <button class="btn btn-sm btn-link text-danger" onclick="unpinMessage(${currentChatId}, ${isGlobal}, event)" title="Открепить">
                <i class="fas fa-times"></i>
            </button>
        </div>
    `;

    // Добавляем эффект наведения
    pinnedContainer.addEventListener('mouseenter', () => {
        pinnedContainer.style.backgroundColor = '#e9ecef';
    });
    
    pinnedContainer.addEventListener('mouseleave', () => {
        pinnedContainer.style.backgroundColor = '#f8f9fa';
    });

    chatHeader.after(pinnedContainer);
}

