                async function handleChatAvatarSelect(event) {
            const file = event.target.files[0];
            if (!file) return;

            // Проверка размера (5 МБ)
            if (file.size > 5 * 1024 * 1024) {
                showNotification('Размер файла не должен превышать 5 МБ', 'danger');
                return;
            }

            // Показываем индикатор загрузки
            showNotification('Загрузка аватара...', 'info');

            const formData = new FormData();
            formData.append('file', file);

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch(`/Chats/UploadChatAvatar?chatId=${currentChatId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });

                const data = await response.json();
                console.log('Результат загрузки аватара:', data);

                if (data.success) {
                    showNotification('Аватар чата обновлен', 'success');

                    // Просто перезагружаем информацию о чате - она сама обновит аватар
                    await loadChatInfo(currentChatId);

                    // Также обновляем аватар в списке чатов
                    updateChatAvatarInList(currentChatId, data.data);

                    // Перезагружаем список чатов для синхронизации
                    await loadUserChats();
                } else {
                    showNotification(data.message || 'Ошибка при загрузке аватара', 'danger');
                }
            } catch (error) {
                console.error('Ошибка при загрузке аватара:', error);
                showNotification('Не удалось загрузить аватар: ' + error.message, 'danger');
            }
        }

