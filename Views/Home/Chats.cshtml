                // Проверка новых сообщений
                                        async function checkNewMessages(chatId) {
            try {
                const response = await fetch(`/Chats/GetNewMessages?chatId=${chatId}&lastMessageId=${lastMessageId}`);
                const data = await response.json();

                if (data.success && data.data && data.data.length > 0) {
                    // Получаем существующие ID сообщений в UI
                    const existingMessageIds = new Set();
                    document.querySelectorAll('.message').forEach(msgElement => {
                        const msgId = msgElement.getAttribute('data-message-id');
                        if (msgId) existingMessageIds.add(parseInt(msgId));
                    });

                    // Фильтруем только новые сообщения
                    const newMessages = data.data.filter(msg => !existingMessageIds.has(msg.id));

                    if (newMessages.length > 0) {
                        // Сортируем по времени
                        newMessages.sort((a, b) => {
                            const dateA = normalizeDate(a.sentAt);
                            const dateB = normalizeDate(b.sentAt);
                            return dateA - dateB;
                        });

                        // Получаем последнее сообщение в чате для проверки разделителя
                        const lastMessage = document.querySelector('.message:last-child');
                        let lastMessageTime = null;

                        if (lastMessage) {
                            const prevMessage = Array.from(document.querySelectorAll('.message')).pop();
                            if (prevMessage) {
                                const prevMsgId = prevMessage.getAttribute('data-message-id');
                                const prevMsg = data.data.find(m => m.id === parseInt(prevMsgId));
                                if (prevMsg) {
                                    lastMessageTime = prevMsg.sentAt;
                                }
                            }
                        }

                        // Добавляем сообщения
                        newMessages.forEach((msg, index) => {
                            // Проверяем нужен ли разделитель
                            if (index === 0 && lastMessageTime) {
                                if (shouldShowDateSeparator(lastMessageTime, msg.sentAt)) {
                                    addDateSeparator(msg.sentAt);
                                }
                            } else if (index > 0) {
                                if (shouldShowDateSeparator(newMessages[index - 1].sentAt, msg.sentAt)) {
                                    addDateSeparator(msg.sentAt);
                                }
                            }

                            // Подготавливаем attachments
                            if (msg.attachments) {
                                // Уже в правильном формате
                            } else if (msg.attachmentUrl) {
                                msg.attachments = [{
                                    fileName: msg.attachmentName,
                                    fileUrl: msg.attachmentUrl,
                                    fileSize: msg.attachmentSize,
                                    fileType: msg.attachmentType
                                }];
                            }

                            appendMessageToUI(msg);
                        });

                        await markMessagesAsRead(chatId);

                        // Обновляем lastMessageId
                        lastMessageId = Math.max(...newMessages.map(m => m.id), lastMessageId);
                    }
                }
            } catch (error) {
                console.error('Ошибка проверки новых сообщений:', error);
            }
        }
                function addDateSeparator(dateString) {
            const messagesList = document.getElementById('messagesList');
            const dateSeparator = document.createElement('div');
            dateSeparator.className = 'date-separator';
            dateSeparator.innerHTML = `<span>${formatDate(dateString)}</span>`;
            messagesList.appendChild(dateSeparator);
        }
