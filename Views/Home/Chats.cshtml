                        async function deleteChat() {
            if (!currentChatId) return;

            // Получаем информацию о чате для подтверждения
            const chatTitle = document.getElementById('chatTitle').textContent;

            // Спрашиваем подтверждение
            const confirmMessage = `Вы уверены, что хотите удалить чат "${chatTitle}"?\n\n` +
                `- Для группового чата: удалится весь чат для всех участников\n` +
                `- Для личного чата: вы просто покинете чат`;

            if (!confirm(confirmMessage)) return;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch(`/Chats/DeleteChat?chatId=${currentChatId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    }
                });

                const data = await response.json();
