        function getUserColor(userId) {
            const colors = ['#0379D9', '#40B624', '#FF6B6B', '#FFC107', '#6F42C1', '#DC3545', '#17A2B8', '#FD7E14'];
            const index = (userId % colors.length + colors.length) % colors.length;
            return colors[index];
        }

        function showNotification(message, type = 'info') {
            const alertDiv = document.createElement('div');
