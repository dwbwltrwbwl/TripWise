            "Сочи": "AER",
            "Казань": "KZN",
            "Екатеринбург": "SVX",
            "Краснодар": "KRR",
            "Минеральные Воды": "MRV",
            "Симферополь": "SIP",
            "Калининград": "KGD",
            "Новосибирск": "OVB",
            "Тюмень": "TJM"
        };

        return cityCodes[cityName] || "---";
    }

