    // Функция для выбора популярного направления
    function selectPopularDestination(fromCity, toCity) {
        console.log(`🎯 Выбрано направление: ${fromCity} → ${toCity}`);

        // Заполняем поля формы
        document.getElementById('departureCity').value = `${fromCity} (${getCityCode(fromCity)})`;
        document.getElementById('arrivalCity').value = `${toCity} (${getCityCode(toCity)})`;

        // Устанавливаем даты (вылет через 3 дня, возврат через 7 дней)
        const today = new Date();
        const departureDate = new Date(today);
        departureDate.setDate(today.getDate() + 3);

        const returnDate = new Date(today);
        returnDate.setDate(today.getDate() + 10);

        document.getElementById('departureDate').value = departureDate.toISOString().split('T')[0];
        document.getElementById('returnDate').value = returnDate.toISOString().split('T')[0];

        // Прокручиваем к форме
        document.getElementById('flightSearchForm').scrollIntoView({
            behavior: 'smooth'
        });

        // Показываем сообщение
        showAlert(`Направление ${fromCity} → ${toCity} добавлено в форму поиска`, 'success');
    }

    // Вспомогательная функция для получения кода города
    function getCityCode(cityName) {
        const cityCodes = {
            "Москва": "MOW",
            "Санкт-Петербург": "LED",
            "Сочи": "AER",
            "Казань": "KZN",
            "Екатеринбург": "SVX",
            "Краснодар": "KRR",
            "Минеральные Воды": "MRV",
            "Симферополь": "SIP",
            "Калининград": "KGD",
            "Новосибирск": "OVB"
        };

        return cityCodes[cityName] || "---";
    }

        async function testDirectApiCall() {
        console.log('=== ТЕСТИРОВАНИЕ ПРЯМОГО ВЫЗОВА API ===');

        const testData = {
            departureCity: 'Москва',
            arrivalCity: 'Санкт-Петербург',
            departureDate: new Date().toISOString().split('T')[0],
            returnDate: new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
            passengers: 2,
            class: 'economy',
            tripType: 'round'
        };

        console.log('Отправляемые данные:', testData);
        console.log('returnDate:', testData.returnDate);

        try {
            const response = await fetch('/api/flights/search', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(testData)
            });

            const result = await response.json();
            console.log('Ответ от API:', result);

            if (result.success) {
                console.log('Всего рейсов:', result.flights.length);
                console.log('Рейсы туда:', result.flights.filter(f => !f.isReturn).length);
                console.log('Рейсы обратно:', result.flights.filter(f => f.isReturn).length);
            }
        } catch (error) {
            console.error('Ошибка теста:', error);
        }
    }

