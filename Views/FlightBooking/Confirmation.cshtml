@model TripWise.Models.ViewModels.FlightBookingConfirmationViewModel
@{
    ViewData["Title"] = "Бронирование подтверждено";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Успешное бронирование -->
            <div class="text-center mb-5">
                <div class="success-animation mb-4">
                    <i class="fas fa-check-circle text-success" style="font-size: 5rem;"></i>
                </div>
                <h1 class="display-4 fw-bold text-success mb-3">Билет подтвержден!</h1>
                <p class="lead text-muted">Номер бронирования: <strong class="text-dark">@Model.BookingReference</strong></p>
                <p class="lead text-muted">Номер билета: <strong class="text-dark">@Model.TicketNumber</strong></p>
                <p class="text-muted">Билет отправлен на вашу почту <strong>@Model.ContactEmail</strong></p>
            </div>

            <!-- Детали бронирования -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h3 class="section-subtitle mb-0">
                        <i class="fas fa-plane text-primary me-2"></i>
                        Детали перелета
                    </h3>
                </div>
                <div class="card-body p-4">
                    <!-- Авиакомпания -->
                    <div class="text-center mb-4">
                        <h2 class="airline-title">@Model.Airline</h2>
                        <p class="text-muted">Рейс @Model.FlightNumber</p>
                    </div>

                    <!-- Рейс туда -->
                    <div class="flight-section mb-4">
                        <h5 class="text-primary mb-3">
                            <i class="fas fa-plane-departure me-2"></i>Вылет
                        </h5>
                        <div class="row align-items-center">
                            <div class="col-5 text-end">
                                <div class="fw-bold fs-3">@Model.DepartureDateTime.ToString("HH:mm")</div>
                                <div class="fw-semibold">@Model.DepartureCity</div>
                                <div class="text-muted">@Model.DepartureAirport</div>
                                <div class="text-muted small">@Model.DepartureDateTime.ToString("dd.MM.yyyy")</div>
                            </div>
                            <div class="col-2 text-center">
                                <i class="fas fa-plane text-primary fa-lg"></i>
                            </div>
                            <div class="col-5 text-start">
                                <div class="fw-bold fs-3">@Model.ArrivalDateTime.ToString("HH:mm")</div>
                                <div class="fw-semibold">@Model.ArrivalCity</div>
                                <div class="text-muted">@Model.ArrivalAirport</div>
                                <div class="text-muted small">@Model.ArrivalDateTime.ToString("dd.MM.yyyy")</div>
                            </div>
                        </div>
                    </div>

                    <!-- Обратный рейс (если есть) -->
                    @if (Model.IsRoundTrip && !string.IsNullOrEmpty(Model.ReturnFlightNumber))
                    {
                        <div class="flight-section mb-4 pt-4 border-top">
                            <h5 class="text-success mb-3">
                                <i class="fas fa-plane-arrival me-2"></i>Обратный рейс @Model.ReturnFlightNumber
                            </h5>
                            <div class="row align-items-center">
                                <div class="col-5 text-end">
                                    <div class="fw-bold fs-3">@Model.ReturnDepartureDateTime.Value.ToString("HH:mm")</div>
                                    <div class="fw-semibold">@Model.ArrivalCity</div>
                                    <div class="text-muted">@Model.ArrivalAirport</div>
                                    <div class="text-muted small">@Model.ReturnDepartureDateTime.Value.ToString("dd.MM.yyyy")</div>
                                </div>
                                <div class="col-2 text-center">
                                    <i class="fas fa-plane text-success fa-lg"></i>
                                </div>
                                <div class="col-5 text-start">
                                    <div class="fw-bold fs-3">@Model.ReturnArrivalDateTime.Value.ToString("HH:mm")</div>
                                    <div class="fw-semibold">@Model.DepartureCity</div>
                                    <div class="text-muted">@Model.DepartureAirport</div>
                                    <div class="text-muted small">@Model.ReturnArrivalDateTime.Value.ToString("dd.MM.yyyy")</div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Информация о пассажирах и багаже -->
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="info-section p-3 bg-light rounded">
                                <h6 class="fw-bold mb-3">
                                    <i class="fas fa-users text-primary me-2"></i>
                                    Пассажиры
                                </h6>
                                <p class="mb-2"><strong>Количество:</strong> @Model.Passengers</p>
                                <p class="mb-2"><strong>Класс:</strong> @Model.FlightClass</p>
                                <p class="mb-0"><strong>Места:</strong> @Model.SeatNumbers</p>
                            </div>
                        </div>
                        
                    </div>

                    <!-- Контактная информация -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="info-section p-3 bg-light rounded">
                                <h6 class="fw-bold mb-3">
                                    <i class="fas fa-address-card text-primary me-2"></i>
                                    Контактная информация
                                </h6>
                                <p class="mb-2"><strong>Имя:</strong> @Model.ContactName</p>
                                <p class="mb-2"><strong>Email:</strong> @Model.ContactEmail</p>
                                <p class="mb-0"><strong>Телефон:</strong> @Model.ContactPhone</p>
                            </div>
                        </div>
                    </div>

                    <!-- Стоимость -->
                    <div class="price-info mt-4 p-3 bg-success bg-opacity-10 rounded">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold">Итого к оплате:</span>
                            <span class="fw-bold fs-3 text-success">@Model.TotalPrice.ToString("N0") @Model.Currency</span>
                        </div>
                        <p class="text-muted small mt-2 mb-0">
                            <i class="fas fa-info-circle me-1"></i>
                            @Model.Price.ToString("N0") @Model.Currency × @Model.Passengers пасс.
                            @if (Model.IsRoundTrip)
                            {
                                <span> × 2 (туда и обратно)</span>
                            }
                        </p>
                    </div>

                    <!-- Информация о бронировании -->
                    <div class="booking-info mt-3 small text-muted">
                        <p class="mb-0">Номер бронирования: @Model.BookingReference</p>
                        <p class="mb-0">Номер билета: @Model.TicketNumber</p>
                        <p class="mb-0">Дата бронирования: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                        <p class="mb-0">Статус: <span class="badge bg-success">@Model.Status</span></p>
                    </div>
                </div>
            </div>

            <!-- Важная информация -->
            <div class="alert alert-info border-0 rounded-lg mb-4">
                <div class="d-flex">
                    <i class="fas fa-info-circle fa-2x text-info me-3"></i>
                    <div>
                        <h6 class="alert-heading mb-2">Важная информация</h6>
                        <ul class="mb-0 small">
                            <li>Регистрация на рейс открывается за 24 часа до вылета</li>
                            <li>Прибыть в аэропорт рекомендуется за 2 часа до вылета</li>
                            <li>При себе необходимо иметь документ, указанный при бронировании</li>
                            <li>При отмене менее чем за 24 часа может взиматься штраф</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Кнопки действий -->
            <div class="d-flex justify-content-between align-items-center mt-4">
                <a href="@Url.Action("MyBookings", "FlightBooking")" class="btn btn-outline-primary btn-lg">
                    <i class="fas fa-list me-2"></i>
                    Мои бронирования
                </a>
                <div>
                    <a href="@Url.Action("DownloadTicket", "FlightBooking", new { bookingId = Model.BookingId })" class="btn btn-outline-success btn-lg me-2">
                        <i class="fas fa-download me-2"></i>
                        Скачать билет
                    </a>
                    <a href="@Url.Action("Index", "Flights")" class="btn btn-primary btn-lg">
                        <i class="fas fa-search me-2"></i>
                        Новый поиск
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .airline-title {
        font-family: 'Nunito', sans-serif;
        font-weight: 700;
        font-size: 2rem;
        color: #0379D9;
        margin: 0;
    }

    .section-subtitle {
        font-family: 'Nunito', sans-serif;
        font-weight: 600;
        font-size: 1.3rem;
        color: #334155;
        margin: 0;
        display: flex;
        align-items: center;
    }

    .card {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    }

    .flight-section {
        padding: 20px;
        background: #f8fafc;
        border-radius: 12px;
    }

    .info-section {
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        height: 100%;
    }

    .btn {
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        font-family: 'Nunito', sans-serif;
        padding: 12px 24px;
    }

    .btn-primary {
        background: #0379D9;
        border: none;
        box-shadow: 0 4px 12px rgba(3, 121, 217, 0.2);
    }

        .btn-primary:hover {
            background: #0356a8;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(3, 121, 217, 0.3);
        }

    .btn-outline-primary {
        border: 2px solid #0379D9;
        color: #0379D9;
    }

        .btn-outline-primary:hover {
            background: #0379D9;
            color: white;
        }

    .btn-outline-success {
        border: 2px solid #40B624;
        color: #40B624;
    }

        .btn-outline-success:hover {
            background: #40B624;
            color: white;
        }

    .badge {
        font-family: 'Nunito', sans-serif;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 8px;
    }

        .badge.bg-success {
            background: #40B624 !important;
        }

    @@media (max-width: 768px) {
        .airline-title {
            font-size: 1.5rem;
        }
    }
</style>