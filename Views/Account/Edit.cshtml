@model TripWise.Models.ViewModels.EditProfileViewModel
@{
    ViewData["Title"] = "Редактирование профиля";
}

<div class="container mt-4">

    <!-- Заголовок страницы (НЕ МЕНЯЕМ) -->
    <div class="page-header-section mb-5">
        <div class="page-header-icon">
            <i class="fas fa-user-edit"></i>
        </div>
        <div>
            <h1 class="page-title">
                Редактирование профиля
            </h1>
            <p class="page-subtitle">Обновите информацию о себе</p>
        </div>
    </div>

    <div class="row">

        <!-- Левая колонка — аватар (визуально) -->
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <div class="avatar-circle-lg mb-3">
                        <div class="avatar-initials-lg">
                            @Model.FirstName[0].ToString().ToUpper()@Model.LastName[0].ToString().ToUpper()
                        </div>
                    </div>

                    <p class="text-muted small mb-0">
                        Загрузка изображения будет добавлена позже
                    </p>
                </div>
            </div>
        </div>

        <!-- Правая колонка — форма -->
        <div class="col-lg-8">
            <form asp-action="Edit" method="post" class="card border-0 shadow-sm">

                @Html.AntiForgeryToken()

                <div class="card-header bg-white border-0 py-3">
                    <h5 class="section-subtitle mb-0">
                        <i class="fas fa-info-circle text-primary me-2"></i>
                        Основная информация
                    </h5>
                </div>

                <div class="card-body p-4">
                    <div class="row g-3">

                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="LastName" class="form-control" placeholder="Фамилия" />
                                <label asp-for="LastName">Фамилия</label>
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="FirstName" class="form-control" placeholder="Имя" />
                                <label asp-for="FirstName">Имя</label>
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="MiddleName" class="form-control" placeholder="Отчество" />
                                <label asp-for="MiddleName">Отчество</label>
                                <span asp-validation-for="MiddleName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Email" class="form-control" placeholder="Email" />
                                <label asp-for="Email">Email</label>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Age" type="number" class="form-control" placeholder="Возраст" />
                                <label asp-for="Age">Возраст</label>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="card-footer bg-white border-0 py-3 px-4">
                    <div class="d-flex justify-content-between">
                        <a asp-action="Profile" class="btn btn-outline-secondary">
                            Назад
                        </a>
                        <button type="submit" class="btn btn-primary">
                            Сохранить изменения
                        </button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

<style>
    /* Стили для заголовка страницы */
    .page-header-section {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 25px 30px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
    }

        .page-header-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 6px;
            height: 100%;
            background: linear-gradient(to bottom, #0379D9, #40B624);
        }

    .page-header-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #0379D9, #40B624);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        box-shadow: 0 4px 15px rgba(3, 121, 217, 0.2);
        flex-shrink: 0;
    }

    .page-title {
        font-family: 'Nunito', sans-serif;
        font-weight: 800;
        font-size: 2.5rem;
        color: #0379D9;
        margin: 0 0 8px 0;
        line-height: 1.2;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 1.1rem;
        margin: 0;
        max-width: 600px;
    }

    .section-subtitle {
        font-family: 'Nunito', sans-serif;
        font-weight: 600;
        font-size: 1.3rem;
        color: #334155;
        margin: 0;
        display: flex;
        align-items: center;
    }

    /* Аватар для редактирования */
    .avatar-circle-lg {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0379D9, #40B624);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        box-shadow: 0 4px 15px rgba(3, 121, 217, 0.2);
        position: relative;
        overflow: hidden;
        border: 4px solid white;
    }

    .avatar-initials-lg {
        color: white;
        font-size: 4rem;
        font-weight: 700;
        font-family: 'Nunito', sans-serif;
        text-transform: uppercase;
    }

    .avatar-actions {
        max-width: 200px;
        margin: 0 auto;
    }

    /* Форма */
    .form-floating > .form-control,
    .form-floating > .form-select {
        height: calc(3.5rem + 2px);
        padding: 1rem 0.75rem;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        font-family: 'Nunito', sans-serif;
    }

    .form-floating > label {
        padding: 1rem 0.75rem;
        color: #64748b;
        font-family: 'Nunito', sans-serif;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #0379D9;
        box-shadow: 0 0 0 0.2rem rgba(3, 121, 217, 0.25);
    }

    .form-check-input {
        width: 2.5em;
        height: 1.25em;
        margin-right: 0.5rem;
        cursor: pointer;
    }

        .form-check-input:checked {
            background-color: #0379D9;
            border-color: #0379D9;
        }

    .form-check-label {
        font-family: 'Nunito', sans-serif;
        font-weight: 500;
        cursor: pointer;
    }

    /* Кнопки */
    .btn {
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        font-family: 'Nunito', sans-serif;
        padding: 10px 20px;
        cursor: pointer;
    }

    .btn-primary {
        background: linear-gradient(135deg, #0379D9, #40B624);
        border: none;
        box-shadow: 0 4px 12px rgba(3, 121, 217, 0.2);
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(3, 121, 217, 0.3);
            background: linear-gradient(135deg, #0379D9, #40B624);
        }

    .btn-secondary {
        background: linear-gradient(135deg, #6c757d, #495057);
        border: none;
        box-shadow: 0 4px 12px rgba(108, 117, 125, 0.2);
    }

        .btn-secondary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(108, 117, 125, 0.3);
            background: linear-gradient(135deg, #6c757d, #495057);
        }

    .btn-outline-secondary {
        border: 2px solid #e2e8f0;
        color: #64748b;
        background: white;
    }

        .btn-outline-secondary:hover {
            background: #f8fafc;
            border-color: #94a3b8;
            color: #334155;
        }

    .btn-outline-danger {
        border: 2px solid #fee2e2;
        color: #dc2626;
        background: white;
    }

        .btn-outline-danger:hover {
            background: #fef2f2;
            border-color: #fca5a5;
            color: #dc2626;
        }

    /* Карточка */
    .card {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    }

    hr {
        opacity: 0.1;
        margin: 2rem 0;
    }

    /* Адаптивность */
    @@media (max-width: 768px) {
        .page-header-section {
            flex-direction: column;
            text-align: center;
            padding: 20px;
            gap: 15px;
        }

            .page-header-section::before {
                width: 100%;
                height: 6px;
                top: 0;
                left: 0;
                background: linear-gradient(to right, #0379D9, #40B624);
            }

        .page-header-icon {
            width: 60px;
            height: 60px;
            font-size: 1.75rem;
        }

        .page-title {
            font-size: 2rem;
        }

        .avatar-circle-lg {
            width: 120px;
            height: 120px;
        }

        .avatar-initials-lg {
            font-size: 3rem;
        }

        .section-subtitle {
            font-size: 1.2rem;
        }

        .card-footer .d-flex {
            flex-direction: column;
            gap: 10px;
        }

            .card-footer .d-flex div {
                width: 100%;
            }

            .card-footer .d-flex .btn {
                width: 100%;
                margin-bottom: 5px;
            }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.75rem;
        }

        .form-floating > .form-control,
        .form-floating > .form-select {
            height: calc(3rem + 2px);
            padding: 0.75rem;
        }

        .form-floating > label {
            padding: 0.75rem;
        }
    }
</style>