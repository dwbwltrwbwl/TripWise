@{
    ViewData["Title"] = "Смена пароля";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="page-header-section mb-5">
                <div class="page-header-icon">
                    <i class="fas fa-key text-white"></i>
                </div>
                <div>
                    <h1 class="page-title">
                        Смена пароля
                    </h1>
                    <p class="page-subtitle">Обновите пароль для безопасности вашего аккаунта</p>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h3 class="section-subtitle mb-0">
                        <i class="fas fa-shield-alt text-primary me-2"></i>
                        Установка нового пароля
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form id="changePasswordForm" method="post" asp-action="ChangePassword">
                        @Html.AntiForgeryToken()

                        <!-- Текущий пароль -->
                        <div class="mb-4">
                            <label for="currentPassword" class="form-label fw-semibold">
                                <i class="fas fa-lock me-2"></i>Текущий пароль
                            </label>
                            <div class="input-group">
                                <input type="password" class="form-control form-control-lg" id="currentPassword"
                                       name="currentPassword" required placeholder="Введите текущий пароль">
                                <button class="btn btn-outline-secondary" type="button" id="toggleCurrentPassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Новый пароль -->
                        <div class="mb-4">
                            <label for="newPassword" class="form-label fw-semibold">
                                <i class="fas fa-key me-2"></i>Новый пароль
                            </label>
                            <div class="input-group">
                                <input type="password" class="form-control form-control-lg" id="newPassword"
                                       name="newPassword" required placeholder="Введите новый пароль">
                                <button class="btn btn-outline-secondary" type="button" id="toggleNewPassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="password-strength mt-2">
                                <div class="progress" style="height: 5px;">
                                    <div class="progress-bar" id="passwordStrengthBar" style="width: 0%"></div>
                                </div>
                                <small class="text-muted" id="passwordStrengthText">Начните вводить пароль</small>
                            </div>
                            <div id="passwordRequirements" class="mt-2">
                                <small class="text-muted">Пароль должен содержать:</small>
                                <ul class="list-unstyled mt-1">
                                    <li id="reqLength" class="text-danger small"><i class="fas fa-times me-1"></i>Минимум 8 символов</li>
                                    <li id="reqUppercase" class="text-danger small"><i class="fas fa-times me-1"></i>Одну заглавную букву</li>
                                    <li id="reqLowercase" class="text-danger small"><i class="fas fa-times me-1"></i>Одну строчную букву</li>
                                    <li id="reqNumber" class="text-danger small"><i class="fas fa-times me-1"></i>Одну цифру</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Подтверждение пароля -->
                        <div class="mb-4">
                            <label for="confirmPassword" class="form-label fw-semibold">
                                <i class="fas fa-check-circle me-2"></i>Подтвердите новый пароль
                            </label>
                            <div class="input-group">
                                <input type="password" class="form-control form-control-lg" id="confirmPassword"
                                       required placeholder="Повторите новый пароль">
                                <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="mt-2">
                                <small id="passwordMatch" class="text-danger d-none">
                                    <i class="fas fa-times me-1"></i>Пароли не совпадают
                                </small>
                                <small id="passwordSuccess" class="text-success d-none">
                                    <i class="fas fa-check me-1"></i>Пароли совпадают
                                </small>
                            </div>
                        </div>

                        <!-- Рекомендации -->
                        <div class="alert alert-info border-0 rounded-lg mb-4">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-lightbulb fa-2x text-info me-3"></i>
                                <div>
                                    <h6 class="alert-heading mb-2">Рекомендации по безопасности</h6>
                                    <ul class="mb-0 small">
                                        <li>Используйте уникальный пароль, который не применяется на других сайтах</li>
                                        <li>Длина пароля должна быть не менее 8 символов</li>
                                        <li>Используйте сочетание букв, цифр и специальных символов</li>
                                        <li>Регулярно обновляйте пароль для повышения безопасности</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- Кнопки -->
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-controller="Account" asp-action="MyAccount" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Назад
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg" id="submitBtn" disabled>
                                <i class="fas fa-save me-2"></i>Сохранить новый пароль
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Стили для заголовка страницы */
    .page-header-section {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 25px 30px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
    }

        .page-header-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 6px;
            height: 100%;
            background: linear-gradient(to bottom, #0379D9, #40B624);
        }

    .page-header-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #0379D9, #40B624);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        box-shadow: 0 4px 15px rgba(3, 121, 217, 0.2);
        flex-shrink: 0;
    }

        .page-header-icon i {
            color: white !important;
        }

    .page-title {
        font-family: 'Nunito', sans-serif;
        font-weight: 800;
        font-size: 2.5rem;
        color: #0379D9;
        margin: 0 0 8px 0;
        line-height: 1.2;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 1.1rem;
        margin: 0;
        max-width: 600px;
    }

    .section-subtitle {
        font-family: 'Nunito', sans-serif;
        font-weight: 600;
        font-size: 1.3rem;
        color: #334155;
        margin: 0;
        display: flex;
        align-items: center;
    }

    /* Стили для карточек */
    .card {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    }

    /* Стили для формы */
    .form-control-lg {
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        padding: 14px 18px;
        font-family: 'Nunito', sans-serif;
    }

        .form-control-lg:focus {
            border-color: #0379D9;
            box-shadow: 0 0 0 0.2rem rgba(3, 121, 217, 0.25);
        }

    /* Кнопки */
    .btn {
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        font-family: 'Nunito', sans-serif;
    }

    .btn-primary {
        background: #0379D9;
        border: none;
        box-shadow: 0 4px 12px rgba(3, 121, 217, 0.2);
        padding: 14px 30px;
        font-size: 1.1rem;
    }

        .btn-primary:hover {
            background: #0356a8;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(3, 121, 217, 0.3);
        }

        .btn-primary:disabled {
            background: #94a3b8;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

    .btn-outline-secondary {
        border: 2px solid #e2e8f0;
        color: #64748b;
    }

        .btn-outline-secondary:hover {
            background: #f8fafc;
            border-color: #94a3b8;
            color: #334155;
        }

    /* Индикатор силы пароля */
    .password-strength .progress {
        background-color: #f1f5f9;
        border-radius: 3px;
    }

    .progress-bar {
        border-radius: 3px;
        transition: width 0.3s ease;
    }

    /* Требования к паролю */
    #passwordRequirements li {
        transition: color 0.3s ease;
    }

        #passwordRequirements li.valid {
            color: #198754;
        }

            #passwordRequirements li.valid i {
                color: #198754;
            }

    /* Алерт */
    .alert-info {
        background-color: #e8f4fe;
        border: 1px solid #b6d4fe;
        border-radius: 12px;
        color: #084298;
    }

    /* Адаптивность */
    @@media (max-width: 768px) {
        .page-header-section {
            flex-direction: column;
            text-align: center;
            padding: 20px;
            gap: 15px;
        }

            .page-header-section::before {
                width: 100%;
                height: 6px;
                top: 0;
                left: 0;
                background: linear-gradient(to right, #0379D9, #40B624);
            }

        .page-header-icon {
            width: 60px;
            height: 60px;
            font-size: 1.75rem;
        }

        .page-title {
            font-size: 2rem;
        }

        .section-subtitle {
            font-size: 1.2rem;
        }

        .btn-lg {
            width: 100%;
            margin-top: 10px;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.75rem;
        }

        .d-flex.justify-content-between {
            flex-direction: column;
            gap: 10px;
        }

        .alert-info {
            padding: 15px;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const currentPassword = document.getElementById('currentPassword');
        const newPassword = document.getElementById('newPassword');
        const confirmPassword = document.getElementById('confirmPassword');
        const toggleCurrentBtn = document.getElementById('toggleCurrentPassword');
        const toggleNewBtn = document.getElementById('toggleNewPassword');
        const toggleConfirmBtn = document.getElementById('toggleConfirmPassword');
        const passwordStrengthBar = document.getElementById('passwordStrengthBar');
        const passwordStrengthText = document.getElementById('passwordStrengthText');
        const submitBtn = document.getElementById('submitBtn');
        const form = document.getElementById('changePasswordForm');

        // Переключение видимости пароля
        function togglePasswordVisibility(input, button) {
            const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
            input.setAttribute('type', type);
            button.innerHTML = type === 'password' ? '<i class="fas fa-eye"></i>' : '<i class="fas fa-eye-slash"></i>';
        }

        toggleCurrentBtn.addEventListener('click', () => togglePasswordVisibility(currentPassword, toggleCurrentBtn));
        toggleNewBtn.addEventListener('click', () => togglePasswordVisibility(newPassword, toggleNewBtn));
        toggleConfirmBtn.addEventListener('click', () => togglePasswordVisibility(confirmPassword, toggleConfirmBtn));

        // Проверка силы пароля
        function checkPasswordStrength(password) {
            let strength = 0;

            // Длина пароля
            if (password.length >= 8) strength++;
            if (password.length >= 12) strength++;

            // Содержит заглавные буквы
            if (/[A-Z]/.test(password)) strength++;

            // Содержит строчные буквы
            if (/[a-z]/.test(password)) strength++;

            // Содержит цифры
            if (/[0-9]/.test(password)) strength++;

            // Содержит специальные символы
            if (/[^A-Za-z0-9]/.test(password)) strength++;

            return strength;
        }

        function updatePasswordStrength() {
            const password = newPassword.value;
            const strength = checkPasswordStrength(password);

            // Обновляем индикатор
            const percentage = Math.min((strength / 6) * 100, 100);
            passwordStrengthBar.style.width = percentage + '%';

            // Обновляем цвет индикатора
            let color = '#dc3545'; // красный
            let text = 'Очень слабый';

            if (strength >= 2) {
                color = '#ffc107'; // желтый
                text = 'Слабый';
            }
            if (strength >= 3) {
                color = '#fd7e14'; // оранжевый
                text = 'Средний';
            }
            if (strength >= 4) {
                color = '#20c997'; // зеленый
                text = 'Хороший';
            }
            if (strength >= 5) {
                color = '#198754'; // темно-зеленый
                text = 'Отличный';
            }

            passwordStrengthBar.style.backgroundColor = color;
            passwordStrengthText.textContent = `Сила пароля: ${text}`;

            // Обновляем требования
            const reqLength = document.getElementById('reqLength');
            const reqUppercase = document.getElementById('reqUppercase');
            const reqLowercase = document.getElementById('reqLowercase');
            const reqNumber = document.getElementById('reqNumber');

            // Проверяем требования
            reqLength.classList.toggle('valid', password.length >= 8);
            reqUppercase.classList.toggle('valid', /[A-Z]/.test(password));
            reqLowercase.classList.toggle('valid', /[a-z]/.test(password));
            reqNumber.classList.toggle('valid', /[0-9]/.test(password));

            // Обновляем иконки
            const iconClass = 'fas';
            reqLength.querySelector('i').className = `${iconClass} ${password.length >= 8 ? 'fa-check' : 'fa-times'} me-1`;
            reqUppercase.querySelector('i').className = `${iconClass} ${/[A-Z]/.test(password) ? 'fa-check' : 'fa-times'} me-1`;
            reqLowercase.querySelector('i').className = `${iconClass} ${/[a-z]/.test(password) ? 'fa-check' : 'fa-times'} me-1`;
            reqNumber.querySelector('i').className = `${iconClass} ${/[0-9]/.test(password) ? 'fa-check' : 'fa-times'} me-1`;
        }

        // Проверка совпадения паролей
        function checkPasswordMatch() {
            const password = newPassword.value;
            const confirm = confirmPassword.value;
            const matchElement = document.getElementById('passwordMatch');
            const successElement = document.getElementById('passwordSuccess');

            if (confirm === '') {
                matchElement.classList.add('d-none');
                successElement.classList.add('d-none');
                return false;
            }

            if (password === confirm) {
                matchElement.classList.add('d-none');
                successElement.classList.remove('d-none');
                return true;
            } else {
                matchElement.classList.remove('d-none');
                successElement.classList.add('d-none');
                return false;
            }
        }

        // Проверка всей формы
        function validateForm() {
            const currentPassValid = currentPassword.value.trim() !== '';
            const newPassValid = newPassword.value.trim() !== '' && checkPasswordStrength(newPassword.value) >= 3;
            const confirmPassValid = checkPasswordMatch();

            const allValid = currentPassValid && newPassValid && confirmPassValid;
            submitBtn.disabled = !allValid;
            return allValid;
        }

        // Слушатели событий
        newPassword.addEventListener('input', function() {
            updatePasswordStrength();
            validateForm();
        });

        confirmPassword.addEventListener('input', function() {
            checkPasswordMatch();
            validateForm();
        });

        currentPassword.addEventListener('input', validateForm);

        // Обработка отправки формы
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            if (!validateForm()) {
                alert('Пожалуйста, исправьте ошибки в форме.');
                return;
            }

            // Здесь будет отправка формы на сервер
            const formData = new FormData(form);

            // Симуляция отправки
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Сохраняем...';

            setTimeout(() => {
                alert('Пароль успешно изменен!');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-save me-2"></i>Сохранить новый пароль';
                form.reset();
                window.location.href = '/Account/MyAccount';
            }, 1500);
        });
    });
</script>