@{
    ViewData["Title"] = "Смена пароля";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="page-header-section mb-5">
                <div class="page-header-icon">
                    <i class="fas fa-key text-white"></i>
                </div>
                <div>
                    <h1 class="page-title">
                        Смена пароля
                    </h1>
                    <p class="page-subtitle">Защитите свой аккаунт с помощью нового пароля</p>
                </div>
            </div>

            <!-- Шаг 1: Ввод текущего пароля -->
            <div id="step1" class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h3 class="section-subtitle mb-0">
                        <i class="fas fa-lock text-primary me-2"></i>
                        Шаг 1: Подтверждение личности
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form id="verifyPasswordForm">
                        @Html.AntiForgeryToken()

                        <!-- Текущий пароль -->
                        <div class="mb-4">
                            <label for="currentPassword" class="form-label fw-semibold">
                                <i class="fas fa-lock me-2"></i>Текущий пароль
                            </label>
                            <div class="input-group">
                                <input type="password" class="form-control form-control-lg" id="currentPassword"
                                       name="currentPassword" required placeholder="Введите текущий пароль">
                                <button class="btn btn-outline-secondary" type="button" id="toggleCurrentPassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="mt-2">
                                <small id="currentPasswordError" class="text-danger d-none">
                                    <i class="fas fa-exclamation-circle me-1"></i>Неверный пароль
                                </small>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary btn-lg" id="verifyPasswordBtn">
                                <i class="fas fa-arrow-right me-2"></i>Продолжить
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Шаг 2: Ввод нового пароля и подтверждение -->
            <div id="step2" class="card border-0 shadow-sm mb-4 d-none">
                <div class="card-header bg-white border-0 py-3">
                    <h3 class="section-subtitle mb-0">
                        <i class="fas fa-shield-alt text-primary me-2"></i>
                        Шаг 2: Установка нового пароля
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form id="newPasswordForm">
                        @Html.AntiForgeryToken()

                        <!-- Новый пароль -->
                        <div class="mb-4">
                            <label for="newPassword" class="form-label fw-semibold">
                                <i class="fas fa-key me-2"></i>Новый пароль
                            </label>
                            <div class="input-group">
                                <input type="password" class="form-control form-control-lg" id="newPassword"
                                       name="newPassword" required placeholder="Введите новый пароль">
                                <button class="btn btn-outline-secondary" type="button" id="toggleNewPassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="password-strength mt-2">
                                <div class="progress" style="height: 5px;">
                                    <div class="progress-bar" id="passwordStrengthBar" style="width: 0%"></div>
                                </div>
                                <small class="text-muted" id="passwordStrengthText">Начните вводить пароль</small>
                            </div>
                            <div id="passwordRequirements" class="mt-2">
                                <small class="text-muted">Пароль должен содержать:</small>
                                <ul class="list-unstyled mt-1">
                                    <li id="reqLength" class="text-danger small">
                                        <i class="fas fa-times me-1"></i>Минимум 6 символов
                                    </li>
                                    <li id="reqUppercase" class="text-danger small">
                                        <i class="fas fa-times me-1"></i>Одну заглавную букву
                                    </li>
                                    <li id="reqLowercase" class="text-danger small">
                                        <i class="fas fa-times me-1"></i>Одну строчную букву
                                    </li>
                                    <li id="reqSpecial" class="text-danger small">
                                        <i class="fas fa-times me-1"></i>Один специальный символ (!@@#$%^&amp;*()_+-=[]&#123;&#125;;':"\|,.&lt;&gt;/?)
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Подтверждение пароля -->
                        <div class="mb-4">
                            <label for="confirmPassword" class="form-label fw-semibold">
                                <i class="fas fa-check-circle me-2"></i>Подтвердите новый пароль
                            </label>
                            <div class="input-group">
                                <input type="password" class="form-control form-control-lg" id="confirmPassword"
                                       required placeholder="Повторите новый пароль">
                                <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="mt-2">
                                <small id="passwordMatch" class="text-danger d-none">
                                    <i class="fas fa-times me-1"></i>Пароли не совпадают
                                </small>
                                <small id="passwordSuccess" class="text-success d-none">
                                    <i class="fas fa-check me-1"></i>Пароли совпадают
                                </small>
                            </div>
                        </div>

                        <!-- Рекомендации -->
                        <div class="alert alert-info border-0 rounded-lg mb-4">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-lightbulb fa-2x text-info me-3"></i>
                                <div>
                                    <h6 class="alert-heading mb-2">Рекомендации по безопасности</h6>
                                    <ul class="mb-0 small">
                                        <li>Используйте уникальный пароль, который не применяется на других сайтах</li>
                                        <li>Длина пароля должна быть не менее 6 символов</li>
                                        <li>Используйте сочетание заглавных, строчных букв и специальных символов</li>
                                        <li>Регулярно обновляйте пароль для повышения безопасности</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <button type="button" class="btn btn-outline-secondary" id="backToStep1">
                                <i class="fas fa-arrow-left me-2"></i>Назад
                            </button>
                            <button type="submit" class="btn btn-primary btn-lg" id="requestCodeBtn" disabled>
                                <i class="fas fa-envelope me-2"></i>Получить код подтверждения
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Шаг 3: Ввод кода подтверждения -->
            <div id="step3" class="card border-0 shadow-sm d-none">
                <div class="card-header bg-white border-0 py-3">
                    <h3 class="section-subtitle mb-0">
                        <i class="fas fa-envelope text-primary me-2"></i>
                        Шаг 3: Подтверждение по email
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form id="verifyCodeForm">
                        @Html.AntiForgeryToken()

                        <!-- Информация о письме -->
                        <div class="alert alert-success border-0 rounded-lg mb-4">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-paper-plane fa-2x text-success me-3"></i>
                                <div>
                                    <h6 class="alert-heading mb-2">Код отправлен на ваш email</h6>
                                    <p class="mb-0 small">
                                        Мы отправили 6-значный код подтверждения на ваш email адрес.<br>
                                        Проверьте папку "Входящие" или "Спам".
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Ввод кода -->
                        <div class="mb-4">
                            <label for="verificationCode" class="form-label fw-semibold">
                                <i class="fas fa-key me-2"></i>Код подтверждения
                            </label>
                            <div class="input-group">
                                <input type="text" class="form-control form-control-lg text-center"
                                       id="verificationCode" maxlength="6" required
                                       placeholder="Введите 6-значный код">
                            </div>
                            <div class="mt-2">
                                <small id="codeError" class="text-danger d-none">
                                    <i class="fas fa-exclamation-circle me-1"></i>Неверный код
                                </small>
                                <small id="codeTimer" class="text-muted">
                                    Код действителен: <span id="timer">15:00</span>
                                </small>
                            </div>
                        </div>

                        <!-- Переотправка кода -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">Не получили код?</small>
                                <button type="button" class="btn btn-link p-0" id="resendCodeBtn" disabled>
                                    Отправить код повторно (<span id="resendTimer">60</span> сек)
                                </button>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <button type="button" class="btn btn-outline-secondary" id="backToStep2">
                                <i class="fas fa-arrow-left me-2"></i>Назад
                            </button>
                            <button type="submit" class="btn btn-success btn-lg" id="confirmChangeBtn">
                                <i class="fas fa-check me-2"></i>Подтвердить смену пароля
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .page-header-section {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 25px 30px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
    }

    .page-header-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 6px;
        height: 100%;
        background: linear-gradient(to bottom, #0379D9, #40B624);
    }

    .page-header-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #0379D9, #40B624);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        box-shadow: 0 4px 15px rgba(3, 121, 217, 0.2);
        flex-shrink: 0;
    }

    .page-title {
        font-family: 'Nunito', sans-serif;
        font-weight: 800;
        font-size: 2.5rem;
        color: #0379D9;
        margin: 0 0 8px 0;
        line-height: 1.2;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 1.1rem;
        margin: 0;
        max-width: 600px;
    }

    .section-subtitle {
        font-family: 'Nunito', sans-serif;
        font-weight: 600;
        font-size: 1.3rem;
        color: #334155;
        margin: 0;
        display: flex;
        align-items: center;
    }

    .card {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    }

    .form-control-lg {
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        padding: 14px 18px;
        font-family: 'Nunito', sans-serif;
    }

    .form-control-lg:focus {
        border-color: #0379D9;
        box-shadow: 0 0 0 0.2rem rgba(3, 121, 217, 0.25);
    }

    .btn {
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        font-family: 'Nunito', sans-serif;
    }

    .btn-primary {
        background: #0379D9;
        border: none;
        box-shadow: 0 4px 12px rgba(3, 121, 217, 0.2);
        padding: 14px 30px;
        font-size: 1.1rem;
    }

    .btn-primary:hover {
        background: #0356a8;
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(3, 121, 217, 0.3);
    }

    .btn-primary:disabled {
        background: #94a3b8;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .btn-success {
        background: #40B624;
        border: none;
        box-shadow: 0 4px 12px rgba(64, 182, 36, 0.2);
        padding: 14px 30px;
        font-size: 1.1rem;
    }

    .btn-success:hover {
        background: #33991b;
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(64, 182, 36, 0.3);
    }

    .btn-outline-secondary {
        border: 2px solid #e2e8f0;
        color: #64748b;
    }

    .btn-outline-secondary:hover {
        background: #f8fafc;
        border-color: #94a3b8;
        color: #334155;
    }

    #verificationCode {
        font-size: 28px;
        font-weight: bold;
        letter-spacing: 10px;
        font-family: monospace;
    }

    #timer {
        color: #d32f2f;
        font-weight: bold;
    }

    #resendTimer {
        color: #0379D9;
        font-weight: bold;
    }

    #passwordRequirements li.valid {
        color: #198754;
    }

    #passwordRequirements li.valid i {
        color: #198754;
    }

    @@media (max-width: 768px) {
        .page-header-section {
            flex-direction: column;
            text-align: center;
            padding: 20px;
            gap: 15px;
        }

        .page-header-section::before {
            width: 100%;
            height: 6px;
            top: 0;
            left: 0;
            background: linear-gradient(to right, #0379D9, #40B624);
        }

        .page-header-icon {
            width: 60px;
            height: 60px;
            font-size: 1.75rem;
        }

        .page-title {
            font-size: 2rem;
        }

        .section-subtitle {
            font-size: 1.2rem;
        }

        #verificationCode {
            font-size: 24px;
            letter-spacing: 8px;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Элементы шагов
        const step1 = document.getElementById('step1');
        const step2 = document.getElementById('step2');
        const step3 = document.getElementById('step3');

        // Элементы формы
        const currentPassword = document.getElementById('currentPassword');
        const newPassword = document.getElementById('newPassword');
        const confirmPassword = document.getElementById('confirmPassword');
        const verificationCode = document.getElementById('verificationCode');

        // Кнопки
        const verifyPasswordBtn = document.getElementById('verifyPasswordBtn');
        const requestCodeBtn = document.getElementById('requestCodeBtn');
        const confirmChangeBtn = document.getElementById('confirmChangeBtn');
        const backToStep1Btn = document.getElementById('backToStep1');
        const backToStep2Btn = document.getElementById('backToStep2');
        const resendCodeBtn = document.getElementById('resendCodeBtn');

        // Элементы для силы пароля
        const passwordStrengthBar = document.getElementById('passwordStrengthBar');
        const passwordStrengthText = document.getElementById('passwordStrengthText');

        // Таймеры
        const timerElement = document.getElementById('timer');
        const resendTimerElement = document.getElementById('resendTimer');

        // Данные формы
        let formData = {
            currentPassword: '',
            newPassword: '',
            verificationCode: ''
        };

        let verificationCodeSent = false;
        let codeExpiryTime = null;
        let resendTimer = 60;

        function togglePasswordVisibility(input, button) {
            const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
            input.setAttribute('type', type);
            button.innerHTML = type === 'password' ? '<i class="fas fa-eye"></i>' : '<i class="fas fa-eye-slash"></i>';
        }

        const toggleCurrentPassword = document.getElementById('toggleCurrentPassword');
        if (toggleCurrentPassword) {
            toggleCurrentPassword.addEventListener('click', function() {
                togglePasswordVisibility(currentPassword, toggleCurrentPassword);
            });
        }
        
        const toggleNewPassword = document.getElementById('toggleNewPassword');
        if (toggleNewPassword) {
            toggleNewPassword.addEventListener('click', function() {
                togglePasswordVisibility(newPassword, toggleNewPassword);
            });
        }
        
        const toggleConfirmPassword = document.getElementById('toggleConfirmPassword');
        if (toggleConfirmPassword) {
            toggleConfirmPassword.addEventListener('click', function() {
                togglePasswordVisibility(confirmPassword, toggleConfirmPassword);
            });
        }

        function checkPasswordStrength(password) {
            let strength = 0;
            if (password.length >= 6) strength++;
            if (password.length >= 8) strength++;
            if (/[A-Z]/.test(password)) strength++;
            if (/[a-z]/.test(password)) strength++;
            if (/[!@@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password)) strength++;
            return strength;
        }

        function updatePasswordStrength() {
            const password = newPassword.value;
            const strength = checkPasswordStrength(password);
            const percentage = Math.min((strength / 5) * 100, 100);
            
            passwordStrengthBar.style.width = percentage + '%';

            let color = '#dc3545';
            let text = 'Очень слабый';

            if (strength >= 2) {
                color = '#ffc107';
                text = 'Слабый';
            }
            if (strength >= 3) {
                color = '#fd7e14';
                text = 'Средний';
            }
            if (strength >= 4) {
                color = '#20c997';
                text = 'Хороший';
            }
            if (strength >= 5) {
                color = '#198754';
                text = 'Отличный';
            }

            passwordStrengthBar.style.backgroundColor = color;
            passwordStrengthText.textContent = 'Сила пароля: ' + text;

            const reqLength = document.getElementById('reqLength');
            const reqUppercase = document.getElementById('reqUppercase');
            const reqLowercase = document.getElementById('reqLowercase');
            const reqSpecial = document.getElementById('reqSpecial');

            if (reqLength) {
                if (password.length >= 6) {
                    reqLength.classList.add('valid');
                    reqLength.classList.remove('text-danger');
                    reqLength.querySelector('i').className = 'fas fa-check me-1';
                } else {
                    reqLength.classList.remove('valid');
                    reqLength.classList.add('text-danger');
                    reqLength.querySelector('i').className = 'fas fa-times me-1';
                }
            }
            
            if (reqUppercase) {
                if (/[A-Z]/.test(password)) {
                    reqUppercase.classList.add('valid');
                    reqUppercase.classList.remove('text-danger');
                    reqUppercase.querySelector('i').className = 'fas fa-check me-1';
                } else {
                    reqUppercase.classList.remove('valid');
                    reqUppercase.classList.add('text-danger');
                    reqUppercase.querySelector('i').className = 'fas fa-times me-1';
                }
            }
            
            if (reqLowercase) {
                if (/[a-z]/.test(password)) {
                    reqLowercase.classList.add('valid');
                    reqLowercase.classList.remove('text-danger');
                    reqLowercase.querySelector('i').className = 'fas fa-check me-1';
                } else {
                    reqLowercase.classList.remove('valid');
                    reqLowercase.classList.add('text-danger');
                    reqLowercase.querySelector('i').className = 'fas fa-times me-1';
                }
            }
            
            if (reqSpecial) {
                const hasSpecial = /[!@@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password);
                if (hasSpecial) {
                    reqSpecial.classList.add('valid');
                    reqSpecial.classList.remove('text-danger');
                    reqSpecial.querySelector('i').className = 'fas fa-check me-1';
                } else {
                    reqSpecial.classList.remove('valid');
                    reqSpecial.classList.add('text-danger');
                    reqSpecial.querySelector('i').className = 'fas fa-times me-1';
                }
            }
        }

        function checkPasswordMatch() {
            const password = newPassword.value;
            const confirm = confirmPassword.value;
            const matchElement = document.getElementById('passwordMatch');
            const successElement = document.getElementById('passwordSuccess');

            if (confirm === '') {
                if (matchElement) matchElement.classList.add('d-none');
                if (successElement) successElement.classList.add('d-none');
                return false;
            }

            if (password === confirm) {
                if (matchElement) matchElement.classList.add('d-none');
                if (successElement) successElement.classList.remove('d-none');
                return true;
            } else {
                if (matchElement) matchElement.classList.remove('d-none');
                if (successElement) successElement.classList.add('d-none');
                return false;
            }
        }

        function validateStep1() {
            return currentPassword.value.trim() !== '';
        }

        function validateStep2() {
            const password = newPassword.value;
            const passwordValid = password.trim() !== '' &&
                                  password.length >= 6 &&
                                  /[A-Z]/.test(password) &&
                                  /[a-z]/.test(password) &&
                                  /[!@@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password);
            const confirmValid = checkPasswordMatch();
            return passwordValid && confirmValid;
        }

        function validateStep3() {
            return verificationCode.value.trim().length === 6;
        }

        function goToStep(stepNumber) {
            step1.classList.add('d-none');
            step2.classList.add('d-none');
            step3.classList.add('d-none');

            if (stepNumber === 1) {
                step1.classList.remove('d-none');
            } else if (stepNumber === 2) {
                step2.classList.remove('d-none');
                updatePasswordStrength();
            } else if (stepNumber === 3) {
                step3.classList.remove('d-none');
                startTimers();
            }
        }

        function startTimers() {
            let codeTime = 15 * 60;
            codeExpiryTime = new Date(Date.now() + codeTime * 1000);

            const codeTimer = setInterval(function() {
                const now = new Date();
                const diff = Math.floor((codeExpiryTime - now) / 1000);

                if (diff <= 0) {
                    clearInterval(codeTimer);
                    timerElement.textContent = '00:00';
                    alert('Время действия кода истекло. Пожалуйста, запросите новый код.');
                    goToStep(2);
                    return;
                }

                const minutes = Math.floor(diff / 60);
                const seconds = diff % 60;
                timerElement.textContent = minutes.toString().padStart(2, '0') + ':' + seconds.toString().padStart(2, '0');
            }, 1000);

            resendTimer = 60;
            resendCodeBtn.disabled = true;

            const resendInterval = setInterval(function() {
                resendTimer--;
                resendTimerElement.textContent = resendTimer;

                if (resendTimer <= 0) {
                    clearInterval(resendInterval);
                    resendCodeBtn.disabled = false;
                    resendCodeBtn.innerHTML = 'Отправить код повторно';
                } else {
                    resendCodeBtn.innerHTML = 'Отправить код повторно (<span id="resendTimer">' + resendTimer + '</span> сек)';
                }
            }, 1000);
        }

        async function sendVerificationCode() {
            try {
                requestCodeBtn.disabled = true;
                requestCodeBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Отправляем код...';

                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                
                const response = await fetch('/Account/SendPasswordChangeCode', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        currentPassword: formData.currentPassword,
                        newPassword: formData.newPassword
                    })
                });

                const result = await response.json();

                if (result.success) {
                    verificationCodeSent = true;
                    goToStep(3);
                } else {
                    alert(result.message || 'Ошибка при отправке кода');
                    requestCodeBtn.disabled = false;
                    requestCodeBtn.innerHTML = '<i class="fas fa-envelope me-2"></i>Получить код подтверждения';
                }
            } catch (error) {
                console.error('Ошибка:', error);
                alert('Произошла ошибка при отправке кода');
                requestCodeBtn.disabled = false;
                requestCodeBtn.innerHTML = '<i class="fas fa-envelope me-2"></i>Получить код подтверждения';
            }
        }

        async function submitPasswordChange() {
            try {
                confirmChangeBtn.disabled = true;
                confirmChangeBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Меняем пароль...';

                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                
                const response = await fetch('/Account/ChangePasswordWithVerification', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        verificationCode: verificationCode.value,
                        newPassword: formData.newPassword
                    })
                });

                const result = await response.json();
                if (result.success) {
                    alert('Пароль успешно изменен!');
                    window.location.href = '/Account/Profile';
                } else {
                    document.getElementById('codeError').classList.remove('d-none');
                    confirmChangeBtn.disabled = false;
                    confirmChangeBtn.innerHTML = '<i class="fas fa-check me-2"></i>Подтвердить смену пароля';
                }
            } catch (error) {
                console.error('Ошибка:', error);
                alert('Произошла ошибка при смене пароля');
                confirmChangeBtn.disabled = false;
                confirmChangeBtn.innerHTML = '<i class="fas fa-check me-2"></i>Подтвердить смену пароля';
            }
        }

        const verifyPasswordForm = document.getElementById('verifyPasswordForm');
        if (verifyPasswordForm) {
            verifyPasswordForm.addEventListener('submit', async function(e) {
                e.preventDefault();

                if (!validateStep1()) {
                    alert('Введите текущий пароль');
                    return;
                }

                try {
                    verifyPasswordBtn.disabled = true;
                    verifyPasswordBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Проверяем...';

                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    
                    const response = await fetch('/Account/VerifyCurrentPassword', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({
                            currentPassword: currentPassword.value
                        })
                    });

                    const result = await response.json();

                    if (result.success) {
                        formData.currentPassword = currentPassword.value;
                        goToStep(2);
                    } else {
                        document.getElementById('currentPasswordError').classList.remove('d-none');
                        verifyPasswordBtn.disabled = false;
                        verifyPasswordBtn.innerHTML = '<i class="fas fa-arrow-right me-2"></i>Продолжить';
                    }
                } catch (error) {
                    console.error('Ошибка:', error);
                    alert('Произошла ошибка при проверке пароля');
                    verifyPasswordBtn.disabled = false;
                    verifyPasswordBtn.innerHTML = '<i class="fas fa-arrow-right me-2"></i>Продолжить';
                }
            });
        }

        if (newPassword) {
            newPassword.addEventListener('input', function() {
                updatePasswordStrength();
                requestCodeBtn.disabled = !validateStep2();
            });
        }

        if (confirmPassword) {
            confirmPassword.addEventListener('input', function() {
                checkPasswordMatch();
                requestCodeBtn.disabled = !validateStep2();
            });
        }

        const newPasswordForm = document.getElementById('newPasswordForm');
        if (newPasswordForm) {
            newPasswordForm.addEventListener('submit', function(e) {
                e.preventDefault();

                if (!validateStep2()) {
                    alert('Пожалуйста, проверьте правильность ввода нового пароля');
                    return;
                }

                formData.newPassword = newPassword.value;
                sendVerificationCode();
            });
        }

        if (verificationCode) {
            verificationCode.addEventListener('input', function() {
                if (this.value.length === 6) {
                    document.getElementById('codeError').classList.add('d-none');
                }
            });
        }

        const verifyCodeForm = document.getElementById('verifyCodeForm');
        if (verifyCodeForm) {
            verifyCodeForm.addEventListener('submit', function(e) {
                e.preventDefault();

                if (!validateStep3()) {
                    alert('Введите 6-значный код подтверждения');
                    return;
                }

                submitPasswordChange();
            });
        }

        if (backToStep1Btn) {
            backToStep1Btn.addEventListener('click', function() { goToStep(1); });
        }
        
        if (backToStep2Btn) {
            backToStep2Btn.addEventListener('click', function() { goToStep(2); });
        }

        if (resendCodeBtn) {
            resendCodeBtn.addEventListener('click', function() {
                if (!this.disabled) {
                    sendVerificationCode();
                    this.disabled = true;
                    resendTimer = 60;
                }
            });
        }

        goToStep(1);
    });
</script>