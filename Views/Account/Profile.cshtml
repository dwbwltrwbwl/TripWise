@model TripWise.Models.User
@{
    ViewData["Title"] = "Мой аккаунт";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Заголовок страницы -->
            <div class="page-header-section mb-5">
                <div class="page-header-icon">
                    <i class="fas fa-user-circle"></i>
                </div>
                <div>
                    <h1 class="page-title">
                        Мой аккаунт
                    </h1>
                    <p class="page-subtitle">Управление профилем и настройками</p>
                </div>
            </div>

            <!-- Основной контент -->
            <div class="row">
                <!-- Левая колонка - профиль -->
                <div class="col-lg-4 mb-4">
                    <!-- Карточка профиля -->
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center p-4">
                            <div class="avatar-circle mb-4">
                                <div class="avatar-initials">
                                    @Model.Name[0].ToString().ToUpper()
                                </div>
                            </div>
                            <h4 class="fw-bold mb-2" style="font-family: 'Nunito', sans-serif;">@Model.Name</h4>
                            <p class="text-muted mb-4">
                                <i class="fas fa-envelope me-2"></i>@Model.Email
                            </p>

                            <div class="d-grid gap-2">
                                <a asp-controller="Account" asp-action="Edit" class="btn btn-primary">
                                    <i class="fas fa-edit me-2"></i>Редактировать профиль
                                </a>
                                <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-primary">
                                    <i class="fas fa-key me-2"></i>Сменить пароль
                                </a>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 pt-0">
                            <div class="text-center text-muted small">
                                <i class="fas fa-calendar me-1"></i>
                                Зарегистрирован с @Model.CreatedAt.ToString("yyyy") года
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Правая колонка - контент -->
                <div class="col-lg-8">
                    <!-- Статистика -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white border-0 py-3">
                            <h5 class="section-subtitle mb-0">
                                <i class="fas fa-chart-line text-primary me-2"></i>
                                Статистика путешествий
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <div class="col-6 col-md-3">
                                    <div class="stat-card p-3 text-center">
                                        <div class="stat-icon mb-2">
                                            <i class="fas fa-plane fa-2x text-primary"></i>
                                        </div>
                                        <div class="stat-number fw-bold fs-4 text-primary">@ViewBag.TripCount</div>
                                        <div class="stat-label text-muted small">Поездок</div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="stat-card p-3 text-center">
                                        <div class="stat-icon mb-2">
                                            <i class="fas fa-globe-europe fa-2x text-success"></i>
                                        </div>
                                        <div class="stat-number fw-bold fs-4 text-success">@ViewBag.CountryCount</div>
                                        <div class="stat-label text-muted small">Стран</div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="stat-card p-3 text-center">
                                        <div class="stat-icon mb-2">
                                            <i class="fas fa-users fa-2x text-warning"></i>
                                        </div>
                                        <div class="stat-number fw-bold fs-4 text-warning">@ViewBag.GroupCount</div>
                                        <div class="stat-label text-muted small">Группы</div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="stat-card p-3 text-center">
                                        <div class="stat-icon mb-2">
                                            <i class="fas fa-calendar-day fa-2x text-info"></i>
                                        </div>
                                        <div class="stat-number fw-bold fs-4 text-info">@ViewBag.TravelDays</div>
                                        <div class="stat-label text-muted small">Дней в пути</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Навигация -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white border-0 py-3">
                            <h5 class="section-subtitle mb-0">
                                <i class="fas fa-compass text-primary me-2"></i>
                                Навигация
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <a asp-controller="Home" asp-action="Favorites" class="nav-card d-flex align-items-center text-decoration-none p-3 border rounded">
                                        <div class="nav-icon me-3">
                                            <i class="fas fa-heart fa-2x text-danger"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Избранное</h6>
                                            <p class="text-muted small mb-0">Сохраненные направления</p>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-md-6">
                                    <a asp-controller="Home" asp-action="Trips" class="nav-card d-flex align-items-center text-decoration-none p-3 border rounded">
                                        <div class="nav-icon me-3">
                                            <i class="fas fa-map-marked-alt fa-2x text-primary"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Мои поездки</h6>
                                            <p class="text-muted small mb-0">Управление маршрутами</p>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Настройки безопасности -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-0 py-3">
                            <h5 class="section-subtitle mb-0">
                                <i class="fas fa-shield-alt text-primary me-2"></i>
                                Безопасность
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="list-group list-group-flush">
                                <a asp-controller="Account" asp-action="ChangePassword" class="list-group-item list-group-item-action d-flex align-items-center py-3 px-4 border-0">
                                    <div class="flex-shrink-0 me-3">
                                        <i class="fas fa-key fa-lg text-primary"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1 fw-semibold">Сменить пароль</h6>
                                        <p class="text-muted small mb-0">Обновите пароль для безопасности</p>
                                    </div>
                                    <i class="fas fa-chevron-right text-muted"></i>
                                </a>
                                <a href="#" class="list-group-item list-group-item-action d-flex align-items-center py-3 px-4 border-0">
                                    <div class="flex-shrink-0 me-3">
                                        <i class="fas fa-envelope fa-lg text-primary"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1 fw-semibold">Настройки уведомлений</h6>
                                        <p class="text-muted small mb-0">Управление email-рассылками</p>
                                    </div>
                                    <i class="fas fa-chevron-right text-muted"></i>
                                </a>
                                <a href="#" class="list-group-item list-group-item-action d-flex align-items-center py-3 px-4 border-0">
                                    <div class="flex-shrink-0 me-3">
                                        <i class="fas fa-user-shield fa-lg text-primary"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1 fw-semibold">Конфиденциальность</h6>
                                        <p class="text-muted small mb-0">Настройки приватности профиля</p>
                                    </div>
                                    <i class="fas fa-chevron-right text-muted"></i>
                                </a>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0 py-3 px-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger">
                                    <i class="fas fa-sign-out-alt me-2"></i>Выйти из аккаунта
                                </a>
                                <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
                                    <i class="fas fa-trash-alt me-2"></i>Удалить аккаунт
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно удаления аккаунта -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold text-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Удаление аккаунта
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-4">
                    <i class="fas fa-trash-alt fa-3x text-danger mb-3"></i>
                    <h5 class="fw-bold mb-2">Вы уверены, что хотите удалить аккаунт?</h5>
                    <p class="text-muted">
                        Это действие нельзя отменить. Все ваши данные, поездки и избранное будут удалены безвозвратно.
                    </p>
                </div>
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <strong>Внимание:</strong> Удаление аккаунта приведет к потере всех данных.
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-danger" onclick="deleteAccount()">
                    <i class="fas fa-trash-alt me-2"></i>Удалить аккаунт
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Стили для заголовка страницы */
    .page-header-section {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 25px 30px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
    }

        .page-header-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 6px;
            height: 100%;
            background: linear-gradient(to bottom, #0379D9, #40B624);
        }

    .page-header-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #0379D9, #40B624);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        box-shadow: 0 4px 15px rgba(3, 121, 217, 0.2);
        flex-shrink: 0;
    }

    .page-title {
        font-family: 'Nunito', sans-serif;
        font-weight: 800;
        font-size: 2.5rem;
        color: #0379D9;
        margin: 0 0 8px 0;
        line-height: 1.2;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 1.1rem;
        margin: 0;
        max-width: 600px;
    }

    .section-subtitle {
        font-family: 'Nunito', sans-serif;
        font-weight: 600;
        font-size: 1.3rem;
        color: #334155;
        margin: 0;
        display: flex;
        align-items: center;
    }

    /* Аватар - БЕЗ ГРАДИЕНТА */
    .avatar-circle {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: #0379D9; /* Один цвет вместо градиента */
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        box-shadow: 0 4px 15px rgba(3, 121, 217, 0.2);
        position: relative;
        overflow: hidden;
    }

    .avatar-initials {
        color: white;
        font-size: 3rem;
        font-weight: 700;
        font-family: 'Nunito', sans-serif;
        text-transform: uppercase;
    }

    /* Карточки статистики */
    .stat-card {
        background: white;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        transition: all 0.3s ease;
        height: 100%;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            border-color: #0379D9;
        }

    .stat-icon {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }

    .stat-number {
        font-family: 'Nunito', sans-serif;
        line-height: 1;
    }

    /* Карточки навигации */
    .nav-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        transition: all 0.3s ease;
    }

        .nav-card:hover {
            background: linear-gradient(135deg, #f8fafc, #f1f5f9);
            border-color: #0379D9;
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(3, 121, 217, 0.15);
        }

    .nav-icon {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Карточки списка */
    .card {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
    }

        .card:hover {
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

    .list-group-item {
        border: none;
        border-bottom: 1px solid #f1f5f9;
        padding: 20px 25px;
        transition: all 0.2s ease;
    }

        .list-group-item:last-child {
            border-bottom: none;
        }

        .list-group-item:hover {
            background-color: #f8fafc;
        }

    /* Кнопки */
    .btn {
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        font-family: 'Nunito', sans-serif;
    }

    .btn-primary {
        background: #0379D9; /* Один цвет вместо градиента */
        border: none;
        box-shadow: 0 4px 12px rgba(3, 121, 217, 0.2);
    }

        .btn-primary:hover {
            background: #0356a8; /* Темнее при наведении */
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(3, 121, 217, 0.3);
        }

    .btn-outline-primary {
        border: 2px solid #0379D9;
        color: #0379D9;
        background: white;
    }

        .btn-outline-primary:hover {
            background: #f0f7ff;
            border-color: #0356a8;
            color: #0356a8;
        }

    .btn-outline-secondary {
        border: 2px solid #e2e8f0;
        color: #64748b;
    }

        .btn-outline-secondary:hover {
            background: #f8fafc;
            border-color: #94a3b8;
            color: #334155;
        }

    /* Кнопка выхода - КРАСИВАЯ */
    .btn-outline-danger {
        border: 2px solid #fecaca;
        color: #dc2626;
        background: white;
        padding: 10px 20px;
        transition: all 0.3s ease;
    }

        .btn-outline-danger:hover {
            background: linear-gradient(135deg, #fee2e2, #fecaca);
            border-color: #f87171;
            color: #b91c1c;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(220, 38, 38, 0.15);
        }

    /* Модальное окно */
    .modal-content {
        border-radius: 16px;
        border: none;
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    }

    /* Адаптивность */
    @@media (max-width: 768px) {
        .page-header-section {
            flex-direction: column;
            text-align: center;
            padding: 20px;
            gap: 15px;
        }

            .page-header-section::before {
                width: 100%;
                height: 6px;
                top: 0;
                left: 0;
                background: linear-gradient(to right, #0379D9, #40B624);
            }

        .page-header-icon {
            width: 60px;
            height: 60px;
            font-size: 1.75rem;
        }

        .page-title {
            font-size: 2rem;
        }

        .avatar-circle {
            width: 100px;
            height: 100px;
        }

        .avatar-initials {
            font-size: 2.5rem;
        }

        .section-subtitle {
            font-size: 1.2rem;
        }

        .list-group-item {
            padding: 15px 20px;
        }

        .card-footer .d-flex {
            flex-direction: column;
            gap: 10px;
        }

        .card-footer .btn {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.75rem;
        }

        .stat-card {
            padding: 15px !important;
        }

        .nav-card {
            padding: 15px;
        }

        .avatar-circle {
            width: 80px;
            height: 80px;
        }

        .avatar-initials {
            font-size: 2rem;
        }
    }
</style>

<script>
    function deleteAccount() {
        if (confirm('Вы уверены, что хотите удалить аккаунт? Это действие нельзя отменить.')) {
            // Здесь будет запрос на удаление аккаунта
            fetch('/api/account/delete', {
                method: 'DELETE'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Аккаунт успешно удален');
                    window.location.href = '/';
                } else {
                    alert('Ошибка при удалении аккаунта');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Произошла ошибка при удалении аккаунта');
            });
        }
    }
</script>