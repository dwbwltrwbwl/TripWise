@model TripWise.Models.User
@{
    ViewData["Title"] = "Мой аккаунт";
}

<div class="container mt-4">

    <!-- Заголовок страницы --> <div class="page-header-section mb-5"> <div class="page-header-icon"> <i class="fas fa-user-circle"></i> </div> <div> <h1 class="page-title"> Мой аккаунт </h1> <p class="page-subtitle">Управление профилем и настройками</p> </div> </div>
    <!-- Профиль -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex align-items-center gap-4">
            <div class="avatar-circle">
                <div class="avatar-initials">
                    @Model.FirstName[0].ToString().ToUpper()@Model.LastName[0].ToString().ToUpper()
                </div>
            </div>

            <div>
                <h4 class="fw-bold mb-1">
                    @Model.LastName @Model.FirstName
                    @if (!string.IsNullOrEmpty(Model.MiddleName))
                    {
                        <text>@Model.MiddleName</text>
                    }
                </h4>
                <div class="text-muted mb-1">@Model.Email</div>
                <div class="text-muted small">
                    Зарегистрирован с @Model.CreatedAt.ToString("yyyy") года
                </div>

                <div class="mt-3 d-flex gap-2">
                    <a asp-action="Edit" class="btn btn-primary btn-sm">
                        Редактировать профиль
                    </a>
                    <a asp-action="ChangePassword" class="btn btn-outline-primary btn-sm">
                        Сменить пароль
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Основные показатели -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-0">
            <h5 class="section-subtitle mb-0">
                <i class="fas fa-chart-line text-primary me-2"></i>
                Основные показатели
            </h5>
        </div>
        <div class="card-body">
            <div class="row text-center">
                <div class="col-6 col-md-3">
                    <div class="simple-stat">
                        <div class="value">@ViewBag.TripCount</div>
                        <div class="label">Поездок</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="simple-stat">
                        <div class="value">@ViewBag.GroupCount</div>
                        <div class="label">Групп</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="simple-stat">
                        <div class="value">@ViewBag.TravelDays</div>
                        <div class="label">Дней в пути</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="simple-stat">
                        <div class="value">@ViewBag.LastExpenses?.Count</div>
                        <div class="label">Расходов</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Документы -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-0">
            <h5 class="section-subtitle mb-0">
                <i class="fas fa-folder text-primary me-2"></i>
                Мои документы
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <p class="text-muted mb-3">
                        Храните важные документы для поездок: паспорта, билеты, страховки, бронирования
                    </p>
                    <div class="d-flex gap-2">
                        <a asp-action="MyDocuments" class="btn btn-primary">
                            <i class="fas fa-folder-open me-2"></i>Перейти к документам
                        </a>
                        <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#quickUploadModal">
                            <i class="fas fa-upload me-2"></i>Быстрая загрузка
                        </button>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-center">
                        <div class="documents-stats mb-3">
                            <div class="value">@(ViewBag.DocumentCount ?? 0)</div>
                            <div class="label">Документов</div>
                        </div>
                        <div class="documents-stats">
                            <div class="value">@(ViewBag.FolderCount ?? 0)</div>
                            <div class="label">Папок</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Последние документы -->
            @if (ViewBag.RecentDocuments != null && ViewBag.RecentDocuments.Count > 0)
            {
                <div class="mt-4">
                    <h6 class="mb-3">Недавно добавленные:</h6>
                    <div class="row">
                        @foreach (var doc in ViewBag.RecentDocuments)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="document-item">
                                    <div class="document-icon">
                                        <i class="fas fa-file-@(doc.FileType?.ToLower() == "pdf" ? "pdf" :
                                                          doc.FileType?.ToLower() == "doc" || doc.FileType?.ToLower() == "docx" ? "word" :
                                                          doc.FileType?.ToLower() == "jpg" || doc.FileType?.ToLower() == "png" || doc.FileType?.ToLower() == "jpeg" ? "image" :
                                                          "alt") text-primary"></i>
                                    </div>
                                    <div class="document-info">
                                        <div class="document-name">@doc.Name</div>
                                        <div class="document-meta">@(doc.FileSize / 1024) КБ • @doc.CreatedAt.ToString("dd.MM.yyyy")</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
                    <p class="text-muted">Документов пока нет</p>
                </div>
            }
        </div>
    </div>

    <!-- Модальное окно быстрой загрузки -->
    <div class="modal fade" id="quickUploadModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Быстрая загрузка документа</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="quickUploadForm" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label">Название документа</label>
                            <input type="text" class="form-control" name="documentName" placeholder="Паспорт, Билет, Страховка и т.д." required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Выберите файл</label>
                            <input type="file" class="form-control" name="documentFile" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.txt" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Папка (опционально)</label>
                            <select class="form-select" name="folderId">
                                <option value="">Без папки</option>
                                @if (ViewBag.UserFolders != null)
                                {
                                    foreach (var folder in ViewBag.UserFolders)
                                    {
                                        <option value="@folder.IdFolder">@folder.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="button" class="btn btn-primary" onclick="quickUploadDocument()">Загрузить</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Финансы -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-0">
            <h5 class="section-subtitle mb-0">
                <i class="fas fa-wallet text-primary me-2"></i>
                Финансы
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="finance-box">
                        <span>Моя доля расходов</span>
                        <strong>@ViewBag.TotalShare ₽</strong>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="finance-box danger">
                        <span>Не оплачено</span>
                        <strong>@ViewBag.UnpaidShare ₽</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Последняя активность -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-0">
            <h5 class="section-subtitle mb-0">
                <i class="fas fa-history text-primary me-2"></i>
                Последняя активность
            </h5>
        </div>
        <div class="card-body p-0">
            @if (ViewBag.LastExpenses != null && ViewBag.LastExpenses.Count > 0)
            {
                <ul class="list-group list-group-flush">
                    @foreach (var item in ViewBag.LastExpenses)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@item.Title</span>
                            <strong>@item.Amount ₽</strong>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="p-3 text-muted">Нет активности</div>
            }
        </div>
    </div>

    <!-- Выход -->
    <div class="d-flex gap-3 mb-5">
        <a asp-action="Logout" class="btn btn-outline-danger">
            Выйти из аккаунта
        </a>
        <!-- Вместо существующей кнопки удаления -->
        <a asp-action="Delete" class="btn btn-danger">
            <i class="fas fa-trash-alt me-2"></i>Удалить аккаунт
        </a>
    </div>
</div>

<style>
    .card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 2px 4px rgba(15, 23, 42, 0.04), 0 12px 24px rgba(15, 23, 42, 0.06);
    }

        .card:hover {
            box-shadow: 0 4px 10px rgba(15, 23, 42, 0.08), 0 20px 40px rgba(15, 23, 42, 0.10);
            transform: translateY(-2px);
        }

    /* Аватар - БЕЗ ГРАДИЕНТА */ 
    .avatar-circle {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: #0379D9;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(3, 121, 217, 0.2);
        flex-shrink: 0;
        margin: 0;
    }

    .avatar-initials {
        color: white;
        font-size: 1.8rem;
        font-weight: 700;
        font-family: 'Nunito', sans-serif;
        text-transform: uppercase;
    }
    /* Стили для заголовка страницы */ .page-header-section {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 25px 30px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
    }

        .page-header-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 6px;
            height: 100%;
            background: linear-gradient(to bottom, #0379D9, #40B624);
        }

    .page-header-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #0379D9, #40B624);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        box-shadow: 0 4px 15px rgba(3, 121, 217, 0.2);
        flex-shrink: 0;
    }

    .page-title {
        font-family: 'Nunito', sans-serif;
        font-weight: 800;
        font-size: 2.5rem;
        color: #0379D9;
        margin: 0 0 8px 0;
        line-height: 1.2;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 1.1rem;
        margin: 0;
        max-width: 600px;
    }

    .section-subtitle {
        font-family: 'Nunito', sans-serif;
        font-weight: 600;
        font-size: 1.3rem;
        color: #334155;
        margin: 0;
        display: flex;
        align-items: center;
    }
    .account-page {
        max-width: 900px;
        margin: 40px auto;
        font-family: 'Nunito', sans-serif;
    }

    .account-header {
        margin-bottom: 40px;
    }

        .account-header h1 {
            font-size: 2.2rem;
            margin-bottom: 5px;
        }

        .account-header p {
            color: #64748b;
        }

    .account-section {
        margin-bottom: 40px;
    }

    .profile-section {
        display: flex;
        gap: 25px;
        align-items: center;
    }

    .profile-avatar {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: #0379D9;
        color: #fff;
        font-size: 2.5rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .profile-info h2 {
        margin: 0 0 5px 0;
    }

    .profile-meta {
        color: #64748b;
        font-size: 0.95rem;
    }

    .profile-actions {
        margin-top: 15px;
        display: flex;
        gap: 10px;
    }

    .stats-grid,
    .finance-grid,
    .actions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 15px;
    }

    .stat-item {
        padding: 15px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        text-align: center;
    }

    .stat-value {
        font-size: 1.8rem;
        font-weight: 700;
    }

    .stat-label {
        color: #64748b;
        font-size: 0.9rem;
    }

    .finance-item {
        padding: 15px;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
    }

        .finance-item.danger {
            border-color: #fecaca;
            color: #b91c1c;
        }

    .actions-grid a {
        padding: 15px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        text-decoration: none;
        color: #0379D9;
        text-align: center;
        font-weight: 600;
    }

    .activity-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .activity-list li {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #f1f5f9;
        }

    .account-danger {
        display: flex;
        gap: 15px;
    }

    .simple-stat .value {
        font-size: 1.8rem;
        font-weight: 700;
        color: #0379D9;
    }

    .simple-stat .label {
        color: #64748b;
        font-size: 0.9rem;
    }

    .finance-box {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .finance-box.danger {
            border-color: #fecaca;
            color: #b91c1c;
        }
</style>

<script>
    function deleteAccount() {
        if (confirm('Вы уверены, что хотите удалить аккаунт? Это действие нельзя отменить.')) {
            // Здесь будет запрос на удаление аккаунта
            fetch('/api/account/delete', {
                method: 'DELETE'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Аккаунт успешно удален');
                    window.location.href = '/';
                } else {
                    alert('Ошибка при удалении аккаунта');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Произошла ошибка при удалении аккаунта');
            });
        }
    }
</script>