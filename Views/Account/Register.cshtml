@{
    ViewData["Title"] = "Регистрация";
}

<style>
    body {
        background: url('/ostrov-optimized.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
    }

    .card {
        border-radius: 15px;
        background: rgba(255, 255, 255, 0.98);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    .form-control {
        border-radius: 10px;
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
        padding-right: 45px; /* Добавляем отступ для иконки */
    }

        .form-control:focus {
            border-color: #047bd6;
            box-shadow: 0 0 0 0.2rem rgba(4, 123, 214, 0.25);
        }

    .btn {
        border-radius: 10px;
        padding: 12px;
        font-size: 1.1rem;
        transition: all 0.3s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(4, 123, 214, 0.3);
        }

    .password-toggle {
        position: absolute;
        right: 15px;
        top: 70%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #6c757d;
        cursor: pointer;
        z-index: 10;
        padding: 0;
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .password-input-group {
        position: relative;
    }

    /* Добавьте эти стили в ваш <style> блок */
    .alert-success {
        animation: slideIn 0.5s ease-out;
        transform-origin: top center;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-20px) scale(0.95);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .success-check {
        animation: checkmark 0.5s ease-out 0.2s both;
    }

    @@keyframes checkmark {
        0% {
            transform: scale(0);
        }

        50% {
            transform: scale(1.2);
        }

        100% {
            transform: scale(1);
        }
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <h1 class="h3 font-weight-bold" style="font-family: 'Nunito', sans-serif; color: #047bd6;">Регистрация</h1>
                        <p class="text-muted">Создайте новый аккаунт</p>
                    </div>

                    <!-- Сообщение об успехе -->
                    @if (ViewData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert"
                             style="background: linear-gradient(135deg, #e8f5e9, #c8e6c9); border: none; border-radius: 12px; border-left: 4px solid #28a745;">
                            <div class="d-flex align-items-center">
                                <div class="me-3">
                                    <div class="rounded-circle bg-success p-2 d-flex align-items-center justify-content-center"
                                         style="width: 40px; height: 40px;">
                                        <i class="fas fa-check text-white"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="mb-1 text-success fw-bold">
                                        <i class="fas fa-trophy me-2"></i>Регистрация успешно завершена!
                                    </h5>
                                    <p class="mb-0">@ViewData["SuccessMessage"]</p>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                            <div class="mt-2">
                                <a asp-controller="Account" asp-action="Login"
                                   class="btn btn-sm btn-outline-success mt-2">
                                    <i class="fas fa-sign-in-alt me-1"></i>Перейти к входу
                                </a>
                            </div>
                        </div>
                    }

                    <form method="post" asp-action="Register">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="lastName" class="form-label">Фамилия</label>
                                <input type="text" class="form-control form-control-lg" id="lastName" name="lastName"
                                       placeholder="Иванов"
                                       value="@ViewData["LastName"]"
                                       required>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="firstName" class="form-label">Имя</label>
                                <input type="text" class="form-control form-control-lg" id="firstName" name="firstName"
                                       placeholder="Иван"
                                       value="@ViewData["FirstName"]"
                                       required>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="middleName" class="form-label">Отчество</label>
                                <input type="text" class="form-control form-control-lg" id="middleName" name="middleName"
                                       placeholder="Иванович"
                                       value="@ViewData["MiddleName"]">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email адрес</label>
                            <input type="email" class="form-control form-control-lg" id="email" name="email"
                                   placeholder="ваш@email.com"
                                   value="@ViewData["Email"]"
                                   required>
                        </div>

                        <div class="mb-3 password-input-group">
                            <label for="password" class="form-label">Пароль</label>
                            <input type="password" class="form-control form-control-lg" id="password" name="password"
                                   placeholder="Создайте пароль"
                                   value="@ViewData["Password"]"
                                   required>
                            <button type="button" class="password-toggle" onclick="togglePassword('password')">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>

                        <div class="mb-3 password-input-group">
                            <label for="confirmPassword" class="form-label">Подтверждение пароля</label>
                            <input type="password" class="form-control form-control-lg" id="confirmPassword" name="confirmPassword"
                                   placeholder="Повторите пароль"
                                   value="@ViewData["ConfirmPassword"]"
                                   required>
                            <button type="button" class="password-toggle" onclick="togglePassword('confirmPassword')">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="agreeTerms" name="agreeTerms"
                            @(ViewData["AgreeTerms"]?.ToString() == "on" ? "checked" : "") required>
                            <label class="form-check-label" for="agreeTerms">
                                Я соглашаюсь с <a href="#" class="text-decoration-none" style="color: #047bd6;">условиями использования</a>
                            </label>
                        </div>

                        <!-- Вывод ошибок валидации -->
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                            </div>
                        }

                        <button type="submit" class="btn btn-primary btn-lg w-100"
                                style="background: linear-gradient(90deg, #047bd6, #3ab326); border: none; font-family: 'Nunito', sans-serif; font-weight: 800;">
                            Зарегистрироваться
                        </button>
                    </form>

                    <hr class="my-4">

                    <div class="text-center">
                        <p class="text-muted">
                            Уже есть аккаунт?
                            <a asp-controller="Account" asp-action="Login" class="text-decoration-none" style="color: #3ab326; font-weight: 600;">
                                Войти
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Функция для переключения видимости пароля
    function togglePassword(inputId) {
        const passwordInput = document.getElementById(inputId);
        const toggleButton = passwordInput.nextElementSibling;
        const icon = toggleButton.querySelector('i');

        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            passwordInput.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    // Восстанавливаем состояние видимости паролей при загрузке страницы
    document.addEventListener('DOMContentLoaded', function() {
        // Если есть сохраненные пароли, убедимся, что они правильно отображаются
        const passwordInput = document.getElementById('password');
        const confirmPasswordInput = document.getElementById('confirmPassword');

        // Восстанавливаем значения из ViewData
        if (passwordInput.value) {
            // Значение уже установлено через ViewData
        }
        if (confirmPasswordInput.value) {
            // Значение уже установлено через ViewData
        }

        // Восстанавливаем состояние чекбокса
        const agreeTermsCheckbox = document.getElementById('agreeTerms');
        const agreeTermsValue = "@ViewData["AgreeTerms"]";
        if (agreeTermsValue === "on") {
            agreeTermsCheckbox.checked = true;
        }
    });
</script>