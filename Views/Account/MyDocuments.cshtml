    // Просмотр документа
        // Просмотр документа
    async function viewDocument(documentId) {
        currentDocumentId = documentId;

        try {
            const response = await fetch(`/Documents/GetDocument/${documentId}`);
            const docData = await response.json(); // ИЗМЕНЕНО: docData вместо document

            // Установить заголовок
            document.getElementById('documentViewTitle').textContent = docData.name; // ИЗМЕНЕНО

            // Установить ссылку для скачивания
            document.getElementById('downloadDocumentBtn').href = `/Documents/Download/${documentId}`;

            // Установить ID документа для кнопки удаления
            document.getElementById('deleteDocumentBtn').dataset.documentId = documentId;

            // Показать превью в зависимости от типа файла
            const preview = document.getElementById('documentPreview');
            const fileType = docData.fileType.toLowerCase(); // ИЗМЕНЕНО

            if (fileType === '.pdf' || fileType === 'pdf') { // ИСПРАВЛЕНО
                preview.innerHTML = `
                    <div class="text-center py-4">
                        <i class="fas fa-file-pdf fa-4x text-danger mb-3"></i>
                        <p>PDF файл</p>
                        <p class="text-muted small">Для просмотра PDF скачайте файл</p>
                        <div class="mt-3">
                            <p class="small"><strong>Название:</strong> ${docData.name}</p>
                            <p class="small"><strong>Размер:</strong> ${formatFileSize(docData.fileSize)}</p>
                            <p class="small"><strong>Загружен:</strong> ${new Date(docData.createdAt).toLocaleDateString()}</p>
                            ${docData.documentNumber ? `<p class="small"><strong>Номер:</strong> ${docData.documentNumber}</p>` : ''}
                        </div>
                    </div>
                `;
            } else if (['.jpg', '.jpeg', '.png', '.gif'].includes(fileType) ||
                       ['jpg', 'jpeg', 'png', 'gif'].includes(fileType)) {
                preview.innerHTML = `
                    <div class="text-center">
                        <img src="/Documents/GetFile/${documentId}"
                             alt="${docData.name}"
                             class="img-fluid rounded"
                             style="max-height: 500px;">
                    </div>
                `;
            } else {
                preview.innerHTML = `
                    <div class="text-center py-4">
                        <i class="fas fa-file-alt fa-4x text-primary mb-3"></i>
                        <p>${docData.fileType.toUpperCase()} файл</p>
                        <p class="text-muted small">${docData.description || 'Нет описания'}</p>
                        <div class="mt-3">
                            <p class="small"><strong>Название:</strong> ${docData.name}</p>
                            <p class="small"><strong>Размер:</strong> ${formatFileSize(docData.fileSize)}</p>
                            <p class="small"><strong>Загружен:</strong> ${new Date(docData.createdAt).toLocaleDateString()}</p>
                            ${docData.documentNumber ? `<p class="small"><strong>Номер:</strong> ${docData.documentNumber}</p>` : ''}
                        </div>
                    </div>
                `;
            }

            // Показать модальное окно
            const modal = new bootstrap.Modal(document.getElementById('viewDocumentModal'));
            modal.show();
        } catch (error) {
            console.error('Ошибка при загрузке документа:', error);
            alert('Не удалось загрузить информацию о документе: ' + error.message);
        }
    }

    // Удаление документа
    async function deleteDocument() {
        if (!confirm('Вы уверены, что хотите удалить этот документ? Это действие нельзя отменить.')) {
            return;
        }

        const documentId = document.getElementById('deleteDocumentBtn').dataset.documentId;

        try {
            const response = await fetch(`/Documents/DeleteDocument/${documentId}`, {
                method: 'DELETE',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            });

            const result = await response.json();

            if (result.success) {
                // Закрыть модальное окно
                const modal = bootstrap.Modal.getInstance(document.getElementById('viewDocumentModal'));
                modal.hide();

                // Обновить список документов
                loadDocuments();

                // Показать уведомление
                showNotification('Документ успешно удален', 'success');
            } else {
                alert(result.message || 'Ошибка при удалении документа');
            }
        } catch (error) {
            console.error('Ошибка при удалении документа:', error);
            alert('Произошла ошибка при удалении документа');
        }
    }

    // Вспомогательные функции
    function getFileIcon(fileType) {
        const type = fileType.toLowerCase();
        if (type === 'pdf') return 'file-pdf';
        if (type === 'doc' || type === 'docx') return 'file-word';
        if (['jpg', 'jpeg', 'png', 'gif', 'bmp'].includes(type)) return 'file-image';
        if (type === 'txt') return 'file-alt';
        if (type === 'xls' || type === 'xlsx') return 'file-excel';
        return 'file-alt';
    }

    function formatFileSize(bytes) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

        function showNotification(message, type = 'info') {
        const notification = document.createElement('div');
        notification.className = `alert alert-${type} alert-dismissible fade show position-fixed top-0 end-0 m-3`;
        notification.style.zIndex = '9999';
        notification.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        document.body.appendChild(notification);

        setTimeout(() => {
            notification.remove();
        }, 3000);
    }
</script>