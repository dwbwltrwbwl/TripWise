                <h5 class="mb-0"><i class="fas fa-clock me-2"></i>Последние бронирования</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Пользователь</th>
                            <th>Тип</th>
                            <th>Направление</th>
                            <th>Сумма</th>
                            <th>Статус</th>
                            <th>Дата</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>#12345</td>
                            <td>Иван Иванов</td>
                            <td><i class="fas fa-plane text-primary me-1"></i> Авиа</td>
                            <td>Москва → Сочи</td>
                            <td>8,500 ₽</td>
                            <td><span class="badge badge-success">Оплачено</span></td>
                            <td>15.12.2024</td>
                        </tr>
                        <tr>
                            <td>#12344</td>
                            <td>Анна Петрова</td>
                            <td><i class="fas fa-train text-success me-1"></i> ЖД</td>
                            <td>СПб → Москва</td>
