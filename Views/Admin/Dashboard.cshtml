                            <td><span class="badge badge-warning">Ожидание</span></td>
                            <td>14.12.2024</td>
                        </tr>
                        <tr>
                            <td>#12343</td>
                            <td>Петр Сидоров</td>
                            <td><i class="fas fa-hotel text-warning me-1"></i> Отель</td>
                            <td>Отель в Казани</td>
                            <td>12,000 ₽</td>
                            <td><span class="badge badge-success">Оплачено</span></td>
                            <td>13.12.2024</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>