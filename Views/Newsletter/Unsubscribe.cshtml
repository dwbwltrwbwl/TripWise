@{
    ViewData["Title"] = "Отписка от рассылки";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    @if (ViewBag.Success == true)
                    {
                        <div class="mb-4">
                            <i class="fas fa-check-circle text-success fa-4x"></i>
                        </div>
                        <h3 class="card-title mb-3">Вы отписались от рассылки</h3>
                        <p class="text-muted mb-4">
                            Email: <strong>@ViewBag.Email</strong> больше не будет получать уведомления.
                        </p>
                        <p class="small text-muted">
                            Если это произошло по ошибке, вы можете подписаться снова в футере сайта.
                        </p>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">
                            Вернуться на главную
                        </a>
                    }
                    else
                    {
                        <div class="mb-4">
                            <i class="fas fa-exclamation-triangle text-warning fa-4x"></i>
                        </div>
                        <h3 class="card-title mb-3">Ошибка</h3>
                        <p class="text-muted mb-4">
                            @(ViewBag.Message ?? "Не удалось отписать от рассылки")
                        </p>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary mt-3">
                            Вернуться на главную
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>